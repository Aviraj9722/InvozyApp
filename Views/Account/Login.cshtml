@model eOrderTouchApp.ViewModel.ForgetPasswordViewModel
@{
    ViewBag.Title = "Login";
    Layout = "_Layout";
}

<div class="login-page d-flex align-items-center justify-content-center">
    <div class="login-container">
        <div class="text-center mb-4">
            <h2 class="fw-bold text-primary">Welcome to Invozy</h2>
            <p class="text-muted">Simplify your billing with ease</p>
        </div>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-danger text-center">@ViewBag.Message</div>
        }

        <form method="post" asp-controller="Account" asp-action="Login">
            <div class="mb-3">
                <label class="form-label fw-semibold">Username</label>
                <input type="text" name="username" class="form-control shadow-sm" placeholder="Enter your username" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Password</label>
                <input type="password" name="password" class="form-control shadow-sm" placeholder="Enter your password" required />
            </div>

            <!-- FORGOT PASSWORD LINK TO OPEN MODAL -->
            <div class="text-end mb-3">
                <a href="#" class="text-primary small fw-semibold" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">
                    Forgot password?
                </a>
            </div>

            <div class="d-grid mt-3">
                <button type="submit" class="btn btn-login">Login</button>
            </div>

            <div class="login-footer text-center text-muted mt-3">
                <small>Powered by <strong>Aviraj Innovations Pvt. Ltd.</strong></small>
            </div>
        </form>
    </div>
</div>

<!-- ====================== -->
<!-- FORGOT PASSWORD MODAL -->
<!-- ====================== -->
<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-labelledby="forgotLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-3">

            <div class="modal-header">
                <h5 class="modal-title fw-bold text-primary" id="forgotLabel">Forgot Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <!-- FORM FOR FORGET PASSWORD INSIDE POPUP -->
                <form id="forgotPasswordForm" asp-controller="Account" asp-action="ForgetPassword" method="post">

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Enter your Email</label>
                        <input asp-for="Email" id="forgotEmail" class="form-control shadow-sm" placeholder="Enter Email" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div id="forgotSuccess"
                         class="alert alert-success d-none text-center"></div>
                    <button type="submit" id="forgotSubmit" class="btn btn-primary w-100">
                        Submit
                    </button>

                </form>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (!ViewData.ModelState.IsValid)
    {
        <script>
            var forgotModal = new bootstrap.Modal(
                document.getElementById('forgotPasswordModal')
            );
            forgotModal.show();
        </script>
    }

    <script>
        $("#forgotPasswordForm").submit(function (e) {
            e.preventDefault();

            $("#forgotSubmit").prop("disabled", true);
            $("#forgotSuccess").addClass("d-none").html("");

            $.ajax({
                url: '@Url.Action("ForgetPassword", "Account")',
                type: 'POST',
                data: $(this).serialize(),

                success: function (res) {
                    $("#forgotSuccess")
                        .removeClass("d-none")
                        .html(res.message);

                    $("#forgotEmail").prop("readonly", true);
                    $("#forgotSubmit").hide();
                },

                error: function (xhr) {
                    let msg = xhr.responseJSON?.message || "Something went wrong";

                    $("#forgotSubmit").prop("disabled", false);

                    $("span[data-valmsg-for='Email']")
                        .text(msg);
                }
            });
        });
    </script>

}

<style>
    .login-page {
        min-height: calc(100vh - 80px);
        background-color: #f5f9ff;
        background-image: linear-gradient(to bottom right, #f8fbff, #e9f2ff);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-container {
        background: #ffffff;
        padding: 40px 35px;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        width: 100%;
        max-width: 400px;
        transition: transform 0.2s ease-in-out;
    }

        .login-container:hover {
            transform: translateY(-3px);
        }

    .btn-login {
        background: #0078d7;
        color: #fff;
        border: none;
        padding: 10px;
        border-radius: 6px;
        font-weight: 500;
        font-size: 1rem;
    }

        .btn-login:hover {
            background-color: #005fa3;
        }

    .form-control:focus {
        border-color: #0078d7;
        box-shadow: 0 0 5px rgba(0, 120, 215, 0.4);
    }

    .text-primary {
        color: #0078d7 !important;
    }

    #forgotSuccess {
        font-size: 14px;
        font-weight: 500;
    }
</style>

