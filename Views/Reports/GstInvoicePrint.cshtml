@model eOrderTouchApp.ViewModel.GstInvoiceReportsVM
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>GST Sale Report</title>

    <style>
        @@page {
            size: A4;
            margin: 15mm;
        }

        body {
            font-family: Arial;
            font-size: 12px;
        }

        .header {
            text-align: center;
        }

        .business-name {
            font-size: 22px;
            font-weight: bold;
        }

        .business-details {
            font-size: 13px;
            font-weight: normal;
        }

        .sub-header {
            text-align: center;
            font-size: 14px;
            margin-bottom: 20px;
            font-weight: bold;
        }

        .row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .box {
            width: 48%;
            border: 1px solid black;
            padding: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        table, th, td {
            border: 1px solid black;
        }

        th {
            background-color: #f2f2f2;
        }

        th, td {
            padding: 6px;
            text-align: center;
        }

        .text-right {
            text-align: right;
        }

        .summary-table {
            width: 60%;
            margin-top: 20px;
            float: right;
        }

        .footer {
            margin-top: 80px;
            text-align: right;
        }
        @@media print {
            body {
                -webkit-print-color-adjust: exact;
            }
        }

        .no-print {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 15px;
        }

        .pdf-btn {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 8px 16px;
            font-size: 13px;
            border-radius: 4px;
            cursor: pointer;
        }

            .pdf-btn:hover {
                background-color: #0056b3;
            }

        @@media print {
            .no-print {
                display: none;
            }
        }

        .bold {
            font-weight: bold;
            background: #f5f5f5;
        }

        .bank-details {
            width: 55%;
            font-size: 13px;
        }

        .bank-box {
            border: 1px solid black;
            padding: 10px;
            width: 350px; /* nice professional size */
        }

        .signature {
            width: 250px;
            margin-right: 40px;
            text-align: right;
        }

        .bottom-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-end; /* 👈 important */
            margin-top: 60px;
        }
        .sign-space {
            height: 60px;
            border-bottom: 1px solid #000; /* 👈 signature line */
            margin-bottom: 5px;
        }

        .bank-row {
            display: flex;
            margin-bottom: 4px;
        }

        .bank-label {
            width: 140px; /* 👈 PERFECT ALIGNMENT */
            font-weight: bold;
        }

        .bank-line {
            margin-bottom: 4px;
        }

        .total-box {
            display: inline-table; /* ✅ KEY FIX */
            width: auto; /* ✅ shrink to content */
            float: right; /* ✅ move to right */
            margin-top: 8px;
            border-collapse: collapse;
        }

            .total-box td {
                padding: 6px 10px;
                border: 1px solid black;
                font-size: 13px;
                white-space: nowrap; /* ✅ VERY IMPORTANT */
            }

            .total-box .label {
                text-align: right;
                font-weight: 600;
                min-width: 140px; /* ✅ fixed label width */
            }

            .total-box .value {
                text-align: right;
                min-width: 120px; /* ✅ fixed value width */
            }

            .total-box .grand {
                font-size: 15px;
                font-weight: bold;
                background: #f2f2f2;
                border-top: 2px solid black; /* 👈 highlight line */
            }


    </style>
</head>

<body>
    <!-- ✅ DOWNLOAD BUTTON (TOP RIGHT) -->
    <div class="no-print">
        <button onclick="window.print()" class="pdf-btn">
            🖨 Download / Print Invoice
        </button>
    </div>

    <!-- Business Name -->
    <div class="header">
        <div class="business-name">
            @Model.BusinessName
        </div>

        <div class="business-details">
            @Model.BusinessAddress <br />
            GSTIN: @Model.BusinessGSTIN <br />
            MobNo: @Model.BusinessMobNo
        </div>
    </div>
    <br />
    <div class="sub-header">
        Tax Invoice
    </div>

    <!-- Order & Customer Section -->
    <div class="row">
        <div class="box">
            <span class="bold">Order Information</span><br /><br />
            <strong>Invoice No:</strong> @Model.InvoiceNo <br />
            <strong>Date:</strong> @Model.OrderDate.ToString("dd-MM-yyyy")
        </div>

        <div class="box">
            <span class="bold">Customer Information</span><br /><br />
            <strong>Name:</strong> @Model.CustomerName <br />
            <strong>Mobile No:</strong> @Model.CustomerMobNo
        </div>
    </div>

    <!-- Items Grid -->
    <table>
        <thead>
            <tr>
                <th style="width:5%;">Id</th>
                <th style="width:30%;">Item Name</th>
                <th style="width:10%;">Qty</th>
                <th style="width:10%;">UOM</th>
                <th style="width:15%;">Price</th>
                <th style="width:15%;">GST %</th>
                <th style="width:15%;">Total</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
            }

            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@i</td>
                    <td style="text-align:left;">@item.ItemName</td>
                    <td class="text-center">@item.Quantity</td>
                    <td class="text-center">@item.UOM</td>
                    <td class="text-right">₹ @item.Price.ToString("N2")</td>
                    <td>@item.GstPercent %</td>
                    <td class="text-right">₹ @item.TotalAmount.ToString("N2")</td>
                </tr>
                i++;
            }
            <!-- ✅ TOTAL ROW -->
            <tr class="bold">
                <td colspan="2" style="text-align:right;">Total</td>
                <td>@Model.Items.Sum(x => x.Quantity)</td>
                <td></td>
                <td></td>
                <td></td>
                <td class="text-right">
                    ₹ @Model.Items.Sum(x => x.TotalAmount).ToString("N2")
                </td>
            </tr>
        </tbody>
    </table>

    <!-- GST Grouping Summary -->
    <table class="summary-table">
        <thead>
            <tr>
                <th>GST %</th>
                <th>Taxable</th>
                <th>CGST</th>
                <th>SGST</th>
                <th>Total Tax</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tax in Model.GstGrouping)
            {
                <tr>
                    <td>@tax.GstPercentage %</td>
                    <td class="text-right">@tax.TaxableAmount.ToString("N2")</td>
                    <td class="text-right">@tax.CGST.ToString("N2")</td>
                    <td class="text-right">@tax.SGST.ToString("N2")</td>
                    <td class="text-right">@tax.TotalTax.ToString("N2")</td>
                </tr>
            }

            <tr class="bold">
                <td>Total</td>
                <td class="text-right">₹ @Model.TotalTaxable.ToString("N2")</td>
                <td class="text-right">@Model.TotalCGST.ToString("N2")</td>
                <td class="text-right">@Model.TotalSGST.ToString("N2")</td>
                <td class="text-right">₹ @Model.TotalGST.ToString("N2")</td>
            </tr>
        </tbody>
    </table>

    <div style="clear: both;"></div>

    <!-- ✅ FINAL TOTALS (RIGHT SIDE) -->
    <table class="total-box">
        <tr>
            <td class="label">Taxable Amount</td>
            <td class="value">₹ @Model.TotalTaxable.ToString("N2")</td>
        </tr>
        <tr>
            <td class="label">Total CGST</td>
            <td class="value">₹ @Model.TotalCGST.ToString("N2")</td>
        </tr>
        <tr>
            <td class="label">Total SGST</td>
            <td class="value">₹ @Model.TotalSGST.ToString("N2")</td>
        </tr>
        <tr>
            <td class="label">Total GST</td>
            <td class="value">₹ @Model.TotalGST.ToString("N2")</td>
        </tr>
        <tr class="grand">
            <td class="label">Grand Total</td>
            <td class="value">₹ @Model.GrandTotal.ToString("N2")</td>
        </tr>
    </table>

    <div style="clear: both;"></div>

    <hr />
    
   

    <div class="bottom-section">

        <!-- LEFT SIDE (Bank Details) -->
        <div class="bank-box">
            <b>Bank & Payment Details</b>
            <hr style="margin:4px 0;" />

            @{
                var lines = Model.ReportData?
                .Replace("\r", "")        // fix Windows newline
                .Split('\n');

                if (lines != null)
                {
                    foreach (var line in lines)
                    {
                        if (!string.IsNullOrWhiteSpace(line))
                        {
                            if (line.Contains(":"))
                            {
                                var parts = line.Split(':');
                                var key = parts[0].Trim();
                                var value = string.Join(":", parts.Skip(1)).Trim();

                                <div class="bank-row">
                                    <span class="bank-label">@key</span>
                                    <span>: @value</span>
                                </div>
                            }
                            else
                            {
                                // 👉 show normal text if no format
                                <div class="bank-line">@line</div>
                            }
                        }
                    }
                }
            }
        </div>

        <!-- RIGHT SIDE (Signature) -->
        <div class="signature">
            <div class="sign-space"></div>
            <b>Authorised Signatory</b>
        </div>

    </div>
    <script>
        window.onload = function () {
            window.print();
        };
    </script>
</body>
</html>