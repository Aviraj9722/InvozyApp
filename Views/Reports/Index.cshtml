@{
    var reports = ViewBag.Reports as List<eOrderTouchApp.Models.TblReports>;
    var units = ViewBag.Units as IEnumerable<dynamic>;
}

<style>
    /* LEFT PANEL */
    .report-list {
        background: linear-gradient(135deg, #f8f9fa, #eef2f7);
        border-radius: 10px;
        padding: 15px;
        min-height: 100%;
        box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        font-size: 16px;
    }

    .report-list h5 {
        font-size: 20px;
        font-weight: 600;
        color: #2c3e50;
    }

    .report-item {
        padding: 8px 10px;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.3s;
    }

    .report-item:hover {
        background: #dbeafe;
    }

    .report-item input {
        margin-right: 8px;
        transform: scale(1.2);
    }

    /* RIGHT PANEL */
    #reportTitle {
        font-size: 22px;
        font-weight: 600;
        color: #34495e;
    }

    label {
        font-size: 16px;
        font-weight: 500;
    }

    /* TABLE */
    table.dataTable {
        font-size: 15px;
    }

    /* BUTTONS */
    .btn {
        font-size: 16px;
        font-weight: 500;
    }
</style>


<div class="row">

    <!-- LEFT SIDE : REPORT LIST -->
    <div class="col-md-3">
        <h5>📊 Select Report</h5>
        <hr />

       @*  @foreach (var item in reports)
        {
            <div class="report-item">
                <input type="radio" name="reportType" value="@item.Name" class="report-radio" />
                <strong>@item.Name</strong>
            </div>
        } *@
        <input type="text"
               id="searchReport"
               placeholder="Search report..."
               class="form-control mb-3" />

        <div id="reportList">
            @foreach (var item in reports)
            {
                <div class="report-item">
                    <input type="radio"
                           name="reportType"
                           value="@item.Name"
                           class="report-radio" />
                    <strong>@item.Name</strong>
                </div>
            }
        </div>
        
    </div>
   
    
    <!-- RIGHT SIDE -->
    <div class="col-md-9">

        <div class="d-flex justify-content-between align-items-center">
            <h4 id="reportTitle">Report Output</h4>


            @if (User.IsInRole("HeadOfficer") && units != null)
            {
                <div style="display: flex;">
                    <span style="margin-top: 7px;margin-right: 9px;">Selected Branch/Unit:</span>
                 
                        <select id="unitDropdown" style="font-weight:800" class="form-select w-auto">

                            @foreach (var u in units)
                            {
                                <option value="@u.Id">@u.BusinessName</option>
                            }
                        </select>
                 
                </div>


            }
       
        </div>
        <hr />

        <!-- STATIC DATE FILTERS -->
        <div class="row mb-3">
            <div class="col-md-3">
                <label>From Date</label>
                <input type="date" id="fromDate" class="form-control" />
            </div>

            <div class="col-md-3">
                <label>To Date</label>
                <input type="date" id="toDate" class="form-control" />
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary w-100" id="generateBtn">
                    📄 Generate Report
                </button>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-success w-100" id="printBtn" disabled>
                    🖨 Print
                </button>
            </div>
        </div>

        <!-- ONLY GRID CHANGES -->
        <div id="dynamicReportArea">
            <p>Please select a report…</p>
        </div>
    </div>

</div>



@section Scripts {

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
            $(document).ready(function () {

            // ✅ Set today's date
            let today = new Date().toISOString().split('T')[0];
            $('#fromDate').val(today);
            $('#toDate').val(today);
            let selectedBusinessId = null;

            // ✅ Auto select "Item Sale Reports"
            let defaultReport = $('.report-radio').filter(function () {
                return $(this).val().toLowerCase().includes('item');
            }).first();

            if (defaultReport.length > 0) {
                defaultReport.prop('checked', true).trigger('change');
            }
        });
        // Change report type - loads description
        $('.report-radio').on('change', function () {
            
            let reportId = $(this).val();

            $.ajax({
                url: '/Reports/LoadReport',
                type: 'GET',
                data: { id: reportId },
                success: function (result) {
                    $('#dynamicReportArea').html(result);

                    let title = $('input[name="reportType"]:checked').parent().text().trim();
                    $('#reportTitle').text(title);
                }
            });

        });

        // ✅ Main Generate Button (FIXED)
        $('#generateBtn').click(function () {
            debugger;

            var reportId = $("input[name='reportType']:checked").val();
            var fromDate = $("#fromDate").val();
            var toDate = $("#toDate").val();
                var BID = $("#unitDropdown").val();


            if (!reportId) {
                alert("Please select a report type!");
                return;
            }

                 $.ajax({
            url: "/Reports/GenerateReport",
            type: "POST",
            data: {
                reportName: reportId,
                fromDate: fromDate,
                toDate: toDate,
                    selectedbusinessId: Number(BID)
            },
            success: function (result) {
                debugger;

                if (!result || result.length === 0) {
                    $("#dynamicReportArea").html("<p>No report found.</p>");
                    return;
                };

                let columns = Object.keys(result[0]);

                // CREATE TABLE HTML
                let table = `<table id="reportTable" class="display table table-bordered">
                                <thead class="table-dark"><tr>`;

          

                columns.forEach(col => {
                    table += `<th>${formatHeaderName(col)}</th>`;

                });

                table += `</tr></thead><tbody>`;

                result.forEach(row => {
                    table += `<tr>`;
                    columns.forEach(col => {
                            let value = row[col];

                            // ✅ Format date ONLY for Date-Wise Sale Report
                            if (
                                col.toLowerCase().includes("date") &&
                                reportId.toLowerCase().includes("date-wise")
                            ) {
                                if (value) {
                                    let d = new Date(value);
                                    value = d.toLocaleDateString("en-GB"); // dd/MM/yyyy
                                    value = value.replaceAll("/", "-");   // dd-MM-yyyy
                                }
                            }
                            table += `<td>${value ?? ""}</td>`;
                    });
                    table += `</tr>`;
                });

                        // ===== GRAND TOTAL CALCULATION =====
                    let totals = {};

                    columns.forEach(col => totals[col] = 0);

                    result.forEach(row => {
                        columns.forEach(col => {
                            if (typeof row[col] === "number") {
                                totals[col] += row[col];
                            }
                        });
                    });

                    // ===== FOOTER HTML =====
                    table += `<tr class="table-secondary fw-bold">`;

                    columns.forEach((col, index) => {
                        if (index === 0) {
                            table += `<th>Grand Total</th>`;
                        } else if (typeof totals[col] === "number" && totals[col] > 0) {
                            table += `<th>${totals[col]}</th>`;
                        } else {
                            table += `<th></th>`;
                        }
                    });

                    table += `</tr>`;

                table += "</tbody></table>";

                // RENDER TABLE
                $("#dynamicReportArea").html(table);

                // ⭐ INITIALIZE DATATABLES
                $('#reportTable').DataTable({
                    pageLength: 10,         // default rows per page
                    lengthMenu: [5, 10, 25, 50, 100],
                    order: [],              // no default sorting
                    responsive: true,
                    footer: true
                });

               
            },

            error: function (xhr) {
                console.log("SERVER ERROR:", xhr.responseText);
                alert("Failed to generate report!");
            }

        });


    });


        function formatHeaderName(col) {
            // Replace camelCase → snake_case
            col = col.replace(/([a-z])([A-Z])/g, '$1_$2');

            // Replace spaces → underscore
            col = col.replace(/\s+/g, '_');

            // Convert to Title Case
            col = col.charAt(0).toUpperCase() + col.slice(1);

            return col;
        }

                    
        $("#searchReport").on("keyup", function () {
            let value = $(this).val().toLowerCase();

            $("#reportList .report-item").filter(function () {
                $(this).toggle(
                    $(this).text().toLowerCase().indexOf(value) > -1
                );
            });
        });
   
          

    </script>

    <script>
    $('#printBtn').click(function () {

        let table = $('#reportTable').DataTable();

        if (!table) {
            alert("No data to print!");
            return;
        }

        // Get ALL rows (ignore pagination)
       // let allData = table.rows({ search: 'applied' }).nodes();
        let allData = table.rows().nodes();

        let printContent = `
            <html>
            <head>
                <title>Print Preview</title>
                <style>
                    @@page {
                        size: 80mm auto;
                        margin: 5mm;
                    }

                    body {
                        font-family: monospace;
                        font-size: 11px;
                    }

                    h3 {
                        text-align: center;
                        margin-bottom: 10px;
                    }
                    h2 {
                        text-align: center;
                        margin-bottom: 10px;
                    }

                    table {
                        width: 100%;
                        border-collapse: collapse;
                    }

                    th, td {
                        border-bottom: 1px dashed #000;
                        padding: 4px 2px;
                        text-align: left;
                        word-break: break-word;
                    }

                    th {
                        font-weight: bold;
                    }

                    .actions {
                        text-align: center;
                        margin: 15px 0;
                    }

                    button {
                        padding: 6px 12px;
                        font-size: 12px;
                        margin: 5px;
                        cursor: pointer;
                    }

                    @@media print {
                        .actions {
                            display: none;
                        }

                        body {
                            margin: 0 !important;
                            padding: 0 !important;
                            width: 80mm !important;
                            -webkit-print-color-adjust: exact !important;
                            print-color-adjust: exact !important;
                        }

                    }

                    table { width: 100%; border-collapse: collapse; }
                    td, th { padding: 3px; }
                    .qty { text-align: center; }
                    .rate, .total { text-align: right; }

                    .title { font-size: 24px; text-align:center; font-weight:bold; }
                    .addr { font-size: 18px; text-align:center; }
                </style>
            </head>
         

                <h2>${$('#reportTitle').text()}</h2>
                        <h3>${$('#fromDate').val()} To ${$('#toDate').val()}</h3>
                <table>
                    <thead>
                        ${$('#reportTable thead').html()}
                    </thead>
                    <tbody>
                        ${$(allData).clone().wrapAll('<div>').parent().html()}

                    </tbody>
                </table>
                <br>
                <h3>~~~ Thank you ~~~</h3>
                <br> <br>
                <div class="actions">
                    <button onclick="window.print()">🖨 Print</button>
                    <button onclick="window.close()">❌ Close</button>
                </div>

           
            </html>
        `;

        let printWindow = window.open('', '', 'width=400,height=600');
        printWindow.document.open();
        printWindow.document.write(printContent);
        printWindow.document.close();
    });

        $('#printBtn').prop('disabled', false);

</script>

}

