@{
    ViewData["Title"] = "Transactions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h5>Transactions 💰</h5>

<!-- ✅ CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f6f9;
    }

    /* 🔹 Top Balance */
    .top-bar {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
    }

    .balance {
        padding: 6px 12px;
        font-size: 13px;
        border-radius: 6px;
        color: white;
    }

    .cash {
        background: #28a745;
    }

    .bank {
        background: #007bff;
    }

    /* 🔹 Card */
    .card-box {
        background: #fff;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    /* 🔹 Single Row Form */
    .single-row {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .single-row input,
    .single-row select {
        padding: 5px;
        font-size: 12px;
    }

    /* 🔹 Width Control */
    .account {
        flex: 2;
    }

    .small-field {
        flex: 0.8;
    }

    #Amount {
        flex: 1;
    }

    #TransactionDate {
        flex: 1;
    }

    #Narration {
        flex: 2;
    }

    /* 🔹 Buttons */
    .btn-save {
        background: #28a745;
        color: white;
        padding: 5px 10px;
        border: none;
        border-radius: 5px;
    }

    .btn-clear {
        background: #dc3545;
        color: white;
        padding: 5px 10px;
        border: none;
        border-radius: 5px;
    }

    /* 🔹 Filter Bar */
    .filter-bar {
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .filter-bar input,
        .filter-bar select {
            padding: 5px;
            font-size: 12px;
        }

    /* 🔹 Table */
    #txnTable thead {
        background: #007bff;
        color: white;
    }
</style>

<!-- ✅ BALANCE -->
<div class="top-bar">
    <div class="balance cash">Cash: ₹ <span id="cashInHand">0</span></div>
    <div class="balance bank">Bank: ₹ <span id="cashAtBank">0</span></div>
</div>

<!-- ✅ ADD TRANSACTION -->
<div class="card-box">
    <form id="txnForm" class="single-row">

        <select id="AccountId" class="account"></select>

        <input type="number" id="Amount" placeholder="Amount" />

        <select id="PaymentMode" class="small-field">
            <option value="Cash">Cash</option>
            <option value="Bank">Bank</option>
        </select>

        <select id="TypeOfTransaction" class="small-field">
            <option value="">Type</option>
            <option value="C">Payment</option>
            <option value="D">Receipt</option>
        </select>

        <input type="date" id="TransactionDate" />

        <input type="text" id="Narration" placeholder="Narration *" required />

        <button type="submit" class="btn-save">💾</button>
        <button type="button" class="btn-clear" onclick="resetForm()">✖</button>

    </form>
</div>

<!-- ✅ FILTER -->
<div class="card-box filter-bar">

    <input type="date" id="fromDate">
    <input type="date" id="toDate">

    <input type="text" id="searchText" placeholder="Search...">

    <select id="filterType">
        <option value="">All</option>
        <option value="C">Payment</option>
        <option value="D">Receipt</option>
    </select>

    <button onclick="applyFilters()">🔍</button>
    <button onclick="downloadExcel()">⬇</button>

</div>

<!-- ✅ TABLE -->
<table id="txnTable" class="display" style="width:100%">
    <thead>
        <tr>
            <th>Account</th>
            <th>Details</th>
            <th>Date</th>
        </tr>
    </thead>
</table>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>
        let transactions = [];
        let table;
        let cashInHand = 0;
        let cashAtBank = 0;

        $(document).ready(function () {
            loadAccounts();
            loadTransactions();
        });

        function loadAccounts() {
            $.get('/Transaction/GetAccounts', function (data) {
                let html = '<option></option>';
                data.forEach(a => {
                    html += `<option value="${a.id}">${a.name}</option>`;
                });

                $('#AccountId').html(html).select2({
                    placeholder: "Select Account",
                    allowClear: true,
                    width: '100%'
                });
            });
        }

        function loadTransactions() {
            $.get('/Transaction/GetTransactions', function (data) {
                transactions = data;
                calculateBalances();

                if ($.fn.DataTable.isDataTable('#txnTable')) {
                    table.destroy();
                }

                table = $('#txnTable').DataTable({
                    data: data,
                    dom: 'Bfrtip',
                    buttons: [{ extend: 'excelHtml5' }],
                    columns: [
                        { data: 'accountName' },
                        {
                            data: null,
                            render: function (d) {
                                let type = d.typeOfTransaction === 'C' ? 'Payment' : 'Receipt';
                                return `
                                    <b>₹ ${d.amount}</b><br/>
                                    <span>${d.paymentMode}</span><br/>
                                    <span style="color:${type === 'Payment' ? 'red' : 'green'}">${type}</span>
                                `;
                            }
                        },
                        {
                            data: 'transactionDate',
                            render: d => d.split('T')[0]
                        }
                    ]
                });
            });
        }

        function calculateBalances() {
            cashInHand = 0;
            cashAtBank = 0;

            transactions.forEach(t => {
                let amt = t.amount;
                if (t.paymentMode === 'Cash') {
                    cashInHand += (t.typeOfTransaction === 'D' ? amt : -amt);
                } else {
                    cashAtBank += (t.typeOfTransaction === 'D' ? amt : -amt);
                }
            });

            $('#cashInHand').text(cashInHand);
            $('#cashAtBank').text(cashAtBank);
        }

        function applyFilters() {
            let from = $('#fromDate').val();
            let to = $('#toDate').val();
            let search = $('#searchText').val().toLowerCase();
            let type = $('#filterType').val();

            let filtered = transactions.filter(t => {
                let d = t.transactionDate.split('T')[0];

                return (!from || d >= from)
                    && (!to || d <= to)
                    && (!type || t.typeOfTransaction === type)
                    && (!search ||
                        t.accountName.toLowerCase().includes(search) ||
                        (t.narration && t.narration.toLowerCase().includes(search)));
            });

            table.clear().rows.add(filtered).draw();
        }

        function downloadExcel() {
            table.button('.buttons-excel').trigger();
        }

        $('#txnForm').submit(function (e) {
            e.preventDefault();

            let narration = $('#Narration').val().trim();
            let amount = parseFloat($('#Amount').val());

            if (!narration) {
                alert("Narration required");
                return;
            }

            let model = {
                AccountId: $('#AccountId').val(),
                Amount: amount,
                PaymentMode: $('#PaymentMode').val(),
                TypeOfTransaction: $('#TypeOfTransaction').val(),
                TransactionDate: $('#TransactionDate').val(),
                Narration: narration
            };

            $.post('/Transaction/Save', model, function (res) {
                if (res.success) {
                    loadTransactions();
                    resetForm();
                }
            });
        });

        function resetForm() {
            $('#Amount').val('');
            $('#Narration').val('');
        }
    </script>

}