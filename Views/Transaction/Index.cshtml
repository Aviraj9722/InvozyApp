@{
    ViewData["Title"] = "Transactions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h5>Transactions 💰</h5>

<!-- ✅ CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    body {
        background: #f4f6f9;
    }

    /* 🔹 Top Balance */
    .top-bar {
        display: flex;
        gap: 15px;
        margin-bottom: 15px;
    }

    .balance {
        padding: 10px 18px;
        font-size: 18px;
        border-radius: 8px;
        color: white;
        min-width: 100px; 
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }

    .balance span {
        font-size: 18px;
        font-weight: 500;
        margin-left: 3px;
    }

    .cash {
        background: #28a745;
    }

    .bank {
        background: #007bff;
    }

    /* 🔹 Card */
    .card-box {
        background: #fff;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    /* 🔹 Single Row Form */
    .single-row {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .single-row input,
    .single-row select {
        padding: 5px;
        font-size: 12px;
    }

    /* 🔹 Width Control */
    .account {
        flex: 2;
    }

    .small-field {
        flex: 0.8;
    }

    #Amount {
        flex: 1;
    }

    #TransactionDate {
        flex: 1;
    }

    #Narration {
        flex: 2;
    }

    /* 🔹 Buttons */
    .btn-save {
        background: #28a745;
        color: white;
        padding: 5px 10px;
        border: none;
        border-radius: 5px;
    }

    .btn-clear {
        background: #dc3545;
        color: white;
        padding: 5px 10px;
        border: none;
        border-radius: 5px;
    }

    /* 🔹 Filter Bar */
    .filter-bar {
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .filter-bar input,
        .filter-bar select {
            padding: 5px;
            font-size: 12px;
        }

    /* 🔹 Table */
    #txnTable thead 
    {
        background: #007bff;
        color: white;
    }

    /* 📱 MOBILE VIEW */
    @@media (max-width: 768px) 
    {
        .top-bar {
            flex-direction: row;
            justify-content: space-between;
        }

        .balance {
            flex: 1;
            text-align: center;
            font-size: 20px; /* increase this */
            font-weight: 600;
        }

        .balance span {
            font-size: 20px;
            font-weight: bold;
            display: block;
        }
    /* Form becomes grid instead of single row */
    .single-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;

    }

    /* Full width fields */
    .account,
    #Narration 
    {
        grid-column: span 2;
        box-shadow : 1px;
    }

    /* Buttons full width */
    .btn-save,
    .btn-clear {
        width: 100%;
    }

    /* Filter section */
    .filter-bar {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .filter-bar input,
    .filter-bar select {
        width: 100%;
    }

    /* Table scroll (important) */
    #txnTable {
        display: block;
        overflow-x: auto;
        white-space: nowrap;
    }

    button 
    {
        padding: 10px;
        font-size: 14px;
    }

    .select2-container 
    {
        width: 100% !important;
    }

    .card-box 
    {
        padding: 12px;
    }
 }

</style>

<!-- ✅ BALANCE -->
<div class="top-bar">
    <div class="balance cash">
        Cash: ₹ <span id="cashInHand">@ViewBag.CashInHand</span>
    </div>

    <div class="balance bank">
        Bank: ₹ <span id="cashAtBank">@ViewBag.BankBalance</span>
    </div>
</div>

<!-- ✅ ADD TRANSACTION -->
<div class="card-box">
    <form id="txnForm" class="single-row">

        <select id="AccountId" class="account"></select>

        <input type="number" id="Amount" placeholder="Amount" min="1" />

        <select id="PaymentMode" class="small-field">
            <option value="Cash">Cash</option>
            <option value="Bank">Bank</option>
        </select>

        <select id="TypeOfTransaction" class="small-field">
            
            <option value="C">Payment</option>
            <option value="D">Receipt</option>
        </select>

        <input type="date" id="TransactionDate" />

        <input type="text" id="Narration" placeholder="Narration *" required />
        
        <div style="display:flex; gap:5px;">
            <button type="submit" class="btn-save">💾</button>
            <button type="button" class="btn-clear" onclick="resetForm()">✖</button>
        </div>

    </form>
</div>

<!-- ✅ FILTER -->
<div class="card-box filter-bar">

    <input type="date" id="fromDate">
    <input type="date" id="toDate">

    <input type="text" id="searchText" placeholder="Search...">

    <select id="filterType">
        <option value="">All</option>
        <option value="C">Payment</option>
        <option value="D">Receipt</option>
    </select>

    <button onclick="applyFilters()">🔍</button>
    <button onclick="downloadExcel()">⬇</button>

</div>

<!-- ✅ TABLE -->
<table id="txnTable" class="display" style="width:100%">
    <thead>
        <tr>
            <th>Account</th>
            <th>Details</th>
            <th>Date</th>
        </tr>
    </thead>
</table>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>
        let transactions = [];
        let table;
        let cashInHand = 0;
        let cashAtBank = 0;
        
        $(document).ready(function () {
            loadAccounts();
            loadTransactions();

            $('#Amount').on('keypress', function (e) 
            {
                if (e.which === 45) { // '-' character
                    return false;
                }
            });

        });

        function loadAccounts() {
            $.get('/Transaction/GetAccounts', function (data) {
                let html = '<option></option>';
                data.forEach(a => {
                    html += `<option value="${a.id}">${a.name}</option>`;
                });

                $('#AccountId').html(html).select2({
                    placeholder: "Select Account",
                    allowClear: true,
                    width: '100%'
                });
            });
        }

        function loadTransactions() {
            $.get('/Transaction/GetTransactions', function (data) {
                transactions = data;
               
                if ($.fn.DataTable.isDataTable('#txnTable')) {
                    table.destroy();
                }

                table = $('#txnTable').DataTable({
                    data: data,
                    dom: 'Bfrtip',
                    buttons: [{ extend: 'excelHtml5' }],
                    columns: [
                        { data: 'accountName' },
                        {
                            data: null,
                            render: function (d) {
                                let type = d.typeOfTransaction === 'C' ? 'Payment' : 'Receipt';
                                return `
                                    <b>₹ ${d.amount}</b><br/>
                                    <span>${d.paymentMode}</span><br/>
                                    <span style="color:${type === 'Payment' ? 'red' : 'green'}">${type}</span>
                                `;
                            }
                        },
                        {
                            data: 'transactionDate',
                            render: d => d.split('T')[0]
                        }
                    ]
                });
            });
        }

        
        function applyFilters() {
            let from = $('#fromDate').val();
            let to = $('#toDate').val();
            let search = $('#searchText').val().toLowerCase();
            let type = $('#filterType').val();

            let filtered = transactions.filter(t => {
            let d = t.transactionDate.split('T')[0];

                return (!from || d >= from)
                    && (!to || d <= to)
                    && (!type || t.typeOfTransaction === type)
                    && (!search ||
                        t.accountName.toLowerCase().includes(search) ||
                        (t.narration && t.narration.toLowerCase().includes(search)));
            });

            table.clear().rows.add(filtered).draw();
        }

        function downloadExcel() {
            table.button('.buttons-excel').trigger();
        }

        $('#txnForm').submit(function (e) {
            e.preventDefault();

            let narration = $('#Narration').val().trim();
            let amount = parseFloat($('#Amount').val());
            let accountId = $('#AccountId').val();
            
            if (!accountId) {
                alert("Please select account");
                return;
            }

            if (!amount || amount <= 0) 
            {
                alert("Amount must be greater than 0");
                return;
            }
            if (!narration) {
                alert("Narration required");
                return;
            }

            let confirmSave = confirm("Are you sure you want to proceed with this transaction?");

            if (!confirmSave) {
                return; // ❌ user clicked Cancel
            }

            let model = {
                AccountId: $('#AccountId').val(),
                Amount: amount,
                PaymentMode: $('#PaymentMode').val(),
                TypeOfTransaction: $('#TypeOfTransaction').val(),
                TransactionDate: $('#TransactionDate').val(),
                Narration: narration
            };

            $.post('/Transaction/Save', model, function (res) {
                if (!res.success) {
                    alert(res.message);   
                    return;
                }
                    location.reload();
                    
            });
        });

        function resetForm() {
            $('#Amount').val('');
            $('#Narration').val('');
        }
    </script>

}