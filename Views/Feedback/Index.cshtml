@{
    ViewData["Title"] = "Feedback";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5 text-center">
    <button class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#feedbackModal">
        Give Feedback
    </button>
</div>

<!-- FEEDBACK MODAL -->
<div class="modal fade" id="feedbackModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Submit Your Feedback</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="feedbackForm">

                    <input type="hidden" id="BuisnessId" name="BuisnessId" value="1" />

                    <div class="mb-2">
                        <label class="form-label">Customer Name</label>
                        <input type="text" name="CustomerName" id="CustomerName" class="form-control" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Mobile No</label>
                        <input type="text" name="MobileNo" id="MobileNo" class="form-control" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Feedback</label>
                        <textarea name="Feedback" id="Feedback" class="form-control"></textarea>
                    </div>

                    <!-- RATING -->
                    <div class="mb-3">
                        <label class="form-label">Rating</label>
                        <select name="Ratings" id="Ratings" class="form-select">
                            <option value="">-- Select Rating --</option>
                            <option value="1">⭐</option>
                            <option value="2">⭐⭐</option>
                            <option value="3">⭐⭐⭐</option>
                            <option value="4">⭐⭐⭐⭐</option>
                            <option value="5">⭐⭐⭐⭐⭐</option>
                        </select>
                    </div>

                </form>
            </div>

            <div class="modal-footer">
                <button class="btn btn-success w-100" id="btnSubmitFeedback">Submit</button>
            </div>

        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>

    $("#btnSubmitFeedback").click(function () {

        var formData = new FormData(document.getElementById("feedbackForm"));

        $.ajax({
            url: "/Feedback/SubmitFeedback",
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            success: function (res) {
                alert(res.message);
                $("#feedbackForm")[0].reset();
                $("#feedbackModal").modal("hide");
            },
            error: function (xhr) {
                alert("Error submitting feedback.");
                console.log(xhr.responseText);
            }
        });
    });

</script>
