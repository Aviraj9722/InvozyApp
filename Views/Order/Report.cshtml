@model IEnumerable<eOrderTouchApp.Models.TblOrderMaster>

@{
    ViewData["Title"] = "Order Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var selectedBusinessId = ViewBag.SelectedBusinessId?.ToString();
}
@{
    bool showGstButton = false;

    if (ViewBag.GstApplicable != null)
    {
        showGstButton = Convert.ToBoolean(ViewBag.GstApplicable);
    }
}

<!-- DATATABLE CSS -->
<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    /* Keep DataTables UI consistent across pages */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        display: flex !important;
        align-items: center !important;
        margin-bottom: 10px !important;
    }

        .dataTables_wrapper .dataTables_filter input {
            margin-left: 6px !important;
        }

    .dataTables_wrapper .dataTables_paginate {
        margin-top: 12px !important;
    }

    /* Make long Ordered Items display nicely */
    .order-items {
        white-space: normal !important;
        line-height: 1.3;
        font-size: 14px;
    }
</style>

<h1>Order Report</h1>

@if (User.IsInRole("HeadOfficer"))
{
    <div class="d-flex justify-content-end mb-3">
        <select id="orderBusinessDropdown" class="form-select w-auto fw-bold">
            @foreach (var u in ViewBag.Units)
            {
                <option value="@u.Id"
                        selected="@(u.Id.ToString() == selectedBusinessId)">
                    @u.BusinessName - @u.Address
                </option>
            }
        </select>
    </div>
}

<form asp-action="Report2" class="d-flex align-items-center gap-2 mb-3">
    <input type="hidden"
           id="selectedbusinessId"
           name="selectedbusinessId"
           value="@ViewBag.SelectedBusinessId" />
    <label class="me-2 mb-0">From Date:</label>
    <input type="date" id="fromDT" name="fromDT"
           value="@ViewBag.FromDate"
           class="form-control" style="max-width: 250px;" />

    <label class="ms-3 me-2 mb-0">To Date:</label>
    <input type="date" id="toDT" name="toDT"
           value="@ViewBag.ToDate"
           class="form-control" style="max-width: 250px;" />


    <button type="submit" id="btnGen" class="btn btn-success ms-3">Generate</button> 
    
    <button type="button" id="btnExportExcel" class="btn btn-primary">
        Export Excel
    </button>

</form>

<!-- TOTAL SUMMARY -->
<div class="alert alert-info d-flex gap-4 col-12">
    <div><strong>Total Cash:</strong> ₹@ViewBag.TotalCash</div>
    <div><strong>Total Online:</strong> ₹@ViewBag.Online</div>
    <div><strong>Total Free:</strong> ₹@ViewBag.Free</div>
    <div><strong>Total Credit:</strong> ₹@ViewBag.Credit</div>
    <div><strong>Total Discount:</strong> ₹@ViewBag.TotalDiscount</div>
    <div class="text-danger"><h1>Grand Total: ₹@ViewBag.GrandTotal</h1></div>
</div>

<!-- TABLE -->
<table id="orderTable" class="table table-striped table-bordered w-100">
    <thead class="table-dark">
        <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Ordered Items</th>
            <th>Grand Total</th>
            <th>Order Date</th>
            <th>Table</th>
            <th>User</th>
            <th>Payment Mode</th>
            <th>Discount(Rs)</th>
            <th>Canceled?</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>

                <td>@item.CustomerName</td>

                <td class="order-items">
                    @{
                        var details = item.TblOrderDetails.ToList();
                        string data = "";
                        foreach (var prod in details)
                        {
                            var material = ((List<TblProduct>)ViewBag.Materials)
                            .Where(w => w.Id == prod.ProductId)
                            .FirstOrDefault();

                            data += $"{material?.Name} <b>₹</b>{prod.Price} <b>Qty:</b> {prod.Qty} <b>₹</b>{prod.Total}<br>";
                        }
                    }
                    @Html.Raw(data)
                </td>

                <td>@item.GrandTotal</td>
                <td>@item.DateOfOrder</td>
                <td>@item.TableDetails</td>
                <td>@item.User?.UserName</td>
                <td>@item.PaymentMode</td>
                @{
                    decimal finalDiscount = Math.Round(
                    (item.TotalAmount ?? 0m) -
                    Convert.ToDecimal(item.DiscountedPrice ?? 0),
                    2
                    );
                }
                <td>@finalDiscount</td>
                @if (item.IsCanceled == true)
                {
                    <td>@item.CancelNote</td>
                               
                }else
                {
                    <td></td>
                }

                <td>
                    <div class="d-grid gap-2">

                        @if (showGstButton)
                        {
                            <a asp-controller="Reports"
                               asp-action="GstSaleReportPrint"
                               asp-route-orderId="@item.Id"
                               target="_blank"
                               class="btn btn-success">
                                GST Print
                            </a>
                        }

                        @if (item.IsCanceled != true)
                        {
                            <button type="button"
                                    onclick="CancelOrder(@item.Id)"
                                    class="btn btn-danger">
                                Cancel
                            </button>
                        }
                    </div>
                </td>

            </tr>
        }
    </tbody>
</table>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">


@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>
        $(document).ready(function () {

            var table = $('#orderTable').DataTable({
                dom: 'Bfrtip',
                order: [[0, 'desc']],
                buttons: [{
                    extend: 'excelHtml5',
                    title: 'Order_Report'
                }]
            });

            $("#btnExportExcel").on("click", function () {
                table.button('.buttons-excel').trigger();
            });



       
        });

        function CancelOrder(orderId)
        {
     
            let note = prompt("Enter cancellation reason:");

            if (!note) {
                alert("Cancellation note is required.");
                return;
            }

            $.ajax({
                url: '@Url.Action("CancelOrder","Order")',
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify({ orderId: orderId, note: note }),
                success: function (res) {
                    if (res.success) {
                        alert("Order cancelled");
                     $("#btnGen").trigger();
                    } else {
                        alert(res.message);
                    }
                }
            });
       
        }

         $('#orderBusinessDropdown').on('change', function () {
            let selectedBusinessId = $(this).val();

            $('#selectedbusinessId').val(selectedBusinessId);

            window.location.href =
                `/Order/Report?selectedbusinessId=${selectedBusinessId}`;
        });
    </script>
}

