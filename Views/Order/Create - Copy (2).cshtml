    function printPlainReceipt80mm(orgTitle, address, invoiceNo, date, customerName, productList, grandTotal = 0,Contact,Mode,TableNo) {
                      const ESC = "\x1B";
    const DOUBLE = ESC + "!" + "\x38";   // Double-size
    const NORMAL = ESC + "!" + "\x00";   // Normal size
    const SMALL = ESC + "M" + "\x01";    // Small font
    const NORMAL_FONT = ESC + "M" + "\x00";
                    let receipt = "";
                    receipt += "----------------------------------------\n";
                    receipt += DOUBLE + orgTitle + NORMAL + "\n";
                    receipt += address + "\n";
                    receipt += "Contact : " + Contact + "\n";
                    receipt += "----------------------------------------\n";
                    receipt += "Invoice#: " + invoiceNo + "   "+TableNo+"\n";
                    receipt += "Customer: " + customerName + "\n";
                    receipt += "Date    : " + date + "  "+Mode+"\n";
                    receipt += "----------------------------------------\n";
                    receipt += "Item                Qty   Rate    Total\n";
                    receipt += "----------------------------------------\n";

                    productList.forEach(p => {
                        const product = allProducts.find(w => w.Id === p.productId);
                        const name = (product?.Name || "").padEnd(18, " ").substring(0, 18);
                        const qty = String(p.qty).padStart(4, " ");
                        const price = p.price.toFixed(2).padStart(8, " ");
                        const total = (p.qty * p.price).toFixed(2).padStart(9, " ");
                        receipt += `${name}${qty}${price}${total}\n`;
                        grandTotal += p.qty * p.price;
                    });

                    receipt += "----------------------------------------\n";
                    receipt += `Grand Total: ${DOUBLE}${grandTotal.toFixed(2).padStart(12, " ")}${NORMAL}\n`;
                    receipt += "----------------------------------------\n";
                    receipt += "Thank you visit again!\n\n\n";
                    receipt += SMALL+"Powered by: Aviraj Innovations Pvt. Ltd.\n";
                    receipt += "Contact Us: +91 9096152118, +91 8999626684\n";
                    const encoded = btoa(unescape(encodeURIComponent(receipt)));
                    window.location.href = "rawbt:base64," + encoded;

                    window.onfocus = function () {
                        location.reload();
                    };
                }

       function printPlainReceipt58mm(orgTitle, address, invoiceNo, date, customerName, productList, grandTotal = 0, Contact, Mode, TableNo) {

    const ESC = "\x1B";
    const DOUBLE = ESC + "!" + "\x38";   // Double-size
    const NORMAL = ESC + "!" + "\x00";   // Normal size
    const SMALL = ESC + "M" + "\x01";    // Small font
    const NORMAL_FONT = ESC + "M" + "\x00";

    // Center for 32 chars (normal font)
    function center32(text) {
        const total = 32;
        let pad = Math.floor((total - text.length) / 2);
        return " ".repeat(pad) + text;
    }

  function center16(text) {
    text = text.substring(0, 16);   // prevent overflow
    const total = 16;
    let pad = Math.max(0, Math.floor((total - text.length) / 2));
    return " ".repeat(pad) + text;
}

    let receipt = "";

    // Header
    receipt += "--------------------------------\n";

    // Center title in double-width (16 columns)
    receipt += DOUBLE + center16(orgTitle) + NORMAL + "\n";

    receipt += center32(address) + "\n";
    receipt += "Contact : " + Contact + "\n";
    receipt += "--------------------------------\n";

    // Invoice details
    receipt += `Invoice#: ${invoiceNo}\n`;
    if (TableNo) receipt += `Table No: ${TableNo}\n`;
    receipt += `Customer : ${customerName}\n`;
    receipt += `Date     : ${date}\n`;
    receipt += `Mode     : ${Mode}\n`;
    receipt += "--------------------------------\n";

    // Table header (must fit 32 chars)
    receipt += "Item            Qty  Rate  Total\n";
    receipt += "--------------------------------\n";

    // Item rows
    productList.forEach(p => {
        const product = allProducts.find(w => w.Id === p.productId);

        const name = (product?.Name || "").padEnd(14, " ").substring(0, 14); // 14 chars
        const qty = String(p.qty).padStart(3, " ");                           // 3 chars
        const rate = String(p.price).padStart(5, " ");                        // 5 chars
        const total = String(p.qty * p.price).padStart(7, " ");               // 7 chars

        // Final row = 14 + space + 3 + space + 5 + space + 7 = 32 chars
        receipt += `${name} ${qty} ${rate} ${total}\n`;

        grandTotal += p.qty * p.price;
    });

    receipt += "--------------------------------\n";

    // Grand total centered in DOUBLE (16 chars width)
    const grandText = "Total: " + grandTotal;
    receipt += DOUBLE + center16(grandText)+"/-" + NORMAL + "\n";

    receipt += "--------------------------------\n";

    // Small text for footer
    receipt +=  center32("Thank you, visit again!") + "\n\n";
    receipt +=SMALL + center32("Aviraj Innovations Pvt. Ltd.") + "\n";
    receipt += center32("+91 9096152118 / 8999626684") + "\n";
    receipt += NORMAL_FONT + "\n";

    // Encode & print
    const encoded = btoa(unescape(encodeURIComponent(receipt)));
    window.location.href = "rawbt:base64," + encoded;

    window.onfocus = function () {
        location.reload();
    };
}






