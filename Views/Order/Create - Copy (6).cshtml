    var categories = ViewBag.Categories as List<eOrderTouchApp.Models.TblCategory>;
    var productsJson = ViewBag.ProductsJson as string;
}
@{

    ViewBag.HideNav = true;

    var Org = (eOrderTouchApp.Models.TblBusiness)ViewBag.Orgnization;
