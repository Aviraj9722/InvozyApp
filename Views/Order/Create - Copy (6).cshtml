        // Checkout handlers (desktop & mobile share same AJAX call)
        function doCheckout(customerName, tableDetail, paymentMode,IsPaymentDone,IsPrinted) {
            if (cart.length === 0) {
                alert("Cart is empty. Please add some items for sale.");
                return;
            }
            $('#checkoutBtn, #checkoutBtnDesktop').prop('disabled', true);

            const order = {
                editOrderId: $('#isEditing').val() === '1' ? parseInt($('#editingOrderIdHidden').val() || '0') : null,
                customerName: customerName,
                tableDetail: tableDetail,
                paymentMode: paymentMode,
                isPaymentDone: IsPaymentDone,
                isPrinted:IsPrinted,
                items: cart.map(item => ({
                    productId: item.id,
                    qty: item.qty,
                    price: item.price
                }))
            };

            $.ajax({
                url: '/Order/SaveOrder',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(order),
                success: function (res) {
                    if (res.success) {
                        // printing logic remains same
                        setTimeout(() => {
                            const isDesktop = window.innerWidth > 991;
                            const tableNo = isDesktop ? $("#ddlTableDesktop").val() : $("#ddlTableMobile").val();
                            const paymentMode = isDesktop
                                ? document.querySelector('input[name="paymentDesktop"]:checked').value
                                : document.querySelector('input[name="paymentMobile"]:checked').value;
                           
                               let card = $('.product-card');
                                    card.removeClass("product-added");


                            if(IsPrinted==true){

                                try 
                                {
                                   
                                     //debugger;
                                    if ('@Org.PrinterSizeId' == '2') {
                                        printPlainReceipt80mm('@Org.BusinessName', '@Org.Address', res.orderId, new Date().toLocaleString(), order.customerName, order.items, 0, '@Org.MobileNo', paymentMode, tableNo);

                                    } else {
                                        printPlainReceipt58mm('@Org.BusinessName', '@Org.Address', res.orderId, new Date().toLocaleString(), order.customerName, order.items, 0, '@Org.MobileNo', paymentMode, tableNo);

                                    }
                                }catch(er){
                                    console.log('printing issue');
                                }
                               
                            }
                                  

                            $('#invoiceSection').hide();
                            // after print clear cart
                            clearCartUI();
                            $('#checkoutBtn, #checkoutBtnDesktop').prop('disabled', false);
                            // close modal if on mobile
                            $('#cartModal').modal('hide');

                        }, 50);
                    } else {
                        alert("Error: " + res.message);
                        $('#checkoutBtn, #checkoutBtnDesktop').prop('disabled', false);
                    }
                },
                error: function (err) {
                    alert("Save order failed.");
                    $('#checkoutBtn, #checkoutBtnDesktop').prop('disabled', false);
                }
            });
        }

