<style>
    .desktop-qty-down {
        background: #832a2a;
        font-weight: 900;
        color: white;
    }

    .desktop-qty-up {
        background: #09830c;
        font-weight: 900;
        color: white;
    }
    footer{
        display:none;
    }
    #desktopCartItems {
        margin-top: 8px;
        overflow-y: auto;
        height: 400px;
        BACKGROUND: #3A4A3D;
        PADDING: 5px;
        border-radius: 8px;
    }

    #desktopCart {
        BACKGROUND: #2E3B32;
        color: white;
    }
    .product-name {
    font-size: 18px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    }
    .price-tag {
