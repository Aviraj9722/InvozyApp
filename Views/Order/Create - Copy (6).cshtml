        function printPlainReceipt80mm(orgTitle, address, invoiceNo, date, customerName, productList, grandTotal = 0,Contact,Mode,TableNo)
        {
        const ESC = "\x1B";
        const DOUBLE = ESC + "!" + "\x38";        // Big font
        const MEDIUM = ESC + "!" + "\x20";        // Medium (double height)
        const NORMAL = ESC + "!" + "\x00";        // Normal
        const SMALL = ESC + "M" + "\x01";         // Small font
        const NORMAL_FONT = ESC + "M" + "\x00";

        // Split long text into lines
        function wrapText(text, max) {
            let lines = [];
            while (text.length > 0) {
                lines.push(text.substring(0, max));
                text = text.substring(max);
            }
            return lines;
        }

        // 80mm normal width = 48 chars
        function center48(text) {
            const total = 48;
            let pad = Math.max(0, Math.floor((total - text.length) / 2));
            return " ".repeat(pad) + text;
        }

        // 80mm double-width = 24 chars
        function center24(text) {
            text = text.substring(0, 24);
            const total = 24;
            let pad = Math.max(0, Math.floor((total - text.length) / 2));
            return " ".repeat(pad) + text;
        }

        // Clean date (remove seconds)
        let cleanDate = date.split(":");
        if (cleanDate.length >= 2) {
            cleanDate = cleanDate[0] + ":" + cleanDate[1];
        } else {
            cleanDate = date;
        }

        let receipt = "";
        receipt += "------------------------------------------------\n";

        // ---- Title (Medium Font + Auto Wrap) ----
        let titleLines = wrapText(orgTitle, 24).slice(0, 2);

        titleLines.forEach(line => {
            receipt += MEDIUM + center24(line) + NORMAL + "\n";
        });

        // ---- Address (Auto Wrap in 48 chars) ----
        let addressLines = wrapText(address, 48).slice(0, 2);
        addressLines.forEach(line => {
            receipt += center48(line) + "\n";
        });

        receipt +=  center24(Contact) + "\n";
        receipt += "------------------------------------------------\n";

        // Invoice details
        receipt += `Invoice#: ${invoiceNo}\n`;
        if (TableNo) receipt += `Table No: ${TableNo}\n`;
        receipt += `Customer : ${customerName}\n`;
        receipt += `Date     : ${cleanDate}\n`;
        receipt += `Mode     : ${Mode}\n`;
        receipt += "------------------------------------------------\n";

        // 80mm Table Header (48 chars)
        receipt += "Item                     Qty    Rate     Total\n";
        receipt += "------------------------------------------------\n";

        // Items
        productList.forEach(p => {
            const product = allProducts.find(w => w.Id === p.productId);

            const name = (product?.Name || "").padEnd(21, " ").substring(0, 21); // 21 chars
            const qty = String(p.qty).padStart(5, " ");                          // 5 chars
            const rate = String(p.price).padStart(8, " ");                       // 8 chars
            const total = String(p.qty * p.price).padStart(10, " ");             // 10 chars

            // Total length = 21 + 1 + 5 + 1 + 8 + 1 + 10 = 47–48 chars
            receipt += `${name} ${qty} ${rate} ${total}\n`;

            grandTotal += p.qty * p.price;
        });

        receipt += "------------------------------------------------\n";

        // Grand Total (Medium font, centered)
        const grandText = "Total: " + grandTotal + "/-";
        receipt += MEDIUM + center24(grandText) + NORMAL + "\n";

        receipt += "------------------------------------------------\n";

        // Footer small text
        receipt += center48("Thank you, visit again!") + "\n\n";
        receipt += SMALL + center48("Aviraj Innovations Pvt. Ltd.") + "\n";
        receipt += center48("Inquiry On: +91 9096152118") + "\n";
        receipt += NORMAL_FONT + "\n";

        // Print using RAWBT
        const encoded = btoa(unescape(encodeURIComponent(receipt)));
        window.location.href = "rawbt:base64," + encoded;

        // window.onfocus = function () {
        //     location.reload();
        // };
          
        }


        function printPlainReceipt58mm(orgTitle, address, invoiceNo, date, customerName, productList, grandTotal = 0, Contact, Mode, TableNo) {

                const ESC = "\x1B";
                const DOUBLE = ESC + "!" + "\x38";        // Big font
                const MEDIUM = ESC + "!" + "\x20";        // Medium (double height)
                const NORMAL = ESC + "!" + "\x00";        // Normal
                const SMALL = ESC + "M" + "\x01";         // Small font
                const NORMAL_FONT = ESC + "M" + "\x00";

                // Split long text into lines of fixed width
                function wrapText(text, max) {
                    let lines = [];
                    while (text.length > 0) {
                        lines.push(text.substring(0, max));
                        text = text.substring(max);
                    }
                    return lines;
                }

                // Center 32-wide lines
                function center32(text) {
                    const total = 32;
                    let pad = Math.max(0, Math.floor((total - text.length) / 2));
                    return " ".repeat(pad) + text;
                }

                // Center 16-wide lines (medium / double-width)
                function center16(text) {
                    text = text.substring(0, 16);
                    const total = 16;
                    let pad = Math.max(0, Math.floor((total - text.length) / 2));
                    return " ".repeat(pad) + text;
                }

                // Format date (remove seconds)
                let cleanDate = date.split(":");
                if (cleanDate.length >= 2) {
                    cleanDate = cleanDate[0] + ":" + cleanDate[1]; // keep HH:mm only
                } else {
                    cleanDate = date;
                }

                let receipt = "";
                receipt += "--------------------------------\n";

                // ---- Title (Medium Font + Auto wrap) ----
                let titleLines = wrapText(orgTitle, 16).slice(0, 2); // max 2 lines

                titleLines.forEach(line => {
                    receipt += MEDIUM + center16(line) + NORMAL + "\n";
                });

                // ---- Address (Auto Wrap in 32) ----
                let addressLines = wrapText(address, 32).slice(0, 2);
                addressLines.forEach(line => {
                    receipt += center32(line) + "\n";
                });

                receipt += "Contact : " + Contact + "\n";
                receipt += "--------------------------------\n";

                // Invoice details
                receipt += `Invoice#: ${invoiceNo}\n`;
                if (TableNo) receipt += `Table No: ${TableNo}\n`;
                receipt += `Customer : ${customerName}\n`;
                receipt += `Date     : ${cleanDate}\n`;
                receipt += `Mode     : ${Mode}\n`;
                receipt += "--------------------------------\n";

                // Table header
                receipt += "Item            Qty  Rate  Total\n";
                receipt += "--------------------------------\n";

                // Items
                productList.forEach(p => {
                    const product = allProducts.find(w => w.Id === p.productId);

                    const name = (product?.Name || "").padEnd(14, " ").substring(0, 14);
                    const qty = String(p.qty).padStart(3, " ");
                    const rate = String(p.price).padStart(5, " ");
                    const total = String(p.qty * p.price).padStart(7, " ");

                    receipt += `${name} ${qty} ${rate} ${total}\n`;

                    grandTotal += p.qty * p.price;
                });

                receipt += "--------------------------------\n";

                // Grand total – Medium font centered
                const grandText = "Total: " + grandTotal + "/-";
                receipt += MEDIUM + center16(grandText) + NORMAL + "\n";

                receipt += "--------------------------------\n";

                // Footer small text
                receipt += center32("Thank you, visit again!") + "\n\n";
                receipt += SMALL + center32("Aviraj Innovations Pvt. Ltd.") + "\n";
                receipt += center32("Inquiry On: +91 9096152118") + "\n";
                receipt += NORMAL_FONT + "\n";

                // Print
                const encoded = btoa(unescape(encodeURIComponent(receipt)));
                window.location.href = "rawbt:base64," + encoded;

                // window.onfocus = function () {
                //     location.reload();
                // };
            }


