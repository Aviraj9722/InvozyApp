                                                        <thead>
                                                          <tr>
                                                            <th style='background: #606a61 !important;'>Item</th>
                                                            <th style='background:#606a61 !important;'>Qty</th>
                                                          </tr>
                                                        </thead>
                                                        <tbody>
                                                    `;

                                            res.kotItems.forEach(k => {
                                                const product = allProducts.find(p => p.Id === k.productId);  // your existing products list
                                                html += `
                                                    <tr>
                                                        <td style='background: #606a61 !important;'>${product?.Name || ''}</td>
                                                        <td style='background: #606a61 !important;'>${k.qty}</td>
                                                    </tr>
                                                `;
                                                            TableName = tableDetail;
                                                     // ✅ Store in KOT array
                                                    kotArray.push({
                                                        productId: k.productId,
                                                        name: product?.Name,
                                                        qty: k.qty
                                                    });
                                            });

                                            html += `</tbody></table>`;

                                            $("#kotModalBody").html(html);

                                            if('@Org.IsKOTEnabled'.toLowerCase()=='true' && IsPrinted==false)
                                            {
                                                $("#kotModal").modal("show");
                                            }

                                            // Store order ID for printing
                                            $("#btnPrintKOT").data("orderid", res.orderId);
                                        }

                            } catch (er) {
                                console.log("KOT print failed.");
                            }
                        }

                        //-------------------------------------------------------
                        //  EXISTING BILL PRINT LOGIC — NO CHANGE
                        //-------------------------------------------------------
                                setTimeout(async () => {
                            const isDesktop = window.innerWidth > 991;
                           
                            const tableNo = isDesktop ? $("#ddlTableDesktop").val() : $("#ddlTableMobile").val();

                            const paymentMode = isDesktop
                                ? document.querySelector('input[name="paymentDesktop"]:checked').value
                                : document.querySelector('input[name="paymentMobile"]:checked').value;

                                   

                            let card = $('.product-card');
                            card.removeClass("product-added");

                            if (IsPrinted == true) {
                                try {
                                    debugger;
                                           var GSTSummary = await GetGSTSummary(res.orderId);
                                     

                                    if ('@Org.PrinterSizeId' == '2') {
                                        debugger;
                                                    if('@Org.IsMultilengual'.toLowerCase()=='true')
                                                                {
                                                        // ✅ if KOT disabled → normal print (NO CHANGE)
                                                        if('@Org.IsKOTEnabled'.toLowerCase()!='true')
                                                        {
                                                            printReceipt80mm_Regional(
                                                                '@Org.BusinessName',
                                                                '@Org.Address',
                                                                res.orderId,
                                                                new Date().toLocaleString(),
                                                                order.customerName,
                                                                order.items,
                                                                res.grandtotal,
                                                                '@Org.MobileNo',
                                                                paymentMode,
                                                                tableNo,
                                                                discountPercent,
                                                                discountedTotal,
                                                                res.totalAmount,
                                                                GSTSummary
                                                            );
                                                        }
                                                        else
                                                        {
                                                            // ✅ counter wise print
                                                            const grouped = groupByCounter(order.items);
                                                            const counters = Object.keys(grouped);

                                                            counters.forEach((counterName, index) => {

                                                                const counterProducts = grouped[counterName];

                                                                const counterTotal = counterProducts.reduce((sum, p) => {
                                                                    return sum + (p.qty * p.price);
                                                                }, 0);

                                                                // ✅ only last counter show GST + final total
                                                                const isLast = index === counters.length - 1;

                                                                printReceipt80mm_Regional(
                                                                    '@Org.BusinessName',
                                                                    '@Org.Address',
                                                                    res.orderId,
                                                                    new Date().toLocaleString(),
                                                                    order.customerName,
                                                                    counterProducts,
                                                                    isLast ? res.grandtotal : counterTotal,   // grand total only last
                                                                    '@Org.MobileNo',
                                                                    paymentMode,
                                                                    tableNo,
                                                                    isLast ? discountPercent : 0,
                                                                    isLast ? discountedTotal : 0,
                                                                    isLast ? res.totalAmount : counterTotal,
                                                                    isLast ? GSTSummary : []
                                                                );

                                                            });
                                                        }
                                                    }
                                                    else
                                                    {
                                                        printPlainReceipt80mm(
                                                               '@Org.BusinessName',
                                                                '@Org.Address',
                                                                res.orderId,
                                                                new Date().toLocaleString(),
                                                                order.customerName,
                                                                order.items,
                                                                res.grandtotal,
                                                                '@Org.MobileNo',
                                                                paymentMode,
                                                                        tableNo,discountPercent,discountedTotal, res.totalAmount, GSTSummary
                                                        );
                                                    }
                                                    } 
                                                    else 
                                                    {
                                                    if('@Org.IsMultilengual'.toLowerCase()=='true')
                                                        {
                                                        printPlainReceipt58mm_Regional(
                                                            '@Org.BusinessName',
                                                            '@Org.Address',
                                                            res.orderId,
                                                            new Date().toLocaleString(),
                                                            order.customerName,
                                                            order.items,
                                                                    res.grandtotal,
                                                            '@Org.MobileNo',
                                                            paymentMode,
                                                            tableNo,discountPercent,discountedTotal, GSTSummary
                                                        );
                                                    }
                                                    else
                                                    {

                                                    printPlainReceipt58mm(
                                                        '@Org.BusinessName',
                                                        '@Org.Address',
                                                        res.orderId,
                                                        new Date().toLocaleString(),
                                                        order.customerName,
                                                        order.items,
                                                                res.grandtotal,
                                                        '@Org.MobileNo',
                                                        paymentMode,
                                                        tableNo,discountPercent,discountedTotal, GSTSummary
                                                    );
                                                    }
                                    }
                               

                                } catch (er) {
                                            console.log(er);
                                }
                            }

                                    try{
                                        $("#txtCustNameMobile").val("");
                                        $('#discountPercentMobile option:first').prop('selected', true);
                                        $('#ddlTableMobile option:first').prop('selected', true);
                                    }catch(er){}
                                    try{
                                         $("#txtCustNameDesktop").val("");
                                         $('#discountPercentDesktop option:first').prop('selected', true);
                                         $('#ddlTableDesktop option:first').prop('selected', true);
                                    }catch(er){}
                                                    
                            //-------------------------------------------------------
                            //  Clear UI
                            //-------------------------------------------------------
                            $('#invoiceSection').hide();


                            clearCartUI();
                            $('#checkoutBtn, #checkoutBtnDesktop').prop('disabled', false);
                            $('#cartModal').modal('hide');

                        }, 50);

                    } else {
                        alert("Error: " + res.message);
                        $('#checkoutBtn, #checkoutBtnDesktop').prop('disabled', false);
                    }
                },
                error: function (err) {
                    alert("Save order failed.");
                    $('#checkoutBtn, #checkoutBtnDesktop').prop('disabled', false);
                }
            });
        }

