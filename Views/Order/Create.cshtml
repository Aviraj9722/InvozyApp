    function printPlainReceipt80mm(orgTitle, address, invoiceNo, date, customerName, productList, grandTotal,Contact,Mode,TableNo,discountPercent,discountedTotal, totalAmount, GSTSummury)
        {
        
    const ESC = "\x1B";
    const DOUBLE = ESC + "!" + "\x38";
    const MEDIUM = ESC + "!" + "\x20";
    const NORMAL = ESC + "!" + "\x00";
    const SMALL = ESC + "M" + "\x01";
    const NORMAL_FONT = ESC + "M" + "\x00";

    let dscUom = '%';
    let discountType = '@Org.DiscountType';
    discountType = discountType ? discountType.trim().toLowerCase() : '';
    if (discountType === "amount") dscUom = '/-';

    function wrapText(text, max) {
        let lines = [];
        while (text.length > 0) {
            lines.push(text.substring(0, max));
            text = text.substring(max);
        }
        return lines;
    }

    function center48(text) {
        const total = 48;
        let pad = Math.max(0, Math.floor((total - text.length) / 2));
        return " ".repeat(pad) + text;
    }

    function center24(text) {
        text = text.substring(0, 24);
        const total = 24;
        let pad = Math.max(0, Math.floor((total - text.length) / 2));
        return " ".repeat(pad) + text;
    }

    function rightAlign(label, value) {
        const totalWidth = 48;
        const text = label + value;
        return " ".repeat(Math.max(0, totalWidth - text.length)) + text;
    }

    let cleanDate = date.split(":").slice(0, 2).join(":");

    let receipt = "";

    receipt += "------------------------------------------------\n";

   

    // TITLE
    wrapText(orgTitle, 24).slice(0, 2).forEach(line => {
        receipt += MEDIUM + center24(line) + NORMAL + "\n";
    });

    // ADDRESS
    wrapText(address, 48).slice(0, 2).forEach(line => {
        receipt += center48(line) + "\n";
    });

    receipt += center48(Contact) + "\n";
    receipt += "------------------------------------------------\n";

     // GST HEADER
    if ('@Org.IsGstapplicable'.toLowerCase() === 'true') {
        receipt += DOUBLE + center24("TAX INVOICE") + NORMAL + "\n";
    }
    // DETAILS
    receipt += `Invoice#: ${invoiceNo}\n`;
    if (TableNo) receipt += `Table No : ${TableNo}\n`;
    receipt += `Customer : ${customerName}\n`;
    receipt += `Date     : ${cleanDate}\n`;
    receipt += `Mode     : ${Mode}\n`;

    receipt += "------------------------------------------------\n";

    // HEADER
    receipt += "Item                  Qty   Rate    Total\n";
    receipt += "------------------------------------------------\n";

    let calcTotal = 0;

    // ITEMS
    productList.forEach(p => {
        const product = allProducts.find(w => w.Id === p.productId);

        const name = (product?.Name || "").substring(0, 20).padEnd(20);
        const qty = String(p.qty).padStart(4);
        const rate = String(p.price).padStart(7);
        const total = String(p.qty * p.price).padStart(9);

        receipt += `${name} ${qty} ${rate} ${total}\n`;

        calcTotal += p.qty * p.price;
    });

    receipt += "------------------------------------------------\n";
     receipt += rightAlign("Subtotal: ", totalAmount + "/-") + "\n";
    // ✅ TOTAL BEFORE GST
    if ('@Org.IsGstapplicable'.toLowerCase() === 'true') {
       
        receipt += "------------------------------------------------\n";

        // ✅ GST SUMMARY HEADER
        receipt += "GST%        SGST        CGST\n";
        receipt += "----------------------------------------------\n";

        GSTSummury.forEach(item => {
            const gst = (item.gstPercentage + "%").padEnd(10);
            const sgst = String(item.sgst).padEnd(12);
            const cgst = String(item.cgst).padEnd(12);

            receipt += `${gst}${sgst}${cgst}\n`;
        });

        receipt += "------------------------------------------------\n";
    }

    if ('@Org.IsGstapplicable'.toLowerCase() !== 'true' && discountPercent > 0) 
    {
        receipt += rightAlign("Discount: ", discountPercent + " " + dscUom) + "\n";
    }
        
    // FINAL TOTAL
    const finalTotal = Math.round(grandTotal);
    receipt += MEDIUM + center24("Total: " + finalTotal + "/-") + NORMAL + "\n";

    receipt += "------------------------------------------------\n";

    // FOOTER
    receipt += center48("Thank you, visit again!") + "\n\n";
    receipt += SMALL + center48("Aviraj Innovations Pvt. Ltd.") + "\n";
    receipt += center48("Inquiry On: +91 9096152118") + "\n";
    receipt += NORMAL_FONT + "\n";

    // PRINT
    const encoded = btoa(unescape(encodeURIComponent(receipt)));

    if ('@Org.IsReceiptReprint'.toLowerCase() === 'true') {
        if (confirm("This receipt has already been printed.\nDo you want to re-print it?")) {
            window.location.href = "rawbt:base64," + encoded;
        }
    } else {
        window.location.href = "rawbt:base64," + encoded;
    }
}
            

