                tableDetail: tableDetail,
                paymentMode: paymentMode,
                isPaymentDone: IsPaymentDone,
                isPrinted: IsPrinted,
                discountPercent: parseFloat(discountPercent||0),
                discountedPrice: parseFloat(discountedTotal||0),
                items: cart.map(item => ({
                    productId: item.id,
                    qty: item.qty,
                    price: item.price
                })) 
            };

            $.ajax({
                url: '/Order/SaveOrder',
                type: 'POST',
                contentType: 'application/json',
