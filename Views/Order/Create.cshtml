            const iframe = document.getElementById("printPreviewFrame");
            const doc = iframe.contentWindow.document;

            doc.open();
            doc.write(html);
            doc.close();

            new bootstrap.Modal(
                document.getElementById("printPreviewModal")
            ).show();
        }

         function openPrintPreviewFromHtml(html, grandTotal) {
            const iframe = document.getElementById("printPreviewFrame");
            const doc = iframe.contentWindow.document;

            doc.open();
            doc.write(html);
            doc.close();

