        function printKotText(kotArray,TableName) {

            const ESC = "\x1B";
            const DOUBLE = ESC + "!" + "\x38";   // Big bold
            const MEDIUM = ESC + "!" + "\x20";   // Medium
            const NORMAL = ESC + "!" + "\x00";
            const SMALL = ESC + "M" + "\x01";
            const NORMAL_FONT = ESC + "M" + "\x00";

            let receipt = "";

            // -------- HEADER --------
            receipt += NORMAL;
            receipt += "------------------------------\n";
            receipt += MEDIUM + "     KITCHEN ORDER\n" + NORMAL;         
            receipt += "------------------------------\n";

            // Optional: table & time
            const now = new Date();
            receipt +=  "Table# " + TableName;
            receipt += "Time : " + now.toLocaleString('en-IN') + "\n";
            receipt += "------------------------------\n";

            // -------- ITEMS --------
            kotArray.forEach(item => {
                receipt += DOUBLE + item.name + "\n" + NORMAL;
                receipt += "Qty : " + item.qty + "\n";
                receipt += "------------------------------\n";
            });

              // -------- FOOTER --------
            receipt += NORMAL_FONT;
            receipt += "\n\n"; // paper feed

            // -------- RAWBT PRINT --------
            const encoded = btoa(unescape(encodeURIComponent(receipt)));
            window.location.href = "rawbt:base64," + encoded;
            if('@Org.IsReceiptReprint'.toLowerCase()=='true')
            {
                if (confirm("This receipt has already been printed.\nDo you want to re-print it?")) {
                        window.location.href = "rawbt:base64," + encoded;
                }
            }
        }

