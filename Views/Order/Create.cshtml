                                "@Org.Qrcode",
                                "@Org.OwnerName",
                                grandTotal,
                                "Order Payment"
                        );
                }
            
        }
            

            new bootstrap.Modal(
                document.getElementById("printPreviewModal")
            ).show();
        }


