        async function GetGSTSummary(orderId) {
            try {

                const response = await fetch(`/Order/GetOrderGstSummary?orderId=${orderId}`, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (!response.ok) {
                    throw new Error("Failed to fetch GST summary");
                }
               
                const result = await response.json();

                if (result.success) {
                    return result.data.result;
                } else {
                    return [];
                }

            } catch (error) {
                console.error("GST Summary Error:", error);
                return [];
            }
        }

