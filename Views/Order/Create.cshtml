}



        /* -------------------------
           Rendering: Categories & Products
           ------------------------*/
        function renderProducts() {
           // debugger;
            const container = $('#productContainer');
            container.empty();

                 // ✅ NEW FILTER (category + veg/nonveg)
                filteredProducts = allProducts.filter(p => {

                    // category filter
                    const categoryMatch =
                        selectedCategory === "all" ||
                        p.CategoryId == selectedCategory;

                    // ⭐ food filter (IMPORTANT FIX)
                    const foodMatch =
                        !selectedFoodType ||           // no radio selected
                        !p.FoodType ||                 // no food type → always show
                        p.FoodType.toLowerCase() === selectedFoodType.toLowerCase();

                    return categoryMatch && foodMatch;

                });
            const start = (currentPage - 1) * productsPerPage;
            const paginated = filteredProducts.slice(start, start + productsPerPage);

            if (paginated.length === 0) {
                container.append('<p>No products found.</p>');
                return;
            }
           console.log(paginated);
            paginated.forEach(p => {
                const img = p.Photo
                    ? `<img src="${p.Photo}" alt="${htmlEscape(p.Name)}" />`
                    :`<h4>${p.Name}</h4>`;
                    //: `<div style="height:100px;background:#eee;display:flex;align-items:center;justify-content:center;border-radius:6px;">No Image</div>`;

                        // veg / nonveg dot
                        let dotHtml = "";

                        if (p.FoodType && p.FoodType.toLowerCase() === "veg")
                            dotHtml = `
                                <span class="food-box veg">
                                    <span class="food-dot-inner"></span>
                                </span>
                            `;

                        else if (p.FoodType && p.FoodType.toLowerCase() === "nonveg")
                            dotHtml = `
                                <span class="food-box nonveg">
                                    <span class="food-dot-inner"></span>
                                </span>
                            `;

                // find current qty in cart (if any) so product card can show the qty
                const existing = cart.find(x => x.id === p.Id);
                const currentQty = existing ? existing.qty : 0;

                container.append(`
                    <div class="product-card ${p.Photo?'':'product-card-WithoutImage'}" data-id="${p.Id}">

                         ${dotHtml}
                        ${img}
                        <h6  title="${htmlEscape(p.Name)}" code="${p.Code}">${htmlEscape(p.Photo?p.Name:'')}</h6>
                        <p class="price">₹${p.Price}</p>
                        <div class="qty-controls">
                            <button class="btn btn-sm btn-outline-secondary qty-down" data-id="${p.Id}">-</button>
                            <input type="number" class="form-control form-control-sm product-qty" value="${currentQty}" id="qty-${p.Id}" readonly />
                            <button class="btn btn-sm btn-outline-secondary qty-up" data-id="${p.Id}">+</button>
                        </div>
                    </div>
                `);
            });

            renderPagination();
        }

        function renderPagination() {
            const totalPages = Math.ceil(filteredProducts.length / productsPerPage);
            const pagination = $('#pagination');
            pagination.empty();
            for (let i = 1; i <= totalPages; i++) {
                pagination.append(`
                    <li class="page-item ${i === currentPage ? 'active' : ''}">
                        <a class="page-link page-nav" href="#" data-page="${i}">${i}</a>
                    </li>
                `);
            }
        }

        /* -------------------------
           Cart logic & rendering (both desktop & modal)
           ------------------------*/
           function updateCart(id, name, price, qty) {
            const index = cart.findIndex(x => x.id === id);
            if (index > -1) {
                if (qty === 0) {
                    cart.splice(index, 1);
                } else {
                    cart[index].qty = qty;
                    cart[index].total = qty * price;
                }
            } else {
                if (qty > 0) {
                    cart.push({ id, name, price, qty, total: qty * price });
                }
            }

            // keep product card qty input in sync
            $(`#qty-${id}`).val(qty);

            renderCart();
            updateProductHighlight(id, qty);

        }

        function renderCart() {
        
            // mobile modal table
            const mobileTable = $('#cartItems');
            mobileTable.empty();

            // desktop cart container
            const desktopContainer = $('#desktopCartItems');
            desktopContainer.empty();

            let grandTotal = 0;
            let itemCount = 0;

            cart.forEach(item => {
                grandTotal += item.total;
                itemCount += item.qty;

                // mobile row (table)
                mobileTable.append(`
                    <tr data-id="${item.id}">
                        <td style="vertical-align:middle;">${htmlEscape(item.name)}</td>
                        <td>
                            <div class="input-group input-group-sm">
                                    <button class="btn btn-outline-secondary mobile-qty-down" data-id="${item.id}" style="background: #834242;color: white;font-weight: 900;">-</button>
                                <input type="text" class="form-control form-control-sm mobile-qty-input" data-id="${item.id}" value="${item.qty}" style="width:56px;text-align:center;" />
                                <button class="btn btn-outline-secondary mobile-qty-up" data-id="${item.id}"  style="background: #488c47;color: white;font-weight: 900;">+</button>
                            </div>
                        </td>
                        <td style="vertical-align:middle;">₹${item.price}</td>
                        <td style="vertical-align:middle;">₹${item.total.toFixed(2)}</td>
                        <td style="vertical-align:middle;"><button class="btn btn-sm remove-item" data-id="${item.id}">✖</button></td>
                    </tr>
                `);

                // desktop row
                desktopContainer.append(`
                    <div class="cart-item-row" data-id="${item.id}">
                        <div class="ci-name">${htmlEscape(item.name)}</div>
                        <div class="ci-qty">
                            <button class="btn btn-sm btn-outline-secondary desktop-qty-down" data-id="${item.id}">-</button>
                            <input type="number" class="form-control form-control-sm desktop-qty-input" data-id="${item.id}" value="${item.qty}" />
                            <button class="btn btn-sm btn-outline-secondary desktop-qty-up" data-id="${item.id}">+</button>
                        </div>
                        <div style="min-width:80px; text-align:right;">₹${item.total.toFixed(2)}</div>
                        <div><button class="btn btn-sm remove-item" data-id="${item.id}">✖</button></div>
                    </div>
                `);
                    updateProductHighlight(item.id, item.qty);
            });

            // if cart empty, show placeholder in desktop
            if (cart.length === 0) {
                desktopContainer.html('<p class="text-muted">Cart is empty. Add items from product list.</p>');
                mobileTable.append(`<tr><td colspan="5" class="text-center text-muted">Cart is empty.</td></tr>`);
            }

            $('#cartTotal').text(grandTotal.toFixed(2));
            $('#desktopCartTotal').text(grandTotal.toFixed(2));
            $('#cartCount').text(itemCount);
            $('#desktopCartCount').text(itemCount);
            try{calculateDiscountedTotalMobile()}catch(e){}
            try{calculateDiscountedTotalDesktop()}catch(e){}
             let container = $("#tableContainer");
            mobileTable.scrollTop(mobileTable[0].scrollHeight);
         barcodeInput.focus();
               
        }

        function clearCartUI() {
            // set all product qty inputs to 0
            $('.product-qty').val(0);
            cart = [];
            renderCart();

            // reset editing state if desired
            $('#isEditing').val(0);
            $('#editingOrderIdHidden').val('');
            $('#editingBadge').hide();
            $('#editingOrderId').text('');
            $('#checkoutBtn, #checkoutBtnDesktop').text('Checkout');
        }

        /* -------------------------
           Helpers
           ------------------------*/
        function htmlEscape(str) {
            if (!str && str !== 0) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
        }

        $(document).ready(function(){
            $("#discountPercentDesktop").on("change", function () {

                    calculateDiscountedTotalDesktop();
            });
            $("#discountPercentMobile").on("change", function () {

                calculateDiscountedTotalMobile();
            });
        });
    
        /* -------------------------
           EVENTS
           ------------------------*/
        // product qty / clicks (kept same)
        $(document).on('click', '.qty-up', function () {
            const id = $(this).data('id');
            const card = $(this).closest('.product-card');
            const input = $(`#qty-${id}`);
             const name = card.find('h6').attr('title').trim();
            const price = parseFloat(card.find('p.price').text().replace(/[^\d.]/g, '')) || 0;

            let qty = +input.val() + 1;
            input.val(qty);

            updateCart(id, name, price, qty);
        });

        $(document).on('click', '.product-card', function (e) {
            if ($(e.target).closest('.qty-controls, .qty-up, .qty-down, button, input, a').length) return;

            const card = $(this);
            const id = card.data('id');
            if (!id) return;

            const input = $(`#qty-${id}`);
              const name = card.find('h6').attr('title').trim();
            const price = parseFloat(card.find('p.price').text().replace(/[^\d.]/g, '')) || 0;

            let qty = +input.val() + 1;
            input.val(qty);

            updateCart(id, name, price, qty);
        });

        $(document).on('click', '.qty-down', function () {
            const id = $(this).data('id');
            const card = $(this).closest('.product-card');
            const input = $(`#qty-${id}`);
              const name = card.find('h6').attr('title').trim();
            const price = parseFloat(card.find('p.price').text().replace(/[^\d.]/g, '')) || 0;

            let qty = +input.val();
            if (qty > 0) qty--;
            input.val(qty);

            updateCart(id, name, price, qty);
        });

        // pagination click
        $(document).on('click', '.page-nav', function (e) {
            e.preventDefault();
            currentPage = +$(this).data('page');
            renderProducts();
        });

        // category click (top bar)
        $(document).on('click', '.category-top .category-btn, .category-btn', function () {
            $('.category-btn').removeClass('active');
            $(this).addClass('active');

            const val = $(this).data('id');
            filteredProducts = val === 'all'
                ? [...allProducts]
                : allProducts.filter(p => p.CategoryId == val);

            currentPage = 1;
            renderProducts();
              renderCart();
