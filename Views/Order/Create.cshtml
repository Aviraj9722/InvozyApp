            function printPlainReceipt58mm(orgTitle, address, invoiceNo, date, customerName, productList, grandTotal = 0, Contact, Mode, TableNo,discountPercent,discountedTotal) {

                    const ESC = "\x1B";
                    const DOUBLE = ESC + "!" + "\x38";        // Big font
                    const MEDIUM = ESC + "!" + "\x20";        // Medium (double height)
                    const NORMAL = ESC + "!" + "\x00";        // Normal
                    const SMALL = ESC + "M" + "\x01";         // Small font
                    const NORMAL_FONT = ESC + "M" + "\x00";
                    let dscUom = '%';
                    let discountType = '@Org.DiscountType';
                    discountType = discountType ? discountType.trim().toLowerCase() : '';

                    if (discountType === "amount") {
                            dscUom = '/-';
                    }
                    // Split long text into lines of fixed width
                    function wrapText(text, max) {
                        let lines = [];
                        while (text.length > 0) {
                            lines.push(text.substring(0, max));
                            text = text.substring(max);
                        }
                        return lines;
                    }

                    // Center 32-wide lines
                    function center32(text) {
                        const total = 32;
                        let pad = Math.max(0, Math.floor((total - text.length) / 2));
                        return " ".repeat(pad) + text;
                    }

                    // Center 16-wide lines (medium / double-width)
                    function center16(text) {
                        text = text.substring(0, 16);
                        const total = 16;
                        let pad = Math.max(0, Math.floor((total - text.length) / 2));
                        return " ".repeat(pad) + text;
                    }

                    // Format date (remove seconds)
                    let cleanDate = date.split(":");
                    if (cleanDate.length >= 2) {
                        cleanDate = cleanDate[0] + ":" + cleanDate[1]; // keep HH:mm only
                    } else {
                        cleanDate = date;
                    }

                    let receipt = "";
                    receipt += "--------------------------------\n";

                    // ---- Title (Medium Font + Auto wrap) ----
                    let titleLines = wrapText(orgTitle, 16).slice(0, 2); // max 2 lines

                    titleLines.forEach(line => {
                        receipt += MEDIUM + center16(line) + NORMAL + "\n";
                    });

                    // ---- Address (Auto Wrap in 32) ----
                    let addressLines = wrapText(address, 32).slice(0, 2);
                    addressLines.forEach(line => {
                        receipt += center32(line) + "\n";
                    });

                    receipt += "Contact : " + Contact + "\n";
                    receipt += "--------------------------------\n";

                    // Invoice details
                    receipt += `Invoice#: ${invoiceNo}\n`;
                    if (TableNo) receipt += `Table No: ${TableNo}\n`;
                    receipt += `Customer : ${customerName}\n`;
                    receipt += `Date     : ${cleanDate}\n`;
                    receipt += `Mode     : ${Mode}\n`;
                    receipt += "--------------------------------\n";

                    // Table header
                    receipt += "Item            Qty  Rate  Total\n";
                    receipt += "--------------------------------\n";

                    // Items
                    productList.forEach(p => {
                        const product = allProducts.find(w => w.Id === p.productId);

                        const name = (product?.Name || "").padEnd(14, " ").substring(0, 14);
                        const qty = String(p.qty).padStart(3, " ");
                        const rate = String(p.price).padStart(5, " ");
                        const total = String(p.qty * p.price).padStart(7, " ");

                        receipt += `${name} ${qty} ${rate} ${total}\n`;

                        grandTotal += p.qty * p.price;
                    });

                    receipt += "--------------------------------\n";

                    if(discountPercent>0){
                    receipt += `            Total: ${grandTotal}\n`;
                    receipt += `           Disc.: ${discountPercent} ${dscUom}\n`;

                            }
                    // Grand total – Medium font centered
                    const grandText = "Total: " + Math.round(discountedTotal)+ "/-";
                    receipt += MEDIUM + center16(grandText) + NORMAL + "\n";

                    receipt += "--------------------------------\n";

                    // Footer small text
                    receipt += center32("Thank you, visit again!") + "\n\n";
                    receipt += SMALL + center32("Aviraj Innovations Pvt. Ltd.") + "\n";
                    receipt += center32("Inquiry On: +91 9096152118") + "\n";
                    receipt += NORMAL_FONT + "\n";

                    // Print
                    const encoded = btoa(unescape(encodeURIComponent(receipt)));
                    window.location.href = "rawbt:base64," + encoded;

                    if('@Org.IsReceiptReprint'.toLowerCase()=='true')
                    {
                        if (confirm("This receipt has already been printed.\nDo you want to re-print it?")) {
                                window.location.href = "rawbt:base64," + encoded;
                        }
                    }
                }

        function printReceipt80mm_MultiCounter(
            orgTitle, address, invoiceNo, date, customerName,
            productList, grandTotal, Contact, Mode, TableNo,
            discountPercent, discountedTotal, totalAmount, GSTSummury
        ) {
            let html = "";
            let currentCounter = "";
            let counterTotal = 0;   // ✅ ADD

            // ✅ SORT BY COUNTER NAME FIRST
            const sortedList = [...productList].sort((a, b) => {
                const prodA = allProducts.find(x => x.Id === a.productId);
                const prodB = allProducts.find(x => x.Id === b.productId);

                const counterA = prodA?.KitchenCounterName || "Main";
                const counterB = prodB?.KitchenCounterName || "Main";

                return counterA.localeCompare(counterB);
            });

            // ✅ LOOP SORTED LIST
            sortedList.forEach((p, index) => {

                const prod = allProducts.find(x => x.Id === p.productId);
                const counterName = prod?.KitchenCounterName || "Main";

                // ✅ counter changed
                if (currentCounter !== counterName) {

                    // print previous counter total
                        if (currentCounter !== "") {
                            html += `
                            <tr>
                                <td colspan="4" style="text-align:right;font-weight:bold">
                                    ${currentCounter} Total : ${counterTotal}/-
                                </td>
                            </tr>

                            <tr>
                                <td colspan="4">
                                    <hr style="border-top:1px dashed #000;">
                                </td>
                            </tr>

                            <tr>
                                <td colspan="4" style="height:15px"></td>
                            </tr>
                            `;
                            counterTotal = 0;
                        }

                    currentCounter = counterName;
                    // ✅ Indian date dd-mm-yyyy + 12hr time
                    const now = new Date();

                    const day = String(now.getDate()).padStart(2, '0');
                    const month = String(now.getMonth() + 1).padStart(2, '0');
                    const year = now.getFullYear();

                    let hours = now.getHours();
                    const minutes = String(now.getMinutes()).padStart(2, '0');

                    const ampm = hours >= 12 ? 'PM' : 'AM';
                    hours = hours % 12;
                    hours = hours ? hours : 12;

                    const counterDate = `${day}-${month}-${year} ${hours}:${minutes} ${ampm}`;
                        html += `
                        <tr>
                            <td colspan="4">
                                <hr>
                                <div style="display:flex;justify-content:space-between;font-weight:bold">
                                    <span>Counter : ${counterName}</span>
                                    <span style="font-size:12px">${counterDate}</span>
                                </div>
                                <hr>
                            </td>
                        </tr>`;
                }

                const name = prod?.Name || "";
                const qty = p.qty;
                const rate = p.price;
                const total = qty * rate;

                counterTotal += total;   // ✅ ADD

                html += `
                <tr>
                    <td>${name}</td>
                    <td class="qty">${qty}</td>
                    <td class="rate">${rate}</td>
                    <td class="total">${total}</td>
                </tr>`;

                // ✅ LAST COUNTER TOTAL
                    if (index === sortedList.length - 1) {
                        html += `
                        <tr>
                            <td colspan="4" style="text-align:right;font-weight:bold">
                                ${counterName} Total : ${counterTotal}/-
                            </td>
                        </tr>

                        <tr>
                            <td colspan="4">
                                <hr style="border-top:1px dashed #000;">
                            </td>
                        </tr>

                        <tr>
                            <td colspan="4" style="height:15px"></td>
                        </tr>
                        `;
                    }

            });

            return html;
        }
        
        // Open Cart Modal
        $("#btnMobileViewCart").click(function () {
            $("#cartModal").modal("show");

        });

        // Save button → same as checkout button
