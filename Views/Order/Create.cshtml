                        $("#discountedTotalDesktop").text(discountedTotal.toFixed(2));
                }
        }

        function calculateDiscountedTotalMobile() {

               if('@Org.DiscountType'.toLowerCase()=='amount')
                {
                    debugger;

                    let total = parseFloat($("#cartTotal").text()) || 0;
                    let discountAmount = parseFloat($("#discountPercentMobile").val()) || 0;
                    if (discountAmount <0) {
                    $("#discountPercentDesktop").val(0);
                    return;
                    }
                    // Ensure discount does not exceed total
                    if (discountAmount > total) {
                    discountAmount = total;
                    $("#discountPercentMobile").val(total);
                    }

                    let discountedTotal = total - discountAmount;

                    $("#discountedTotalMobile").text(discountedTotal.toFixed(2));
            }else
            {
                let total = parseFloat($("#cartTotal").text()) || 0;
                let discountPercent = parseFloat($("#discountPercentMobile").val()) || 0;

                let discountAmount = (total * discountPercent) / 100;
                let discountedTotal = total - discountAmount;

                $("#discountedTotalMobile").text(discountedTotal.toFixed(2));
            }
        }
