        function repopulateCartFromOrder(order) {
            
            // Clear existing cart
            cart = [];
            //debugger;

            // ensure product qty inputs reset
            $('.product-qty').val(0);

            // populate cart array from order items
            (order.items || []).forEach(i => {
                const prod = allProducts.find(p => p.Id === i.productId);
                const name = prod ? prod.Name : ('Product ' + i.productId);
                const price = parseFloat(i.price) || (prod ? prod.price : 0);
                const qty = parseFloat(i.qty) || 0;

                if (qty > 0) {
                    cart.push({ id: i.productId, name: name, price: price, qty: qty, total: price * qty });
                    // set qty input on product card (if rendered)
                    $(`#qty-${i.productId}`).val(qty);
                }
            });

            // customer, table, payment
            $('#txtCustNameDesktop').val(order.customerName || '');
            $('#txtCustNameMobile').val(order.customerName || '');
            $('#ddlTableDesktop').val(order.tableDetails || '');
            $('#ddlTableMobile').val(order.tableDetails || '');

            if (order.paymentMode) {
                $(`input[name="paymentDesktop"][value="${order.paymentMode}"]`).prop('checked', true);
                $(`input[name="paymentMobile"][value="${order.paymentMode}"]`).prop('checked', true);
            }

            // mark editing state
            $('#isEditing').val(1);
            $('#editingOrderIdHidden').val(order.id);
            $('#editingBadge').show();
            $('#editingOrderId').text(order.id);
            $('#checkoutBtn, #checkoutBtnDesktop').text('Checkout');

            renderCart();

            // trigger product sync so when renderProducts runs, it will set inputs properly
            $(document).trigger('renderProductsSync');
        }

