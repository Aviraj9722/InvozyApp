        let scanBuffer = "";
        let scanTimer = null;

        const barcodeInput = document.getElementById("barcodeInput");


        function safeFocusBarcode() {
            const active = document.activeElement.id;

            // If user is typing in search box → DO NOT steal focus
            if (active === "txtSearchItem") return;

            if (active === "txtCustNameDesktop") return;

            if (active === "ddlTableDesktop") return;

             if (active === "txtCustNameMobile") return;

            if (active === "ddlTableMobile") return;

            if (active === "txtSearchCustomer") return;
            if (active === "forceTableName") return;
            if (active === "forceCustName") return;

            if (active === "discountPercentDesktop") return;

            if (active === "discountPercentMobile") return;

                
            barcodeInput.focus();
        }

        if('@Org.BarcodeEnabled'.toLowerCase()=='true')
        {
            // Always keep focus
            setInterval(() => {
                if (document.activeElement !== barcodeInput) {
                //    barcodeInput.focus();
                safeFocusBarcode();
                }
            }, 300);

        }

        // Capture fast input from scanner
        barcodeInput.addEventListener("input", function () {

            if('@Org.BarcodeEnabled'.toLowerCase()!='true')
            {
                alert("Barcode feature is not enabled. Contact Invozy suport team.");
                return;
            }
            const value = this.value;

            // Add new characters to buffer
            scanBuffer += value;

            // Clear the visible textbox so it stays empty
            this.value = "";

            // Clear existing timer
            if (scanTimer) clearTimeout(scanTimer);

            // If no new input for 60ms → scan finished
            scanTimer = setTimeout(() => {
                let code = scanBuffer.trim();
                scanBuffer = ""; // reset buffer

                if (code.length > 0) {
                    console.log("FINAL BARCODE:", code);
                    processBarcode(code);      // your function
                }

            }, 60);
        });
        const findQtyById = (cart, id) => {
            let qty = 0;

            cart.forEach(item => {
            if (item.id === id) {
                qty = item.qty;
            }
            });

            return qty;
        };
        function processBarcode(code) {
             $("#lblMsg").empty();
            fetch(`/Order/GetProductByBarcode?code=${code}`)
                .then(r => r.json())
                .then(res => {
                    if (!res.success) {
                        $("#lblMsg").text("Barcode not found");
                        return;
                    }

                    let p = res.data;

                    const id = p.id;
                    const price = parseFloat(p.price);
                    const name = p.name;
                    debugger;
                   // const input = $(`#qty-${id}`);


                 var OldQty = findQtyById(cart, id);

                    let qty = 1;

                    try{
                       // if (input.length > 0) {
                        if (OldQty > 0) {
                            //qty = parseInt(input.val()) + 1;
                            qty = parseInt(OldQty) + 1;
                            input.val(qty);
                        }
                    }catch(er)
                    {}

                    updateCart(id, name, price, qty);

                    // 🔥 Highlight cart row (DIV)
                    setTimeout(() => {
                        const row = $(`.cart-item-row[data-id="${id}"]`);
                        row.addClass("cart-highlight");

                        setTimeout(() => {
                            row.removeClass("cart-highlight");
                        }, 600);
                    }, 100);
                });
        }




    </script>


    <script>

        function openCustomerModal() {
            loadCustomers();
            var modal = new bootstrap.Modal(document.getElementById('customerModal'));
            modal.show();
        }

        function loadCustomers() {
            let search = document.getElementById("txtSearchCustomer").value;

            fetch(`/Order/GetCustomers?search=${search}`)
                .then(r => r.json())
                .then(list => {
                    let tbody = "";

                    list.forEach(c => {
                        tbody += `
                            <tr>

                                <td>${c.name}</td>
                                <td>${c.location}</td>
                                <td>${c.mobileNo}</td>
                                <td>
                                    <button class="btn btn-sm btn-success"
                                            onclick="selectCustomer('${c.name}')">
                                        Select
                                    </button>
                                </td>
                            </tr>`;
                    });

                    document.getElementById("customerList").innerHTML = tbody;
                });
        }

        function selectCustomer(name) {
            document.getElementById("txtCustNameDesktop").value = name;
            document.getElementById("txtCustNameMobile").value = name;
             document.getElementById("forceCustName").value = name;


            let modal = bootstrap.Modal.getInstance(document.getElementById('customerModal'));
            modal.hide();
        }

    </script>
    <script>
            function generateUpiQR(doc, upiId, name, amount, note) {

        const qrDiv = doc.getElementById("upiQr");
        if (!qrDiv) return;

        const upiUrl =
            `upi://pay?pa=${encodeURIComponent(upiId)}` +
            `&pn=${encodeURIComponent(name)}` +
            `&am=${amount}&cu=INR` +
            `&tn=${encodeURIComponent(note)}`;

        qrDiv.innerHTML = "";

        new QRCode(qrDiv, {
            text: upiUrl,
            width: 150,
            height: 150
        });
    }


    </script>

