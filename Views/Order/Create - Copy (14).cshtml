        function doCheckout(customerName, tableDetail, paymentMode, IsPaymentDone, IsPrinted) {

            if('@Org.IsTableNoRequired'.toLowerCase()=='true' && IsPrinted==true)
            {
                if(tableDetail.trim() =="")
                {
                        alert("Please select Table/Room before checkout.");
                        return;
                }
              
            }

            if (cart.length === 0) {
                alert("Cart is empty. Please add some items for sale.");
                return;
            }

            $('#checkoutBtn, #checkoutBtnDesktop').prop('disabled', true);

            const order = {
                editOrderId: $('#isEditing').val() === '1' ? parseInt($('#editingOrderIdHidden').val() || '0') : null,
                customerName: customerName,
                tableDetail: tableDetail,
                paymentMode: paymentMode,
                isPaymentDone: IsPaymentDone,
                isPrinted: IsPrinted,
                items: cart.map(item => ({
                    productId: item.id,
                    qty: item.qty,
                    price: item.price
                }))
            };

            $.ajax({
                url: '/Order/SaveOrder',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(order),
                success: function (res) {

                    if (res.success) {
                         

                        //-------------------------------------------------------
                        //  KOT LOGIC — OPEN PRINT WINDOW IF NEW ITEMS EXIST
                        //-------------------------------------------------------
                        if (res.kotItems && res.kotItems.length > 0) {
                            try {
                             //   window.open('/Order/PrintKOT?orderId=' + res.orderId, '_blank');
                                     //-------------------------------------------------------
                                        // SHOW POPUP FOR KOT ITEMS
                                        //-------------------------------------------------------
                                        if (res.kotItems && res.kotItems.length > 0) {

                                            let html = `<div>${tableDetail}</div>`;
                                            html += `<table class="table table-bordered table-sm mt-2">
                                                        <thead>
                                                          <tr>
                                                            <th style='background: #606a61 !important;'>Item</th>
                                                            <th style='background:#606a61 !important;'>Qty</th>
                                                          </tr>
                                                        </thead>
                                                        <tbody>
                                                    `;

                                            res.kotItems.forEach(k => {
                                                const product = allProducts.find(p => p.Id === k.productId);  // your existing products list
                                                html += `
                                                    <tr>
                                                        <td style='background: #606a61 !important;'>${product?.Name || ''}</td>
                                                        <td style='background: #606a61 !important;'>${k.qty}</td>
                                                    </tr>
                                                `;
                                                            TableName = tableDetail;
                                                     // ✅ Store in KOT array
                                                    kotArray.push({
                                                        productId: k.productId,
                                                        name: product?.Name,
                                                        qty: k.qty
                                                    });
                                            });

                                            html += `</tbody></table>`;

                                            $("#kotModalBody").html(html);

                                            if('@Org.IsKOTEnabled'.toLowerCase()=='true' && IsPrinted==false)
                                            {
                                                $("#kotModal").modal("show");
                                            }

                                            // Store order ID for printing
                                            $("#btnPrintKOT").data("orderid", res.orderId);
                                        }

                            } catch (er) {
                                console.log("KOT print failed.");
                            }
                        }

                        //-------------------------------------------------------
                        //  EXISTING BILL PRINT LOGIC — NO CHANGE
                        //-------------------------------------------------------
                        setTimeout(() => {
                            const isDesktop = window.innerWidth > 991;
                           
                            const tableNo = isDesktop ? $("#ddlTableDesktop").val() : $("#ddlTableMobile").val();

                            const paymentMode = isDesktop
                                ? document.querySelector('input[name="paymentDesktop"]:checked').value
                                : document.querySelector('input[name="paymentMobile"]:checked').value;

                            let card = $('.product-card');
                            card.removeClass("product-added");

