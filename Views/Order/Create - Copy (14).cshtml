                mobileTable.append(`<tr><td colspan="5" class="text-center text-muted">Cart is empty.</td></tr>`);
            }

            $('#cartTotal').text(grandTotal.toFixed(2));
            $('#desktopCartTotal').text(grandTotal.toFixed(2));
            $('#cartCount').text(itemCount);
            $('#desktopCartCount').text(itemCount);
             let container = $("#tableContainer");
            mobileTable.scrollTop(mobileTable[0].scrollHeight);
         barcodeInput.focus();
