        // Click edit to load order into cart
        $(document).on('click', '.edit-order-btn', function () {
            const id = $(this).data('id');
            if (!id) return;
            // fetch order
            $.ajax({
                url: '/Order/GetOrder?id=' + id,
                type: 'GET',
                success: function (res) {
                    if (!res.success) {
                        alert('Unable to load order');
                        return;
                    }
                    const data = res.data;
                    // populate UI fields (customer, table, payment, items)
                    repopulateCartFromOrder(data);
                    // close history modal
                    $('#orderHistoryModal').modal('hide');
                    // scroll to top so user sees cart (optional)
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                },
                error: function () {
                    alert('Unable to load order');
                }
            });
        });

        function repopulateCartFromOrder(order) {
            // Clear existing cart
            cart = [];
            //debugger;

            // ensure product qty inputs reset
            $('.product-qty').val(0);

            // populate cart array from order items
            (order.items || []).forEach(i => {
                const prod = allProducts.find(p => p.Id === i.productId);
                const name = prod ? prod.Name : ('Product ' + i.productId);
                const price = parseFloat(i.price) || (prod ? prod.price : 0);
                const qty = parseFloat(i.qty) || 0;

                if (qty > 0) {
                    cart.push({ id: i.productId, name: name, price: price, qty: qty, total: price * qty });
                    // set qty input on product card (if rendered)
                    $(`#qty-${i.productId}`).val(qty);
                }
            });

            // customer, table, payment
            $('#txtCustNameDesktop').val(order.customerName || '');
            $('#txtCustNameMobile').val(order.customerName || '');
            $('#ddlTableDesktop').val(order.tableDetails || '');
            $('#ddlTableMobile').val(order.tableDetails || '');

            if (order.paymentMode) {
                $(`input[name="paymentDesktop"][value="${order.paymentMode}"]`).prop('checked', true);
                $(`input[name="paymentMobile"][value="${order.paymentMode}"]`).prop('checked', true);
            }

            // mark editing state
            $('#isEditing').val(1);
            $('#editingOrderIdHidden').val(order.id);
            $('#editingBadge').show();
            $('#editingOrderId').text(order.id);
            $('#checkoutBtn, #checkoutBtnDesktop').text('Checkout');

            renderCart();

            // trigger product sync so when renderProducts runs, it will set inputs properly
            $(document).trigger('renderProductsSync');
        }

        /* -------------------------
           Initial render
           ------------------------*/
        renderProducts();
        renderCart();

        // make sure when page re-renders product list we sync product qty values from cart
        const origRenderProducts = renderProducts;
        renderProducts = function () {
            origRenderProducts();
            $(document).trigger('renderProductsSync');
        };

        // =========================
        // Receipt / RawBT functions (kept as your original)
        // =========================
        function generateInvoicePDF() {
            const receiptHTML = document.getElementById("invoiceSection").innerHTML;
            const encoded = btoa(unescape(encodeURIComponent(receiptHTML)));
            window.location.href = "rawbt:base64," + encoded;
        }



        $(document).on("click", ".cancel-order-btn", function () {
            let orderId = $(this).data("id");
                      let button = $(this);                   // store reference
           
            let note = prompt("Enter cancellation reason:");

            if (!note) {
                alert("Cancellation note is required.");
                return;
            }

            $.ajax({
                url: "/Order/CancelOrder",
                method: "POST",
                contentType: "application/json",
                data: JSON.stringify({ orderId: orderId, note: note }),
                success: function (res) {
                    if (res.success) {
                        alert("Order cancelled");
                        button.closest(".order-card").remove();
                        loadLastOrders(); // reload order list
                    } else {
                        alert(res.message);
                    }
                }
            });
        });


