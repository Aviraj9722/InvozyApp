                                                        order.items,
                                                        0,
                                                        '@Org.MobileNo',
                                                        paymentMode,
                                                        tableNo
                                                    );
                                                 }else
                                                 {
                                                        printPlainReceipt80mm(
                                                        '@Org.BusinessName',
                                                        '@Org.Address',
                                                        res.orderId,
                                                        new Date().toLocaleString(),
