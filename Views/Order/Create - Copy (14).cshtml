        /* -------------------------
           Rendering: Categories & Products
           ------------------------*/
        function renderProducts() {
           // debugger;
            const container = $('#productContainer');
            container.empty();
            const start = (currentPage - 1) * productsPerPage;
            const paginated = filteredProducts.slice(start, start + productsPerPage);

            if (paginated.length === 0) {
                container.append('<p>No products found.</p>');
                return;
            }

            paginated.forEach(p => {
                const img = p.Photo
                    ? `<img src="${p.Photo}" alt="${htmlEscape(p.Name)}" />`
                    :`<h4>${p.Name}</h4>`;
                    //: `<div style="height:100px;background:#eee;display:flex;align-items:center;justify-content:center;border-radius:6px;">No Image</div>`;

                // find current qty in cart (if any) so product card can show the qty
                const existing = cart.find(x => x.id === p.Id);
                const currentQty = existing ? existing.qty : 0;

                container.append(`
                    <div class="product-card ${p.Photo?'':'product-card-WithoutImage'}" data-id="${p.Id}">
                        ${img}
                        <h6  title="${htmlEscape(p.Name)}">${htmlEscape(p.Photo?p.Name:'')}</h6>
                        <p class="price">₹${p.Price}</p>
                        <div class="qty-controls">
                            <button class="btn btn-sm btn-outline-secondary qty-down" data-id="${p.Id}">-</button>
                            <input type="number" class="form-control form-control-sm product-qty" value="${currentQty}" id="qty-${p.Id}" readonly />
                            <button class="btn btn-sm btn-outline-secondary qty-up" data-id="${p.Id}">+</button>
                        </div>
                    </div>
                `);
            });

            renderPagination();
        }

        function renderPagination() {
            const totalPages = Math.ceil(filteredProducts.length / productsPerPage);
            const pagination = $('#pagination');
            pagination.empty();
            for (let i = 1; i <= totalPages; i++) {
                pagination.append(`
                    <li class="page-item ${i === currentPage ? 'active' : ''}">
                        <a class="page-link page-nav" href="#" data-page="${i}">${i}</a>
                    </li>
                `);
            }
        }

        /* -------------------------
           Cart logic & rendering (both desktop & modal)
           ------------------------*/
        function updateCart(id, name, price, qty) {
            const index = cart.findIndex(x => x.id === id);
            if (index > -1) {
                if (qty === 0) {
                    cart.splice(index, 1);
                } else {
                    cart[index].qty = qty;
                    cart[index].total = qty * price;
                }
            } else {
                if (qty > 0) {
                    cart.push({ id, name, price, qty, total: qty * price });
                }
            }

            // keep product card qty input in sync
            $(`#qty-${id}`).val(qty);

            renderCart();
            updateProductHighlight(id, qty);

        }

        function renderCart() {
        //    debugger;
            // mobile modal table
            const mobileTable = $('#cartItems');
            mobileTable.empty();

            // desktop cart container
            const desktopContainer = $('#desktopCartItems');
            desktopContainer.empty();

            let grandTotal = 0;
            let itemCount = 0;

            cart.forEach(item => {
                grandTotal += item.total;
                itemCount += item.qty;

                // mobile row (table)
                mobileTable.append(`
