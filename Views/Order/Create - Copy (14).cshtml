                                                        0,
                                                        '@Org.MobileNo',
                                                        paymentMode,
                                                        tableNo
                                                        );
                                                 }
                                     

                                      

                                    } else {
                                        printPlainReceipt58mm(
                                            '@Org.BusinessName',
                                            '@Org.Address',
                                            res.orderId,
                                            new Date().toLocaleString(),
                                            order.customerName,
                                            order.items,
                                            0,
