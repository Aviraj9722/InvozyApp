   <script>
        let itemBarChart;

        function loadItemHorizontalBar(fromDate, toDate) {

            fetch(`/Home/ItemWiseSaleBar?fromDate=${fromDate}&toDate=${toDate}`)
                .then(res => res.json())
                .then(data => {

                    if (!data || data.length === 0) return;

                    const labels = data.map(x => x.label);
                    const values = data.map(x => x.value);

                    const total = values.reduce((a, b) => a + b, 0);
                    const percentages = values.map(v => ((v / total) * 100).toFixed(1));

                    /* 🔹 Dynamic height for 100+ items */
                    const barHeight = 28;
                    const minHeight = 420;
                    const canvasHeight = Math.max(labels.length * barHeight, minHeight);
                    document.getElementById('itemItemBarChart').height = canvasHeight;

                    const ctx = document.getElementById('itemItemBarChart').getContext('2d');

                    if (itemBarChart) itemBarChart.destroy();

                    itemBarChart = new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [{
                                data: values,
                                backgroundColor: '#4CAF50',
                                borderRadius: 8,
                                barThickness: 18,
                                maxBarThickness: 22
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            layout: {
                                padding: { right: 60 }
                            },
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: ctx => `₹ ${ctx.raw.toLocaleString()} (${percentages[ctx.dataIndex]}%)`
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: value => '₹ ' + value
                                    },
                                    grid: {
                                        color: '#eee'
                                    }
                                },
                                y: {
                                    grid: { display: false }
                                }
                            }
                        },
                        plugins: [{
                            /* 🔹 Percentage on bar (right side) */
                            afterDatasetsDraw(chart) {
                                const { ctx } = chart;
                                ctx.save();
                                ctx.font = 'bold 13px Arial';
                                ctx.fillStyle = '#2e7d32';

                                chart.getDatasetMeta(0).data.forEach((bar, index) => {
                                    ctx.fillText(
                                        percentages[index] + '%',
                                        bar.x + 10,
                                        bar.y + 4
                                    );
                                });
                            }
                        }]
                    });
                })
                .catch(err => console.error(err));
        }
    </script>




} *@
