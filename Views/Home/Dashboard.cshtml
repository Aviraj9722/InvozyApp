@{
    ViewData["Title"] = "Dashboard";
}

<style>
    footer {
        display: none;
    }
    /* Base card style */
    .dashboard-card {
        border-radius: 18px;
        background: #1e1e1e; /* Default dark color */
        transition: all 0.25s ease-in-out;
        border: none;
        overflow: hidden;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.25);
    }

        /* Hover effect */
        .dashboard-card:hover {
            transform: scale(1.03);
            box-shadow: 0px 6px 20px rgba(0,0,0,0.35);
        }

    /* Solid dark colors per button (optional but looks good) */
    .dash-col:nth-child(1) .dashboard-card {
        background: #2c3e50;
    }

    .dash-col:nth-child(2) .dashboard-card {
        background: #1f4b99;
    }

    .dash-col:nth-child(3) .dashboard-card {
        background: #6a1b9a;
    }

    .dash-col:nth-child(4) .dashboard-card {
        background: #b71c1c;
    }

    .dash-col:nth-child(5) .dashboard-card {
        background: #004d40;
    }

    .dash-col:nth-child(6) .dashboard-card {
        background: #4e342e;
    }

    .dash-col:nth-child(7) .dashboard-card {
        background: #263238;
    }

    .dash-col:nth-child(8) .dashboard-card {
        background: #37474f;
    }

    .dash-col:nth-child(9) .dashboard-card {
        background: #1b5e20;
    }

    .dash-col:nth-child(10) .dashboard-card {
        background: #1e3a8a;
    }

    .dash-col:nth-child(11) .dashboard-card {
        background: #880e4f;
    }

    /* White icon and label */
    .dashboard-card i,
    .dashboard-card h6 {
        color: #ffffff !important;
    }

    /* Desktop: 3 columns */
    .dash-col {
        width: 33.33%;
        max-width: 33.33%;
        padding: 5px;
    }

    /* ------- MOBILE UI ------- */
    @@media only screen and (max-width: 768px) {
        /* 2 per row */
        .dash-col {
            width: 50% !important;
            max-width: 50% !important;
            padding: 7px !important;
        }
        /* Larger tiles for mobile */
        .dashboard-card {
            height: 135px !important;
            border-radius: 20px;
            display: flex !important;
            justify-content: center;
            align-items: center;
            padding: 0 !important;
            box-shadow: 0px 6px 16px rgba(0,0,0,0.35);
        }
            /* Large icons */
            .dashboard-card i {
                font-size: 2.6rem !important;
                margin-bottom: 6px !important;
            }
            /* Large text */
            .dashboard-card h6 {
                font-size: 1.15rem !important;
                font-weight: 700 !important;
                text-align: center;
            }

        .dash-col {
            margin-bottom: 12px;
        }

            .dash-col:last-child {
                margin-bottom: 90px;
            }
        /* KPI Card */
        .kpi-card {
            padding: 18px 12px;
            text-align: center;
            color: #fff; /* White text */
            box-shadow: 0 3px 10px rgba(0,0,0,0.18);
            min-height: 100px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        /* KPI Label */
        .kpi-label {
            color: #ffffff; /* white */
            font-size: 1.1rem; /* large */
            font-weight: 700; /* bold */
            text-transform: uppercase;
            letter-spacing: 0.6px;
            margin-bottom: 6px;
        }
        /* KPI Value */
        .kpi-value {
            color: white; /* white */
            font-size: larger; /* very large */
            font-weight: bolder; /* extra bold */
            line-height: 1.2;
        }
        /* ================= KPI ALIGNMENT FIX ================= */
        .kpi-scroll-row {
            display: flex;
            flex-wrap: wrap;
        }

        .kpi-card {
            height: 100px;
        }

        .kpi-value {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
        }

        @@media (max-width: 768px) {
            .kpi-scroll-row > .col-6 {
                flex: 0 0 50%;
                max-width: 50%;
            }

            .kpi-scroll-row > div {
                padding-left: 6px;
                padding-right: 6px;
                margin-bottom: 12px;
            }
        }
    }
</style>

@if (!User.IsInRole("Admin"))
{
    <div class="container-fluid py-4">
        <h3 class="text-center fw-bold text-primary mb-4">Invozy Dashboard</h3>
        @* <h3 class="text-center fw-bold text-primary mb-4">Today's Summary</h3> *@
        <div class="kpi-scroll-wrapper">
            <div class="row g-3 justify-content-center text-center kpi-scroll-row">


                <div class="col-lg-2 col-md-4 col-sm-6 col-6">
                    <div class="kpi-card" style="background-color:#4e73df;">
                        <div class="kpi-label" style="color:white">Today's Orders</div>
                        <div class="kpi-value" style="font-weight:bolder;color:white">@((Model?.TotalOrders) ?? 0)</div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6 col-6">
                    <div class="kpi-card" style="background-color:#1cc88a;">
                        <div class="kpi-label" style="color:white">Total Sale</div>
                        <div class="kpi-value" style="font-weight:bolder;color:white">₹ @((Model?.TotalSale) ?? 0)</div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6 col-6">
                    <div class="kpi-card" style="background-color:#f6c23e;">
                        <div class="kpi-label" style="color:white">Total Profit</div>
                        <div class="kpi-value" style="font-weight:bolder;color:white">₹ @((Model?.Profit) ?? 0)</div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6 col-6">
                    <div class="kpi-card" style="background-color:#36b9cc;">
                        <div class="kpi-label" style="color:white">Cash</div>
                        <div class="kpi-value" style="font-weight:bolder;color:white">₹ @((Model?.Cash) ?? 0)</div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6 col-6">
                    <div class="kpi-card" style="background-color:#858796;">
                        <div class="kpi-label" style="color:white">Online</div>
                        <div class="kpi-value" style="font-weight:bolder;color:white">₹ @((Model?.Online) ?? 0)</div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-4 col-sm-6 col-6">
                    <div class="kpi-card" style="background-color:#e74a3b;">
                        <div class="kpi-label" style="color:white">Credit</div>
                        <div class="kpi-value" style="font-weight:bolder;color:white">₹ @((Model?.Credit) ?? 0)</div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <hr />
    <div class="row justify-content-center g-3">

        <!-- New Order -->
        <div class="dash-col mobile-col">
            <a asp-controller="Order" asp-action="Create" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3">
                        <i class="fas fa-cart-plus fa-2x text-primary mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">New Order</h6>
                    </div>
                </div>
            </a>
        </div>

        <!-- Products -->
        <div class="dash-col mobile-col">
            <a asp-controller="Product" asp-action="Index" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3">
                        <i class="fas fa-box-open fa-2x text-warning mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">Products</h6>
                    </div>
                </div>
            </a>
        </div>

        <!-- Order Report -->
        <div class="dash-col mobile-col">
            <a asp-controller="Order" asp-action="Report" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3">
                        <i class="fas fa-chart-line fa-2x text-success mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">Order Report</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Product Ledger -->
        <div class="dash-col mobile-col">
            <a asp-controller="ProductLedger" asp-action="Index" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3" style="background: firebrick">
                        <i class="fas fa-boxes-stacked fa-2x text-primary mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">Product Ledger</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Categories -->
        <div class="dash-col mobile-col">
            <a asp-controller="Category" asp-action="Index" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3">
                        <i class="fas fa-tags fa-2x text-danger mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">Categories</h6>
                    </div>
                </div>
            </a>
        </div>

        <!-- Users -->
        <div class="dash-col mobile-col">
            <a asp-controller="User" asp-action="UserList" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3">
                        <i class="fas fa-users fa-2x text-info mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">Users</h6>
                    </div>
                </div>
            </a>
        </div>

        <!-- Stock -->
        <div class="dash-col mobile-col">
            <a asp-controller="Stock" asp-action="Index" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3">
                        <i class="fas fa-warehouse fa-2x text-secondary mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">Product Stock</h6>
                    </div>
                </div>
            </a>
        </div>

        <!-- Settings -->
        <div class="dash-col mobile-col">
            <a asp-controller="Businesses" asp-action="Setting" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3">
                        <i class="fas fa-cogs fa-2x text-dark mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">Settings</h6>
                    </div>
                </div>
            </a>
        </div>

        @*  <!-- UOM -->
            <div class="dash-col mobile-col">
                <a asp-controller="UOM" asp-action="Index" class="text-decoration-none">
                    <div class="dashboard-card text-center shadow-sm border-0">
                        <div class="card-body p-3">
                            <i class="fas fa-ruler-combined fa-2x text-primary mb-2"></i>
                            <h6 class="fw-semibold text-dark mb-0">UOM</h6>
                        </div>
                    </div>
                </a>
            </div> *@
        <!-- Statistics / Graph -->
        <div class="dash-col mobile-col">
            <a asp-controller="Home" asp-action="Graph" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3">
                        <i class="fas fa-chart-bar fa-2x mb-2"></i>
                        <h6 class="fw-semibold mb-0">Statistics / Graph</h6>
                    </div>
                </div>
            </a>
        </div>


        <!-- GST -->
        <div class="dash-col mobile-col">
            <a asp-controller="GST" asp-action="Index" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3">
                        <i class="fas fa-file-invoice fa-2x text-primary mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">GST</h6>
                    </div>
                </div>
            </a>
        </div>


        <!-- Table/ Rooms -->
        <div class="dash-col mobile-col">
            <a asp-controller="Table" asp-action="Index" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3">
                        <i class="fas fa-th-large fa-2x text-primary mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">Tables / Rooms</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Feedback -->
        <div class="dash-col mobile-col">
            <a asp-controller="Feedback" asp-action="List" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3">
                        <i class="fas fa-comment-dots fa-2x text-primary mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">Feedback</h6>
                    </div>
                </div>
            </a>
        </div>


        <!-- Customer -->
        <div class="dash-col mobile-col">
            <a asp-controller="Customer" asp-action="Index" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3" style="background: maroon">
                        <i class="fas fa-chair fa-2x text-primary mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">Customer's</h6>
                    </div>
                </div>
            </a>
        </div>

        <!-- Vendor -->
        <div class="dash-col mobile-col">
            <a asp-controller="Vendor" asp-action="Index" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3" style="background: olive">
                        <i class="fas fa-store fa-2x text-primary mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">Vendor's</h6>
                    </div>
                </div>
            </a>
        </div>

        <!-- All Report -->
        <div class="dash-col mobile-col">
            <a asp-controller="Reports" asp-action="Index" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3" style="background: dimgray">
                        <i class="fas fa-chart-line fa-2x text-success mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">All Report</h6>
                    </div>
                </div>
            </a>
        </div>
        <!-- Kitchen Counter -->
        <div class="dash-col mobile-col">
            <a asp-controller="KitchenCounter" asp-action="Index" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3" style="background: darkcyan">
                        <i class="fas fa-kitchen-set fa-2x text-primary mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">Kitchen Counter</h6>
                    </div>
                </div>
            </a>
        </div>


        <!-- Logout -->
        <div class="dash-col mobile-col mb-5">
            <a asp-controller="Account" asp-action="Logout" class="text-decoration-none">
                <div class="dashboard-card text-center shadow-sm border-0">
                    <div class="card-body p-3" style="background: darkmagenta">
                        <i class="fas fa-sign-out-alt fa-2x text-danger mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-0">Logout</h6>
                    </div>
                </div>
            </a>
        </div>

    </div>

}

