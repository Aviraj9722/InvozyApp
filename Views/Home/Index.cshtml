<!--Enquiry Modal pop-up->
@{
    ViewData["Title"] = "Send Enquiry";
}

<section class="py-5 text-center">
    <div class="container">
        <h3 class="fw-bold text-dark">Send Enquiry for Purchasing Our Services</h3>
        <p class="text-muted mb-4">We will contact you within 24 hours.</p>

        <button id="btnOpenEnquiry" class="btn btn-outline-primary btn-lg px-5 shadow-sm"
                data-bs-toggle="modal" data-bs-target="#enquiryModal">
            Open Enquiry Form
        </button>
    </div>
</section>

<!-- ================= ENQUIRY MODAL ================= -->
<div class="modal fade" id="enquiryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">

            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Send Enquiry</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <form id="enquiryForm">

                    <div class="mb-2">
                        <label class="form-label">Name</label>
                        <input type="text" name="Name" class="form-control" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Email</label>
                        <input type="email" name="EmailId" class="form-control" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Mobile No</label>
                        <input type="text" name="MobileNo" class="form-control" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Business Type</label>
                        <select name="BusinessType" class="form-select" required>
                            <option value="">-- Select Business Type --</option>
                            @foreach (var item in ViewBag.BusinessTypes)
                            {
                                <option value="@item">@item</option>
                            }
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Number of Tables</label>
                        <input type="number" name="NoOfTables" class="form-control" min="0" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Comments</label>
                        <textarea name="Comments" class="form-control"></textarea>
                    </div>

                </form>

            </div>

            <div class="modal-footer">
                <button class="btn btn-success w-100" id="btnSubmitEnquiry">Submit</button>
            </div>

        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    $(document).ready(function () {

        $("#btnSubmitEnquiry").click(function (e) {
            e.preventDefault(); // stop browser default popup

            // Hide previous errors
            $(".error-text").remove();

            let isValid = true;

            let name = $("input[name='Name']").val().trim();
            let email = $("input[name='EmailId']").val().trim();
            let mobile = $("input[name='MobileNo']").val().trim();
            let businessType = $("select[name='BusinessType']").val();

            // ========== NAME VALIDATION ==========
            if (name.length < 2 || !/^[A-Za-z ]+$/.test(name)) {
                showError("input[name='Name']", "Please enter a valid name.");
                isValid = false;
            }

            // ========== EMAIL VALIDATION ==========
            let emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (!emailRegex.test(email)) {
                showError("input[name='EmailId']", "Please enter a valid email.");
                isValid = false;
            }

            // ========== MOBILE VALIDATION ==========
            if (!/^[0-9]{10}$/.test(mobile)) {
                showError("input[name='MobileNo']", "Enter a valid 10-digit mobile number.");
                isValid = false;
            }

            // ========== BUSINESS TYPE ==========
            if (businessType === "") {
                showError("select[name='BusinessType']", "Please select a business type.");
                isValid = false;
            }

            if (!isValid) return;

            // ========== SUBMIT AJAX ==========
            var formData = new FormData(document.getElementById("enquiryForm"));

            $.ajax({
                url: "/Enquiry/Submit",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    alert(res.message);
                    $("#enquiryForm")[0].reset();

                    let modal = bootstrap.Modal.getInstance(document.getElementById("enquiryModal"));
                    modal.hide();
                },
                error: function () {
                    alert("Error submitting enquiry.");
                }
            });
        });

        // Helper function : shows red text under field
        function showError(selector, message) {
            $(selector).after(`<small class="error-text text-danger">${message}</small>`);
        }
    });
</script>


<!-- ================= CUSTOM ANIMATION STYLES ================= -->
<style>
    /* ========== Animation Effects ========== */
    .animate-fade {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 1s ease forwards;
    }

    .animate-fade-delay {
        opacity: 0;
        transform: translateY(30px);
        animation: fadeInUp 1.2s ease forwards;
        animation-delay: 0.3s;
    }

    .animate-slide-up {
        opacity: 0;
        transform: translateY(50px);
        animation: fadeInUp 1s ease forwards;
    }

    .animate-bounce {
        animation: bounce 2s infinite;
    }

    @@keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(40px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100%

    {
        transform: translateY(0);
    }

    40% {
        transform: translateY(-8px);
    }

    60% {
        transform: translateY(-4px);
    }

    }

    /* ========== Hero Section Styling ========== */
    .hero-section {
        background: linear-gradient(135deg, #0078d7, #00a3ff);
        color: #fff;
        text-shadow: 0px 1px 3px rgba(0,0,0,0.2);
    }

    /* ========== Button Hover ========== */
    .btn-light:hover {
        background-color: #f8f9fa;
        transform: scale(1.05);
        transition: all 0.3s ease;
    }

    .btn-outline-primary:hover {
        background-color: #0078d7;
        color: #fff;
        transform: translateY(-2px);
        transition: all 0.3s ease;
    }

    /* ========== Section Spacing ========== */
    section {
        scroll-margin-top: 80px;
    }

    .testimonial-card {
        width: 18rem; /* same visual width as pricing cards */
        border: groove;
        border-radius: 12px;
        overflow: hidden;
        background: linear-gradient(180deg, rgba(255,255,255,1), rgba(250,250,250,1));
        /* subtle inner edge */
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        transition: transform .18s ease, box-shadow .18s ease;
        display: flex;
        align-items: stretch;
    }

        .testimonial-card .card-body {
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .testimonial-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.12);
        }

    .quote-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(13,110,253,0.08); /* subtle brand tint */
        color: #0d6efd;
        font-size: 18px;
        margin-bottom: 8px;
    }

    .testimonial-text {
        color: #333;
        line-height: 1.35;
        min-height: 3.3rem; /* keeps cards visually consistent when text length varies */
    }

    .testimonial-card .stars {
        color: #f6c85f; /* gold */
        font-weight: 600;
        letter-spacing: 1px;
        margin-bottom: 6px;
    }

    .testimonial-card h6 {
        font-size: 0.95rem;
        color: #0b2545;
    }

    .testimonial-card small {
        display: block;
        color: #6c757d;
    }

    /* Responsive — keep same compact cards, stack on small screens */
    @@media (max-width: 767.98px) {
        .testimonial-card {
            width: calc(50% - 1rem); /* two cards per row look on narrow screens */
            margin-bottom: 12px;
        }

        .d-flex.justify-content-center.gap-4.flex-wrap {
            gap: 12px;
        }
    }

    /* On very small phones, cards full width */
    @@media (max-width: 420px) {
        .testimonial-card {
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .hero-section .btn
    {
        margin-bottom: 12px; /* Adds spacing between buttons */
        display: block; /* Ensures buttons come one below another */
        width: 100%; /* Optional: makes UI look cleaner */
    }

    .hero-section a.btn,
    .hero-section button.btn {
        margin-bottom: 12px;
    }

    }

    .pricing-card {
        border-radius: 10px;
        transition: transform .2s;
    }

        .pricing-card:hover {
            transform: translateY(-5px);
        }

    /* Mobile view: one card under another */
    @@media (max-width: 768px) {
        .pricing-card
    {
        margin-bottom: 15px;
    }
    }

</style>
