<!-- ================= HERO SECTION ================= -->
<section class="hero-section text-center text-white d-flex align-items-center justify-content-center flex-column"
         style="background: url('/images/pos_billing.jpg') center center/cover no-repeat; min-height: 70vh; position: relative; padding-top: 60px; padding-bottom: 40px;">

    <!-- Overlay for better text visibility -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                background: rgba(0, 0, 0, 0.55); z-index: 1;"></div>

    <div class="container position-relative" style="z-index: 2;">
        <h1 class="display-5 fw-bold animate-fade">Welcome to <span class="text-info">Invozy</span></h1>
        <p class="lead mt-3 mb-4 animate-fade-delay">
            Smart Billing. Simplified. <br /> Empowering businesses with effortless invoicing and reports.
        </p>
        <a href="/Account/Login" class="btn btn-light btn-lg fw-semibold shadow-sm animate-bounce">
            Access Your Account
        </a>
    </div>
</section>

<style>
    /* ========== Responsive Hero Adjustments ========== */
    @@media (max-width: 768px) {
        .hero-section

    {
        min-height: 60vh; /* reduced height for mobile */
        padding-top: 40px;
        padding-bottom: 30px;
    }

    .hero-section h1 {
        font-size: 1.8rem; /* smaller heading */
    }

    .hero-section p {
        font-size: 1rem;
        line-height: 1.4;
    }

    .hero-section .btn {
        font-size: 1rem;
        padding: 10px 24px;
    }

    }

    @@media (max-width: 480px) {
        .hero-section

    {
        min-height: 55vh;
        padding-top: 30px;
    }

    .hero-section h1 {
        font-size: 1.6rem;
    }

    .hero-section p {
        font-size: 0.95rem;
    }

    }
</style>


<style>
