        </p>
    </div>
</section>

<!-- ================= CALL TO ACTION ================= -->
<section class="py-5 text-center">
    <div class="container animate-fade-delay">
        <h3 class="fw-bold text-dark">Start Smart Billing Today!</h3>
        <p class="text-muted mb-4">Join hundreds of happy businesses powered by Invozy.</p>
        <a href="/Account/Register" class="btn btn-outline-primary btn-lg px-5 shadow-sm">Sent enquiry for purchasing our Services</a>
    </div>
</section>

<!-- ================= CUSTOM ANIMATION STYLES ================= -->
<style>
    /* ========== Animation Effects ========== */
    .animate-fade {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 1s ease forwards;
    }

    .animate-fade-delay {
        opacity: 0;
        transform: translateY(30px);
        animation: fadeInUp 1.2s ease forwards;
        animation-delay: 0.3s;
    }

    .animate-slide-up {
        opacity: 0;
        transform: translateY(50px);
        animation: fadeInUp 1s ease forwards;
    }

    .animate-bounce {
        animation: bounce 2s infinite;
    }

    @@keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(40px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100%

    {
        transform: translateY(0);
    }

    40% {
        transform: translateY(-8px);
    }

    60% {
        transform: translateY(-4px);
    }

    }

    /* ========== Hero Section Styling ========== */
    .hero-section {
        background: linear-gradient(135deg, #0078d7, #00a3ff);
        color: #fff;
        text-shadow: 0px 1px 3px rgba(0,0,0,0.2);
    }

    /* ========== Button Hover ========== */
    .btn-light:hover {
        background-color: #f8f9fa;
        transform: scale(1.05);
        transition: all 0.3s ease;
    }

    .btn-outline-primary:hover {
        background-color: #0078d7;
        color: #fff;
        transform: translateY(-2px);
        transition: all 0.3s ease;
    }

    /* ========== Section Spacing ========== */
    section {
        scroll-margin-top: 80px;
    }
</style>
