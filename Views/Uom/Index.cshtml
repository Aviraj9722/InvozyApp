@{
    ViewData["Title"] = "Units of Measurement (UoM)";
}

<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    /* Keep DataTables UI consistent across all pages */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        display: flex !important;
        align-items: center !important;
        margin-bottom: 10px !important;
    }

        .dataTables_wrapper .dataTables_filter input {
            margin-left: 6px !important;
        }

    .dataTables_wrapper .dataTables_paginate {
        margin-top: 12px !important;
    }
</style>

<div class="container-fluid mt-3">
    <div class="row">

        <!-- LEFT FORM -->
        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h5>UoM List</h5>
                <h5>Add / Edit UoM</h5>

                <form id="uomForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="Id" value="0" />

                    <div class="mb-3">
                        <label class="form-label">Unit Name <span class="text-danger">*</span></label>
                        <input class="form-control" id="UnitName" required />
                        <div class="invalid-feedback">Unit name is required.</div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" id="btnSave" class="btn btn-primary">Save</button>
                        <button type="button" id="btnClear" class="btn btn-outline-secondary">Clear</button>
                    </div>

                    <div id="serverErrors" style="display:none;"></div>
                </form>
            </div>
        </div>

        <!-- RIGHT GRID -->
        <div class="col-md-8">
            <div class="card shadow-sm p-3">
                
                <table id="uomTable" class="table table-bordered table-striped w-100">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Unit Name</th>
                            <th style="width:140px">Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

            </div>
        </div>

    </div>
</div>

<!-- SCRIPTS -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {

        let table = $('#uomTable').DataTable({
            processing: true,
            serverSide: false,
            searching: true,
            paging: true,
            info: true,
            ajax: {
                url: "/Uom/GetPaged?page=1&pageSize=1000",
                dataSrc: "items"
            },
            columns: [
                {
                    data: null,
                    render: function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                },
                { data: "unitName" },
                {
                    data: "id",
                    render: function (id) {
                        return `
                            <button class="btn btn-sm btn-primary me-1" onclick="editUom(${id})">Edit</button>
                            <button class="btn btn-sm btn-danger" onclick="deleteUom(${id})">Delete</button>
                        `;
                    }
                }
            ]
        });

        // SAVE
        $('#btnSave').click(function () {
            if (!$('#UnitName').val().trim()) {
                $('#UnitName').addClass('is-invalid');
                return;
            }

            let fd = new FormData();
            fd.append("Id", $('#Id').val());
            fd.append("UnitName", $('#UnitName').val());
            fd.append("__RequestVerificationToken", $('input[name="__RequestVerificationToken"]').val());

            const url = $('#Id').val() == 0 ? "/Uom/Create" : "/Uom/Update";

            $.ajax({
                url: url,
                type: "POST",
                data: fd,
                contentType: false,
                processData: false
            }).done(function () {
                showToast("Saved", "success");
                clearForm();
                table.ajax.reload();
            }).fail(function (xhr) {
                handleError(xhr);
            });
        });

        $('#btnClear').click(clearForm);

    });

    // GLOBAL FUNCTIONS
    function editUom(id) {
        $.get(`/Uom/Get/${id}`, function (x) {
            $('#Id').val(x.id);
            $('#UnitName').val(x.unitName);
            $('html,body').animate({ scrollTop: 0 }, 300);
        });
    }

    function deleteUom(id) {
        if (!confirm("Delete this unit?")) return;
        $.post(`/Uom/Delete/${id}`, function () {
            showToast("Deleted", "warning");
            $('#uomTable').DataTable().ajax.reload();
        });
    }

    function clearForm() {
        $('#uomForm')[0].reset();
        $('#Id').val(0);
        $('#UnitName').removeClass("is-invalid");
    }

    function handleError(xhr) {
        showToast("Error occurred", "danger");
    }

    function showToast(msg, type) {
        alert(msg); // simple fallback; replace with your custom toast
    }
</script>
