@{
    ViewData["Title"] = "Units of Measurement (UoM)";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container-fluid mt-3">
    <div class="row">
        <!-- LEFT: Form -->
        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h5 class="mb-2">Add / Edit UoM</h5>

                <form id="uomForm" enctype="multipart/form-data" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="Id" name="Id" value="0" />

                  @*   <div class="mb-3">
                        <label class="form-label">Business <span class="text-danger">*</span></label>
                        <select id="BusinessId" name="BusinessId" class="form-select" required>
                            <option value="">-- Select business --</option>
                        </select>
                        <div class="invalid-feedback">Please select business.</div>
                    </div> *@

                    <div class="mb-3">
                        <label class="form-label">Unit Name <span class="text-danger">*</span></label>
                        <input type="text" id="UnitName" name="UnitName" class="form-control" required />
                        <div class="invalid-feedback">Unit name required.</div>
                    </div>

                    <div id="serverErrors" style="display:none;"></div>

                    <div class="d-grid gap-2">
                        <button type="button" id="btnSave" class="btn btn-primary">Save</button>
                        <button type="button" id="btnClear" class="btn btn-outline-secondary">Clear</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT: Grid -->
        <div class="col-md-8">
            <div class="card shadow-sm p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">UoM List</h5>
                    <div class="d-flex align-items-center">
                        <input id="searchText" class="form-control form-control-sm me-2" style="width:240px;" placeholder="Search unit name" />
                        <button id="btnSearch" class="btn btn-sm btn-primary me-2">Search</button>
                        <button id="btnReset" class="btn btn-sm btn-outline-secondary">Reset</button>
                    </div>
                </div>

                <div id="gridContainer"></div>

                <nav aria-label="Page navigation" class="mt-3">
                    <ul class="pagination justify-content-center" id="pager">
                        <li class="page-item" id="prevPage"><a class="page-link" href="#">&laquo; Prev</a></li>
                        <li class="page-item disabled"><span class="page-link">Page <span id="currentPage">1</span> of <span id="totalPages">1</span></span></li>
                        <li class="page-item" id="nextPage"><a class="page-link" href="#">Next &raquo;</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    (function () {
        let page = 1;
        const pageSize = 10;
        let totalPages = 1;

        $(function () {
          
            loadGrid();

            // events
          
            $('#btnSearch').on('click', function () { page = 1; loadGrid(); });
            $('#btnReset').on('click', function () { $('#searchText').val(''); page = 1; loadGrid(); });

            $('#prevPage').on('click', function (e) { e.preventDefault(); if (page > 1) { page--; loadGrid(); } });
            $('#nextPage').on('click', function (e) { e.preventDefault(); if (page < totalPages) { page++; loadGrid(); } });

            // Save
            $('#btnSave').on('click', function () {
                clearServerErrors();
                if (!validateForm()) return;

                var form = document.getElementById('uomForm');
                var fd = new FormData(form);

                // append antiforgery token if present
                var token = $('input[name="__RequestVerificationToken"]').val();
                if (token) fd.set('__RequestVerificationToken', token);

                // ensure id set as 0 if empty
                var id = $('#Id').val() || '0';
                var url = (id === '0' || id === '') ? '/Uom/Create' : '/Uom/Update';

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: fd,
                    contentType: false,
                    processData: false
                }).done(function () {
                    showToast('Saved', 'success');
                    clearForm();
                    loadGrid();
                }).fail(function (xhr) {
                    handleError(xhr);
                });
            });

            $('#btnClear').on('click', clearForm);
        });

      @{
        int   OrgId =  Convert.ToInt32(User.FindFirst("OrgId")?.Value);
      }

        // load grid
        function loadGrid() {
       
            const businessId =@OrgId;
            const search = $('#searchText').val() || '';

            if (!businessId || businessId == 0) {
                $('#gridContainer').html('<div class="alert alert-info">Please select a business to view UoM list.</div>');
                $('#currentPage').text(1); $('#totalPages').text(1);
                totalPages = 1;
                return;
            }

            $.get(`/Uom/GetPaged?page=${page}&pageSize=${pageSize}&search=${encodeURIComponent(search)}`)
                .done(function (resp) {
                    renderGrid(resp.items || []);
                    page = resp.page || 1;
                    totalPages = resp.totalPages || 1;
                    $('#currentPage').text(page);
                    $('#totalPages').text(totalPages);
                    $('#prevPage').toggleClass('disabled', page <= 1);
                    $('#nextPage').toggleClass('disabled', page >= totalPages);
                }).fail(function () { showToast('Failed to load list', 'danger'); });
        }

        function renderGrid(items) {
            let html = `<div class="table-responsive"><table class="table table-striped table-bordered mb-0"><thead class="table-dark"><tr>
                <th style="width:40px">#</th><th>Unit Name</th><th style="width:140px">Action</th></tr></thead><tbody>`;

            if (!items || items.length === 0) {
                html += '<tr><td colspan="3" class="text-center">No records found</td></tr>';
            } else {
                items.forEach(function (it, idx) {
                    html += `<tr>
                        <td>${((page-1)*pageSize)+idx+1}</td>
                        <td>${escapeHtml(it.unitName || '')}</td>
                        <td>
                            <button class="btn btn-sm btn-primary me-1" onclick="editUom(${it.id})">Edit</button>
                            <button class="btn btn-sm btn-danger" onclick="deleteUom(${it.id})">Delete</button>
                        </td>
                    </tr>`;
                });
            }

            html += '</tbody></table></div>';
            $('#gridContainer').html(html);
        }

        // edit & delete functions exposed globally for inline buttons
        window.editUom = function (id) {
            $.get(`/Uom/Get/${id}`).done(function (x) {
                if (!x) { showToast('Not found', 'warning'); return; }
                $('#Id').val(x.id || 0);
              
                $('#UnitName').val(x.unitName || '');
                // scroll to top form
                $('html,body').animate({ scrollTop: $('.card').first().offset().top - 20 }, 250);
            }).fail(function () { showToast('Load failed', 'danger'); });
        };

        window.deleteUom = function (id) {
            if (!confirm('Delete this unit?')) return;
            $.ajax({ url: `/Uom/Delete/${id}`, type: 'POST' })
                .done(function () { showToast('Deleted', 'warning'); loadGrid(); })
                .fail(function () { showToast('Delete failed', 'danger'); });
        };

        // validation
        function validateForm() {
            let ok = true;
         
            if (!$('#UnitName').val().trim()) { markInvalid('#UnitName'); ok = false; } else { markValid('#UnitName'); }
            if (!ok) showToast('Please fix validation errors', 'danger');
            return ok;
        }
        function markInvalid(s) { $(s).addClass('is-invalid').removeClass('is-valid'); }
        function markValid(s) { $(s).addClass('is-valid').removeClass('is-invalid'); }

        function clearForm() {
            $('#uomForm')[0].reset();
            $('#Id').val(0);
            $('#uomForm').find('.is-invalid').removeClass('is-invalid');
            $('#uomForm').find('.is-valid').removeClass('is-valid');
            clearServerErrors();
        }

        // ModelState error helpers
        function handleError(xhr) {
            if (xhr.status === 400) {
                try {
                    const data = JSON.parse(xhr.responseText);
                    if (Array.isArray(data)) { showServerErrors(data); return; }
                } catch (e) { /* ignore parse errors */ }
            }
            showToast('Operation failed', 'danger');
        }

        function showServerErrors(errors) {
            const container = $('#serverErrors');
            container.empty().show();
            errors.forEach(function (e) {
                const fld = (e.Field || '').split('.').pop();
                const messages = (e.Errors || []).join(' ');
                container.append(`<div class="alert alert-danger mb-1"><strong>${escapeHtml(fld)}</strong>: ${escapeHtml(messages)}</div>`);
                const selector = `#${fld}`;
                if ($(selector).length) {
                    markInvalid(selector);
                    $(selector).siblings('.server-help').remove();
                    $(selector).after(`<div class="server-help text-danger small">${escapeHtml(messages)}</div>`);
                }
            });
        }
        function clearServerErrors() { $('#serverErrors').hide().empty(); $('.server-help').remove(); }

        // helpers
        function escapeHtml(s) { return (s + '').replace(/[&"'<>]/g, function (a) { return { '&': '&amp;', '"': '&quot;', "'": '&#39;', '<': '&lt;', '>': '&gt;' }[a]; }); }
        function showToast(msg, type) {
            const bg = type === 'success' ? 'bg-success' : (type === 'danger' ? 'bg-danger' : (type === 'warning' ? 'bg-warning' : 'bg-info'));
            const t = $(`<div class="toast align-items-center text-white ${bg} border-0" role="alert"><div class="d-flex"><div class="toast-body">${escapeHtml(msg)}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>`);
            let container = $('#uomToastContainer'); if (!container.length) { container = $('<div id="uomToastContainer" class="position-fixed bottom-0 end-0 p-3" style="z-index:99999"></div>'); $('body').append(container); }
            container.append(t); const bs = new bootstrap.Toast(t[0], { delay: 2500 }); bs.show(); t.on('hidden.bs.toast', function () { $(this).remove(); });
        }
    })();
</script>
