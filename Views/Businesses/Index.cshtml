@model IEnumerable<eOrderTouchApp.Models.TblBusiness>

<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    
    /* Align "Show X entries" & Search box */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        display: flex;
        align-items: center;
        gap: 10px !important;
        margin-bottom: 12px !important; /* ⬅️ ADDED spacing under Search box */
    }

    /* Fix dropdown arrow + number overlap */
    .dataTables_length select {
        padding-right: 28px !important;
        padding-left: 6px !important;
        height: 32px;
    }

    .dataTables_wrapper .dataTables_filter input {
        margin-left: 6px !important;
    }

    /* Pagination gap consistency */
    .dataTables_wrapper .dataTables_paginate {
        margin-top: 12px !important;
    }

    .logo-delete {
        position: absolute;
        bottom: 0;
        right: 0;
        background: rgba(200,0,0,0.85);
        color: #fff;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        text-align: center;
        font-weight: bold;
        line-height: 16px;
        cursor: pointer;
        font-size: 12px;
    }


</style>

<div class="row mt-4">

    <!-- LEFT SIDE FORM (40%) -->
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h5 id="form-title">Add Business</h5>
            </div>

            <div class="card-body">
                <form id="businessForm" enctype="multipart/form-data">

                    <input type="hidden" id="Id" name="Id" />

                    <!-- Business Name -->
                    <div class="mb-3">
                        <label>Business Name</label>
                        <input type="text" id="BusinessName" name="BusinessName" class="form-control" required />
                        <span class="text-danger" id="err_BusinessName"></span>
                    </div>

                    <!-- Business Type -->
                    <div class="mb-3">
                        <label>Business Type</label>
                        <select id="BusinessTypeId" name="BusinessTypeId" class="form-control" required>
                            <option value="">-- Select --</option>

                            @foreach (var x in ViewBag.BusinessTypes)

                            {
                                <option value="@x.Id">@x.BusinessTypeName</option>

                            }
                        </select>
                        <span class="text-danger" id="err_BusinessType"></span>
                    </div>

                    <!-- Owner Name -->
                    <div class="mb-3">
                        <label>Owner Name</label>
                        <input type="text" id="OwnerName" name="OwnerName" class="form-control" required />
                        <span class="text-danger" id="err_OwnerName"></span>
                    </div>

                    <!-- GSTIN -->
                    <div class="mb-3">
                        <label>GSTIN</label>
                        <input type="text" id="GSTIN" name="GSTIN" class="form-control" />
                        <span class="text-danger" id="err_GSTIN"></span>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label>Email</label>
                        <input type="email" id="Email" name="Email" class="form-control" required />
                        <span class="text-danger" id="err_Email"></span>
                    </div>
                    <!-- Mobile -->
                    <div class="mb-3">
                        <label>Mobile No</label>
                        <input type="text" id="MobileNo" name="MobileNo" class="form-control" required />
                    </div>

                    <!-- Address -->
                    <div class="mb-3">
                        <label>Address</label>
                        <textarea id="Address" name="Address" class="form-control"></textarea>
                        <span class="text-danger" id="err_Address"></span>
                    </div>

                    <!-- City -->
                    <div class="mb-3">
                        <label>City</label>
                        <input type="text" id="City" name="City" class="form-control" />
                        <span class="text-danger" id="err_City"></span>
                    </div>

                    <!-- Printer Size -->
                    <div class="mb-3">
                        <label>Printer Size</label>
                        <select id="PrinterSizeId" name="PrinterSizeId" class="form-control">
                            <option value="">-- Select --</option>

                            @foreach (var x in ViewBag.PrinterSizes)
                            {
                                <option value="@x.Id">@x.PrinterSize</option>

                            }
                        </select>
                        <span class="text-danger" id="err_PrinterSize"></span>
                    </div>

                    <!-- GST Applicable -->
                    <div class="mb-3">
                        <label>GST Applicable?</label>
                        <select id="IsGSTApplicable" name="IsGSTApplicable" class="form-control">
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>

                    <!-- Hide Customer Field -->
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="HideCustomerField" name="HideCustomerField" />
                        <label class="form-check-label">Hide Customer Field</label>
                    </div>

                    <!-- Hide Table Dropdown -->
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="HideTableDropDown" name="HideTableDropDown" />
                        <label class="form-check-label">Hide Table Dropdown</label>
                    </div>

                    <!-- Enable KOT -->
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="IsKOTEnabled" name="IsKOTEnabled" />
                        <label class="form-check-label">Enable KOT</label>
                    </div>

                    <!-- IsCustomerMandetory  -->
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="IsCustomerMandetory" name="IsCustomerMandetory" />
                        <label class="form-check-label">Is Customer Mandatory?</label>
                    </div>

                    <!-- Barcode Enabled  -->
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="BarcodeEnabled" name="BarcodeEnabled" />
                        <label class="form-check-label">Barcode Enabled?</label>
                    </div>

                    <!-- Multilenguage Enabled  -->
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="IsMultilengual" name="IsMultilengual" />
                        <label class="form-check-label">Multilanguage Enabled ?</label>
                    </div>

                    <!-- IsTableNoRequired Enabled  -->
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="IsTableNoRequired" name="IsTableNoRequired" />
                        <label class="form-check-label">Is TableNo Required?</label>
                    </div>
                    <!-- Isreprint Enabled  -->
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="IsReceiptReprint" name="IsReceiptReprint" />
                        <label class="form-check-label">Is Receipt Reprint Required?</label>
                    </div>


                    <!-- Kichen Printer Name  -->
                    <div class="b-3">
                        <label class="form-label">Kichen Printer Name</label>
                        <input class="form-control" type="text" id="KichenPrinterName" name="KichenPrinterName" />
                     
                    </div>

                    <!-- Counter Printer Name  -->
                    <div class="mb-3">
                        <label class="form-label">Counter Printer Name</label>
                        <input class="form-control" type="text" id="CounterPrinterName" name="CounterPrinterName" />
                       
                    </div>

                    <!-- Logo Upload -->
                    <div class="mb-2">
                        <label class="form-label">Business Logo</label>
                        <input type="file"
                               id="LogoFile"
                               name="LogoFile"
                               class="form-control"
                               accept="image/png,image/jpeg"
                               onchange="validateLogoSize(this)">
                        @* <small class="text-muted">Max size: 100 KB (PNG/JPG)</small> *@
                
                    </div>

                    <!-- QR Code Upload -->
                    <div class="mb-3">
                        <label>UPI ID</label>
                        <input type="text" id="QRCode" name="QRCode" class="form-control" />
                       
                    </div>



                    <!-- Active -->
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" />
                        <label class="form-check-label">Is Active</label>

                    </div>

                    <button type="button" class="btn btn-success w-100" id="btnSave">Save</button>

                </form>
            </div>
        </div>
    </div>

    <!-- RIGHT SIDE GRID (60%) -->
    <div class="col-md-8">
        <div class="card-body" id="gridContainer" style="overflow-x:auto;">
            <table class="table table-bordered datatable" id="gridTable">
                <thead class="table-dark">
                    <tr>
                        <th width="140">Action</th>
                        <th>Logo</th>
                        <th>QR</th>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Business Type</th>
                        <th>Owner</th>
                        <th>City</th>
                        <th>Email</th>
                        <th>Mobile No</th>
                        <th>GSTN</th>
                        <th>Printer</th>

                        <th>Is GST?</th>
                        <th>KOT Enabled?</th>
                        <th>Customer Field</th>
                        <th>Hide Table LOV</th>
                         <th>Barcode?</th>
                        <th>Multilanguage?</th>
                        <th>Customer?</th>
                        <th>Counter Printer</th>
                        <th>Kichen Printer</th>
                        <th>TableNo Required?</th>
                        <th>Receipt Reprint</th>
                        <th>Active</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-primary" onclick="editRecord(@item.Id)">Edit</button>
                                    <button class="btn btn-sm btn-danger" onclick="deleteRecord(@item.Id)">Delete</button>
                                    @Html.ActionLink("Users", "Index", "user", new { OrgId = item.Id }, new { @class = "btn btn-sm btn-info" })
                                    @Html.ActionLink("Licenses", "Index", "UserLicense", new { OrgId = item.Id }, new { @class = "btn btn-sm btn-success" })
                                </div>

                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Logo))
                                {
                                    <div class="logo-wrapper" style="position:relative; display:inline-block;">
                                        <img src="~/Uploads/@item.Logo" width="50" height="50" style="object-fit:cover;">
                                        <span class="logo-delete" onclick="deleteLogo(@item.Id)">×</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">No Logo</span>
                                }
                            </td>
                            <td>@item.Qrcode</td>
                            <td>@item.Id</td>
                            <td>@item.BusinessName</td>
                            <td>@item.BusinessType?.BusinessTypeName</td>
                            <td>@item.OwnerName</td>
                            <td>@item.City</td>
                            <td>@item.Email</td>
                            <td>@item.MobileNo</td>
                            <td>@item.Gstin</td>
                            <td>@item.PrinterSize?.PrinterSize</td>

                            <td>@item.IsGstapplicable</td>
                            <td>@item.IsKOTEnabled</td>
                            <td>@item.HideCustomerField</td>
                            <td>@item.HideTableDropDown</td>
                          
                            <td>@item.BarcodeEnabled</td>
                            <td>@item.IsMultilengual</td>
                            <td>@item.IsCustomerMandetory</td>
                            <td>@item.CounterPrinterName</td>
                            <td>@item.KichenPrinterName</td>
                            <td>@item.IsTableNoRequired</td>
                            <td>@item.IsReceiptReprint</td>
                            <td>@(item.IsActive == true ? "Yes" : "No")</td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>
    </div>

</div>


@section Scripts {

   @*  <script>
        function validateLogoSize(input) {
            if (input.files.length === 0) return;

            const file = input.files[0];
            const maxSize = 100 * 1024; // 100 KB

            if (file.size > maxSize) {
                alert("Logo size must be less than 100 KB");
                input.value = ""; // reset
            }
        }
    </script> *@
    <script>
         $(document).ready(function () {

            if (!$.fn.DataTable.isDataTable("#gridTable")) {

                $("#gridTable").DataTable({
                    pageLength: 10,
                    lengthMenu: [5, 10, 25, 50],
                    responsive: true,
                    ordering: true,
                    searching: true,
                });
            }
        });

        // FORM VALIDATION
        // function validateForm() {
        //     if ($("#BusinessName").val().trim() === "") { alert("Business Name required"); return false; }
        //     if ($("#OwnerName").val().trim() === "") { alert("Owner Name required"); return false; }
        //     if ($("#Email").val().trim() === "") { alert("Email required"); return false; }
        //     return true;
        // }

         function loadGrid(page = 1) {
             $("#gridContainer").load("/Businesses/Index?page=" + page + " #gridTable");
        }

                // REAL-TIME REMOVE ERROR
        $("input, textarea, select").on("input change", function () {
             $(this).removeClass("invalid-input");
             let errSpan = "#err_" + $(this).attr("id");
             $(errSpan).text("");
        });


        // ==========================
        //     VALIDATION FUNCTION
        // ==========================
        function validateForm() {
              debugger;
             let isValid = true;
             $(".text-danger").text("");
           
             // Business Name
             if ($("#BusinessName").val().trim() === "") {
                 $("#err_BusinessName").text("Business Name is required");
                 $("#BusinessName").addClass("invalid-input");
                 isValid = false;
             }

             // Owner Name
             if ($("#OwnerName").val().trim() === "") {
                 $("#err_OwnerName").text("Owner Name is required");
                 $("#OwnerName").addClass("invalid-input");
                 isValid = false;
             }

             // Email
             let email = $("#Email").val().trim();
             let emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

             if (email === "") {
                 $("#err_Email").text("Email is required");
                 $("#Email").addClass("invalid-input");
                 isValid = false;
             }
             else if (!emailPattern.test(email)) {
                 $("#err_Email").text("Invalid email format");
                 $("#Email").addClass("invalid-input");
                 isValid = false;
             }

             // Mobile Validation
             // let mobile = $("#MobileNo").val().trim();
             // let mobilePattern = /^[0-9]{10}$/;

             // if (mobile === "") {
             //     $("#err_Mobile").text("Mobile number is required");
             //     $("#MobileNo").addClass("invalid-input");
             //     isValid = false;
             // }
             // else if (!mobilePattern.test(mobile)) {
             //     $("#err_Mobile").text("Mobile number must be 10 digits");
             //     $("#MobileNo").addClass("invalid-input");
             //     isValid = false;
             // }

             // // GSTIN Validation
             // let gst = $("#GSTIN").val().trim();
             // let gstPattern = /^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$/;

             // if (gst !== "" && !gstPattern.test(gst)) {
             //     $("#err_GSTIN").text("Invalid GSTIN");
             //     $("#GSTIN").addClass("invalid-input");
             //     isValid = false;
             // }

             // Business Type
             if ($("#BusinessTypeId").val() === "") {
                 $("#err_BusinessType").text("Select Business Type");
                 $("#BusinessTypeId").addClass("invalid-input");
                 isValid = false;
             }

             // Printer Size
             if ($("#PrinterSizeId").val() === "") {
                 $("#err_PrinterSize").text("Select Printer Size");
                 $("#PrinterSizeId").addClass("invalid-input");
                 isValid = false;
             }

             // Address
             if ($("#Address").val().trim() === "") {
                 $("#err_Address").text("Address is required");
                 $("#Address").addClass("invalid-input");
                 isValid = false;
             }

             // City
             if ($("#City").val().trim() === "") {
                 $("#err_City").text("City is required");
                 $("#City").addClass("invalid-input");
                 isValid = false;
             }

             return isValid;
        }

        // SAVE / UPDATE
        $("#btnSave").click(function () {

            if (!validateForm()) return;

            var formData = new FormData(document.getElementById("businessForm"));

            var url = ($("#Id").val() == "" || $("#Id").val() == "0")
                ? "/Businesses/Create"
                : "/Businesses/Update";
                debugger;
            formData.set("IsActive", $("#IsActive").is(":checked"));
            formData.set("HideCustomerField", $("#HideCustomerField").is(":checked"));
            formData.set("HideTableDropDown", $("#HideTableDropDown").is(":checked"));
             formData.set("IsKOTEnabled", $("#IsKOTEnabled").is(":checked"));

              formData.set("IsCustomerMandetory", $("#IsCustomerMandetory").is(":checked"));
               formData.set("BarcodeEnabled", $("#BarcodeEnabled").is(":checked"));
                 formData.set("IsMultilengual", $("#IsMultilengual").is(":checked"));
                   formData.set("IsTableNoRequired", $("#IsTableNoRequired").is(":checked"));
              formData.set("IsReceiptReprint", $("#IsReceiptReprint").is(":checked"));

           // formData.set("IsGstapplicable", $("#IsGstapplicable").is(":checked"));
            $.ajax({
                url: url,
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                success: function () {
                    loadGrid();
                    clearForm();
                }
            });
        });


        // EDIT
        function editRecord(id) {

            $.get("/Businesses/Edit/" + id, function (data) {
                debugger;
                $("#Id").val(data.id);
                $("#BusinessName").val(data.businessName);
                $("#OwnerName").val(data.ownerName);
                $("#City").val(data.city);
                $("#Email").val(data.email);
                $("#Address").val(data.address);
                $("#GSTIN").val(data.gstin);
                $("#IsActive").prop('checked', data.isActive);
                $("#MobileNo").val(data.mobileNo);
                $("#form-title").text("Edit Business");

                $("#BusinessTypeId").val(data.businessTypeId);
                $("#PrinterSizeId").val(data.printerSizeId);
                $("#IsGSTApplicable").val(data.isGstApplicable?.toString());

                $("#HideCustomerField").prop('checked', data.hideCustomerField);
                $("#HideTableDropDown").prop('checked', data.hideTableDropDown);

                $("#IsKOTEnabled").prop('checked', data.isKOTEnabled);

                $("#IsCustomerMandetory").prop('checked', data.isCustomerMandetory);
                $("#BarcodeEnabled").prop('checked', data.barcodeEnabled);
                   $("#IsMultilengual").prop('checked', data.isMultilengual);
                     $("#IsTableNoRequired").prop('checked', data.isTableNoRequired);
                  $("#IsReceiptReprint").prop('checked', data.isReceiptReprint);

                $("#KichenPrinterName").val(data.kichenPrinterName);
                $("#CounterPrinterName").val(data.counterPrinterName);
                $("#QRCode").val(data.qrCode);
                        
                $("#btnSave").text("Update");
            });
        }

        function deleteLogo(id) {
            if (!confirm("Delete business logo?")) return;

            $.post("/Businesses/DeleteLogo", { id: id })
                .done(res => {
                    alert("Logo deleted");
                    location.reload();
                })
                .fail(err => {
                    alert("Error deleting logo");
                });
        }
        // DELETE
        function deleteRecord(id) {
            if (confirm("Are you sure?")) {
                $.post("/Businesses/Delete", { id: id }, function () {
                    loadGrid();
                });
            }
        }

        // CLEAR FORM
        function clearForm() {
            $("#businessForm")[0].reset();
            $("#Id").val("");
             $("#MobileNo").val("");
            $("#form-title").text("Add Business");
            $("#btnSave").text("Save");
            $("#PreviewLogo").attr("src", "");
          

            $("#IsActive").prop("checked",false);
            $("#HideCustomerField").prop("checked",false);
            $("#HideTableDropDown").prop("checked",false);
              $("#IsMultilengual").prop("checked",false);
            $("#IsCustomerMandetory").prop("checked",false);
            $("#BarcodeEnabled").prop("checked",false);
            $("#KichenPrinterName").val("");
            $("#CounterPrinterName").val("");
              $("#IsTableNoRequired").prop("checked",false);
            $("#IsReceiptReprint").prop("checked",false);
        }

    </script>

}