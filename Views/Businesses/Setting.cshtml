@model eOrderTouchApp.Models.TblBusiness

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow p-3">

                <div class="card-header bg-primary text-white text-center">
                    <h5 class="mb-0" id="form-title">Business Settings</h5>
                </div>

                <div class="card-body">

                    <form id="SaveSettings" asp-action="SaveSettings" asp-controller="Businesses" method="post" enctype="multipart/form-data">

                        <input type="hidden" asp-for="Id" />

                        <!-- Business Name -->
                        <div class="mb-3">
                            <label class="fw-semibold">Business Name</label>
                            <input asp-for="BusinessName" class="form-control" />
                            <span asp-validation-for="BusinessName" class="text-danger"></span>
                        </div>

                        <!-- Business Type -->
                        <div class="mb-3">
                            <label class="fw-semibold">Business Type</label>

                            @Html.DropDownListFor(
                            model => model.BusinessTypeId,
                                                        new SelectList(ViewBag.BusinessTypes, "Id", "BusinessTypeName"),
                                                        "-- Select --",
                                                        new { @class = "form-control" }
                                                        )

                            <span asp-validation-for="BusinessTypeId" class="text-danger"></span>
                        </div>

                        <!-- Owner Name -->
                        <div class="mb-3">
                            <label class="fw-semibold">Owner Name</label>
                            <input asp-for="OwnerName" class="form-control" />
                            <span asp-validation-for="OwnerName" class="text-danger"></span>
                        </div>

                        <!-- GSTIN -->
                        <div class="mb-3">
                            <label class="fw-semibold">GSTIN</label>
                            <input asp-for="Gstin" class="form-control" />
                            <span asp-validation-for="Gstin" class="text-danger"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label class="fw-semibold">Email</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <!-- Mobile -->
                        <div class="mb-3">
                            <label class="fw-semibold">Mobile No</label>
                            <input asp-for="MobileNo" class="form-control" />
                            <span asp-validation-for="MobileNo" class="text-danger"></span>
                        </div>

                        <!-- Address -->
                        <div class="mb-3">
                            <label class="fw-semibold">Address</label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <!-- City -->
                        <div class="mb-3">
                            <label class="fw-semibold">City</label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        @* <!-- Printer Size -->
                        <div class="mb-3">
                            <label class="fw-semibold">Printer Size</label>

                            @Html.DropDownListFor(
                                                        model => model.PrinterSizeId,
                                                        new SelectList(ViewBag.PrinterSizes, "Id", "PrinterSize"),
                                                        "-- Select --",
                                                        new { @class = "form-control" }
                                                        )

                            <span asp-validation-for="PrinterSizeId" class="text-danger"></span>
                        </div> *@

                       @*  <!-- GST Applicable -->
                        <div class="mb-3">
                            <label class="fw-semibold">GST Applicable?</label>

                            @Html.DropDownListFor(
                                                        model => model.IsGstapplicable,
                                                        new SelectList(ViewBag.YesNo, "key", "value"),
                                                        "-- Select --",
                                                        new { @class = "form-control" }
                                                        )

                            <span asp-validation-for="IsGstapplicable" class="text-danger"></span>
                        </div> *@

                        <!-- Hide Customer Field -->
                        <div class="mb-3">
                            <label class="fw-semibold">Hide Customer Field?</label>

                            @Html.DropDownListFor(
                                                        model => model.HideCustomerField,
                                                        new SelectList(ViewBag.YesNo, "key", "value"),
                                                        new { @class = "form-control" }
                                                        )

                            <span asp-validation-for="HideCustomerField" class="text-danger"></span>
                        </div>

                        <!-- Hide Table Dropdown -->
                        <div class="mb-3">
                            <label class="fw-semibold">Hide Table Dropdown?</label>

                            @Html.DropDownListFor(
                                                        model => model.HideTableDropDown,
                                                        new SelectList(ViewBag.YesNo, "key", "value"),
                                                        new { @class = "form-control" }
                                                        )

                            <span asp-validation-for="HideTableDropDown" class="text-danger"></span>
                        </div>

                        <!-- UPI ID -->
                        <div class="mb-3">
                            <label class="fw-semibold">UPI ID</label>
                            <input asp-for="Qrcode" class="form-control" />
                        </div>

                        <!-- Report Data -->
                        <div class="mb-3">
                            <label class="fw-semibold">Report Data (Bank & Payment Details)</label>
                            <textarea asp-for="ReportData" class="form-control" rows="3"
                                      placeholder="Enter bank name, account no, IFSC, UPI etc..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-success w-100 mt-2" id="btnSave">Save</button>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
