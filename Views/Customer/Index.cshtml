@model IEnumerable<eOrderTouchApp.Models.TblCustomer>

<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    /* Keep DataTables UI consistent across all pages */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        display: flex;
        align-items: center;
        gap: 10px !important;
    }

    .dataTables_length select {
        padding-right: 28px !important;
        padding-left: 6px !important;
        height: 32px;
    }

    .dataTables_wrapper .dataTables_paginate {
        margin-top: 12px !important;
    }
</style>

<div class="container-fluid mt-3">
    <div class="row">

        <!-- LEFT FORM -->
        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h5 id="formTitle">Add / Edit Customer</h5>

                <form id="customerForm" novalidate>
                    <input type="hidden" id="customerId" value="0" />

                    <div class="mb-3">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" id="customerName" class="form-control" required />
                        <span class="text-danger" id="err_Name"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mobile No</label>
                        <input type="text" id="mobileNo" class="form-control" />
                        <span class="text-danger" id="err_mobileNo"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="text" id="emailId" class="form-control" />
                        <span class="text-danger" id="err_emailId"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">GSTN</label>
                        <input type="text" id="gstn" class="form-control" />
                        <span class="text-danger" id="err_gstn"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <textarea id="address" class="form-control"></textarea>
                        <span class="text-danger" id="err_address"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <input type="text" id="location" class="form-control" />
                        <span class="text-danger" id="err_location"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" id="btnSave" class="btn btn-primary">Save</button>
                        <button type="button" id="btnClear" class="btn btn-outline-secondary">Clear</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT TABLE -->
        <div class="col-md-8">
            <div class="card shadow-sm p-3">

                <table id="customerTable" class="table table-bordered table-striped w-100">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Mobile</th>
                            <th>Email</th>
                            <th>GSTN</th>
                            <th>Location</th>
                            <th style="width:140px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td>@c.Id</td>
                                <td>@c.Name</td>
                                <td>@c.MobileNo</td>
                                <td>@c.EmailId</td>
                                <td>@c.GSTN</td>
                                <td>@c.Location</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-primary editBtn" data-id="@c.Id">Edit</button>
                                        <button class="btn btn-sm btn-danger deleteBtn" data-id="@c.Id">Delete</button>
                                    </div>
                                </td>
                                
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>

    </div>
</div>


@section Scripts {

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {

            let table = $("#customerTable").DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                responsive: true,
                ordering: true,
                searching: true,
                columnDefs: [{
                    targets: 0,
                    searchable: false,
                    orderable: false,
                    render: function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                }]
            });

            function validateCustomerForm() {

                let isValid = true;

                $(".form-control").removeClass("invalid-input");
                $(".text-danger").text("");

                // Name
                if ($("#customerName").val().trim() === "") {
                    $("#err_Name").text("Customer name is required");
                    $("#customerName").addClass("invalid-input");
                    isValid = false;
                }

                // Email
                let email = $("#emailId").val().trim();
                let emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

                if (email === "") {
                    $("#err_emailId").text("Email is required");
                    $("#emailId").addClass("invalid-input");
                    isValid = false;
                } else if (!emailPattern.test(email)) {
                    $("#err_emailId").text("Invalid email format");
                    $("#emailId").addClass("invalid-input");
                    isValid = false;
                }

                // Mobile
                let mobile = $("#mobileNo").val().trim();
                let mobilePattern = /^[0-9]{10}$/;

                if (mobile === "") {
                    $("#err_mobileNo").text("Mobile number is required");
                    $("#mobileNo").addClass("invalid-input");
                    isValid = false;
                } else if (!mobilePattern.test(mobile)) {
                    $("#err_mobileNo").text("Mobile number must be 10 digits");
                    $("#mobileNo").addClass("invalid-input");
                    isValid = false;
                }

                // GSTN
                if ($("#gstn").val().trim() === "") {
                    $("#err_gstn").text("GSTN is required");
                    $("#gstn").addClass("invalid-input");
                    isValid = false;
                }

                // Address
                if ($("#address").val().trim() === "") {
                    $("#err_address").text("Address is required");
                    $("#address").addClass("invalid-input");
                    isValid = false;
                }

                // Location
                if ($("#location").val().trim() === "") {
                    $("#err_location").text("Location is required");
                    $("#location").addClass("invalid-input");
                    isValid = false;
                }

                return isValid;
            }


            // SAVE CUSTOMER
            $('#btnSave').click(function () {

               if (!validateCustomerForm()) return;

                let customer = {
                    Id: $('#customerId').val() || 0,
                    Name: $('#customerName').val(),
                    MobileNo: $('#mobileNo').val(),
                    EmailId: $('#emailId').val(),
                    GSTN: $('#gstn').val(),
                    Address: $('#address').val(),
                    Location: $('#location').val()
                };

                let url = customer.Id == 0 ? '/Customer/Create' : '/Customer/Edit';

                $.ajax({
                    url: url,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(customer),
                    success: function (res) {
                        if (res.success) {
                            location.reload();
                        } else {
                            alert(res.message || "Error occurred");
                        }
                    }
                });
            });

            // EDIT CUSTOMER (delegated event — works on pagination ✅)
            $('#customerTable').on('click', '.editCustomer', function () {
                let row = $(this).closest('tr');

                $('#formTitle').text("Edit Customer");

                $('#customerId').val(row.data('id'));
                $('#customerName').val(row.data('name'));
                $('#mobileNo').val(row.data('mobile'));
                $('#emailId').val(row.data('email'));
                $('#gstn').val(row.data('gstn'));
                $('#address').val(row.data('address'));
                $('#location').val(row.data('location'));
            });

            // DELETE CUSTOMER (delegated ✅)
            $('#customerTable').on('click', '.deleteCustomer', function () {

                if (!confirm("Are you sure you want to delete this customer?")) return;

                let id = $(this).closest('tr').data('id');

                $.post('/Customer/Delete', { id: id }, function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert("Error deleting customer");
                    }
                });
            });

            // CLEAR FORM
            $('#btnClear').click(function () {
                $('#customerForm')[0].reset();
                $('#customerId').val(0);
                $('#formTitle').text("Add / Edit Customer");
                $('#customerName').removeClass("is-invalid");
            });

        });
    </script>

}
