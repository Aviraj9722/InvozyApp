<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]  Invozy</title>
    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/eOrderTouchApp.styles.css" asp-append-version="true" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.1/css/jquery.dataTables.min.css" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0078d7">

    <!-- For Android -->
    <meta name="mobile-web-app-capable" content="yes">

    <!-- For iOS -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="apple-touch-icon" href="/icons/logo.png">


</head>
<body>

    @if (ViewBag.HideNav == null || ViewBag.HideNav == false)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Invozy</a>

                    <button class="navbar-toggler d-lg-none" type="button" onclick="toggleMobileMenu()">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">

                                @if (User.IsInRole("Admin"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Businesses" asp-action="Index">Businesses</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Dealer" asp-action="Index">Dealers</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Enquiry" asp-action="AdminList">Enquiries</a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Dealer" asp-action="Index">Dealers</a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="HeadOffice" asp-action="Index">HO Users</a>
                                    </li>

                                    <li class="nav-item d-flex align-items-center bg-info text-dark px-3 rounded">
                                        <span class="me-2">Hello, @User.Identity.Name</span>
                                        <span class="me-2">|</span>
                                        <a class="nav-link p-0 text-dark" asp-controller="Account" asp-action="Logout">Logout</a>
                                    </li>
                                }

                                else if (User.IsInRole("HeadOfficer"))
                                {
                                    <!-- HEAD OFFICER MENUS -->

                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="HOActivity" asp-action="Dashboard">
                                            Dashboard
                                        </a>
                                    </li>


                                    <li class="nav-item d-flex align-items-center bg-info text-dark px-3 rounded">
                                        <span class="me-2">Hello, @User.Identity.Name</span>
                                        <span class="me-2">|</span>
                                        <a class="nav-link p-0 text-dark" asp-controller="Account" asp-action="Logout">
                                            Logout
                                        </a>
                                    </li>
                                }


                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Dashboard">Home</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Order" asp-action="Create">NewOrder</a>
                                    </li>
                                @*     <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Order" asp-action="Report">Order Summary</a>
                                    </li> *@
                                   @*  <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="User" asp-action="Index">Users</a>
                                    </li> *@
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Graph">Graphs</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Category" asp-action="Index">Categories</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Product" asp-action="Index">Products</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Vendor" asp-action="Index">Vendors</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Customer" asp-action="Index">Customers</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="GST" asp-action="Index">GSTs</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Table" asp-action="Index">Tables</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Reports" asp-action="Index">Reports</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Feedback" asp-action="List">Feedback</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="KitchenCounter" asp-action="Index">KitchenCounter</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="ProductLedger" asp-action="Index">ProductLedger</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-controller="Businesses" asp-action="Setting">Settings</a>
                                    </li>

                                    <li class="nav-item d-flex align-items-center bg-info text-dark px-3 rounded">
                                        <span class="me-2">Hello, @User.Identity.Name</span>
                                        <span class="me-2">|</span>
                                        <a class="nav-link p-0 text-dark" asp-controller="Account" asp-action="Logout">Logout</a>
                                    </li>
                                }
          
                                
                                
                                
                                
                            
                            
                            </ul>
                        </div>
                    }
                </div>
            </nav>
        </header>
        <!-- MOBILE SIDEBAR MENU (ONLY MOBILE) -->
        <div id="mobileSidebar" class="mobile-sidebar d-lg-none">

            <div class="mobile-sidebar-header">
                <h5>Invozy</h5>
                <button onclick="toggleMobileMenu()">✕</button>
            </div>

            <ul class="mobile-menu">
                <li><a asp-controller="Home" asp-action="Dashboard">Home</a></li>
                <li><a asp-controller="Order" asp-action="Create">New Order</a></li>
                <li><a asp-controller="Home" asp-action="Graph">Graphs</a></li>
                <li><a asp-controller="Category" asp-action="Index">Categories</a></li>
                <li><a asp-controller="Product" asp-action="Index">Products</a></li>
                <li><a asp-controller="Vendor" asp-action="Index">Vendors</a></li>
                <li><a asp-controller="Customer" asp-action="Index">Customers</a></li>
                <li><a asp-controller="GST" asp-action="Index">GSTs</a></li>
                <li><a asp-controller="Table" asp-action="Index">Tables</a></li>
                <li><a asp-controller="Reports" asp-action="Index">Reports</a></li>
                <li><a asp-controller="Feedback" asp-action="List">Feedback</a></li>
                <li><a asp-controller="KitchenCounter" asp-action="Index">KitchenCounter</a></li>
                <li><a asp-controller="ProductLedger" asp-action="Index">ProductLedger</a></li>
                <li><a asp-controller="Businesses" asp-action="Setting">Settings</a></li>

                <li class="logout">
                    <a asp-controller="Account" asp-action="Logout">
                        Hello, @User.Identity.Name | Logout
                    </a>
                </li>
            </ul>
        </div>

    }

    <div class="container-fluid">
        <main role="main" >
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted" style="z-index:-1">
        <div class="container">
            <br />
            &copy; 2025. Aviraj Innovations Pvt. Ltd.<br />
        </div>
    </footer>

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- html2canvas + jsPDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function toggleMobileMenu() {
            document.getElementById("mobileSidebar")
                .classList.toggle("active");
        }
    </script>
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/service-worker.js')
                .then(() => console.log("Service Worker registered"))
                .catch(err => console.log("Service Worker registration failed:", err));
        }
    </script>
</body>
</html>
