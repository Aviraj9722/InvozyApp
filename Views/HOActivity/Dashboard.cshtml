@using eOrderTouchApp.ViewModel
@{
    ViewData["Title"] = "Head Office Dashboard";
}
@model HODashboardVM
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    footer {
        display: none;
    }

    .dashboard-card {
        border-radius: 0;
        background: #1e1e1e;
        transition: all 0.25s ease-in-out;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.25);
    }
    /* ===== ACTION TILES ONLY ===== */
    .action-tile {
        height: 160px; /* same visual height as branch cards */
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .action-tile .card-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .action-tile i {
            font-size: 36px;
            margin-bottom: 10px;
        }

    .dashboard-card,
    .dashboard-card h6,
    .dashboard-card h5,
    .dashboard-card h4,
    .dashboard-card p,
    .dashboard-card small,
    .dashboard-card strong {
        color: #ffffff !important;
    }

        .dashboard-card .text-success {
            color: #2ecc71 !important;
        }

        .dashboard-card .text-danger {
            color: #e74c3c !important;
        }
    /* ===== HO DASHBOARD CARD COLORS ===== */
    /* ===== HO DASHBOARD CARD COLORS (IMPROVED) ===== */
    .dash-col:nth-child(1) .dashboard-card {
        background: linear-gradient(135deg, #34495e, #2c3e50);
    }

    .dash-col:nth-child(2) .dashboard-card {
        background: linear-gradient(135deg, #2980b9, #1f4b99);
    }

    .dash-col:nth-child(3) .dashboard-card {
        background: linear-gradient(135deg, #8e44ad, #6a1b9a);
    }

    .dash-col:nth-child(4) .dashboard-card {
        background: linear-gradient(135deg, #00695c, #004d40);
    }

    .dash-col:nth-child(5) .dashboard-card {
        background: linear-gradient(135deg, #2e7d32, #1b5e20);
    }

    .dash-col:nth-child(6) .dashboard-card {
        background: linear-gradient(135deg, #ad1457, #880e4f);
    }


    .dashboard-card:hover {
        transform: scale(1.03);
    }

    .dashboard-card i,
    .dashboard-card h6 {
        color: #ffffff !important;
    }

    .dash-col {
        width: 33.33%;
        max-width: 33.33%;
        padding: 5px;
    }

    @@media (max-width: 768px) {
        .dash-col {
            width: 50%;
            max-width: 50%;
        }

        .action-tile {
            height: 135px;
        }
    }
</style>


<div class="container-fluid py-4">
    <h3 class="text-center fw-bold text-primary mb-4">
        Head Office Dashboard
    </h3>

    <div class="row justify-content-center g-3">

        <!-- ===== HO SUMMARY ===== -->
        <div class="row mb-4">
            <div class="col-md-6 mb-2">
                <div class="dashboard-card text-center p-3" style="background:#27ae60">
                    <h6>Today's Sale</h6>
                    <h4>₹ @Model.TotalSale</h4>
                </div>
            </div>

            <div class="col-md-6 mb-2">
                <div class="dashboard-card text-center p-3" style="background:#f39c12">
                    <h6>Today's Profit</h6>
                    <h4>₹ @Model.TotalProfit</h4>
                </div>
            </div>
        </div>

        <!-- ===== BRANCH SALE / PROFIT ===== -->
        <div class="row justify-content-center g-3 mb-4">

            @foreach (var branch in Model.Branches)
            {
                <div class="dash-col">
                    <div class="dashboard-card text-center p-3">
                        <h6 class="fw-bold mb-1">@branch.BranchName</h6>
                        <small>@branch.Location</small>

                        <hr class="opacity-50" />

                        <p class="mb-1">
                            Today Sale:
                            <strong>₹ @branch.TotalSale</strong>
                        </p>

                        <p class="mb-0">
                            Today Profit:
                            <strong class="@(branch.Profit >= 0 ? "text-success" : "text-danger")">
                                ₹ @branch.Profit
                            </strong>
                        </p>
                    </div>
                </div>
            }
        </div>


        <div class="row justify-content-center g-3">

            <!-- Branch Stock -->
            <div class="dash-col mobile-col">
                <a asp-controller="Stock" asp-action="Index" class="text-decoration-none">
                    <div class="dashboard-card text-center action-tile shadow-sm border-0">
                        <div class="card-body p-3">
                            <i class="fas fa-warehouse fa-2x mb-2"></i>
                            <h6 class="fw-semibold mb-0">Branch Stock</h6>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Branch Reports -->
            <div class="dash-col mobile-col">
                <a asp-controller="Reports" asp-action="Index" class="text-decoration-none">
                    <div class="dashboard-card text-center action-tile shadow-sm border-0">
                        <div class="card-body p-3">
                            <i class="fas fa-building fa-2x mb-2"></i>
                            <h6 class="fw-semibold mb-0">Branch Reports</h6>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Order Report -->
            <div class="dash-col mobile-col mb-5">
                <a asp-controller="Order" asp-action="Report" class="text-decoration-none">
                    <div class="dashboard-card text-center action-tile shadow-sm border-0">
                        <div class="card-body p-3">
                            <i class="fas fa-chart-line fa-2x mb-2"></i>
                            <h6 class="fw-semibold mb-0">Order Report</h6>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Statistics / Graph -->
            <div class="dash-col mobile-col mb-5">
                <a asp-controller="HOActivity" asp-action="HOGraph" class="text-decoration-none">
                    <div class="dashboard-card text-center action-tile shadow-sm border-0">
                        <div class="card-body p-3">
                            <i class="fas fa-chart-bar fa-2x mb-2"></i>
                            <h6 class="fw-semibold mb-0">Graph</h6>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Branch-Wise Detailed Report -->
            <div class="dash-col mobile-col mb-5">
                <a asp-controller="HOActivity" asp-action="HOBranchSummary" class="text-decoration-none">
                    <div class="dashboard-card text-center action-tile shadow-sm border-0">
                        <div class="card-body p-3">
                            <i class="fas fa-file-invoice-dollar fa-2x mb-2"></i>
                            <h6 class="fw-semibold mb-0">BranchWise Detailed Report</h6>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Product Ledger -->
            <div class="dash-col mobile-col mb-5">
                <a asp-controller="ProductLedger" asp-action="Index" class="text-decoration-none">
                    <div class="dashboard-card text-center action-tile shadow-sm border-0">
                        <div class="card-body p-3">
                            <i class="fas fa-clipboard-list fa-2x mb-2"></i>
                            <h6 class="fw-semibold mb-0">Product Ledger</h6>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Feedback -->
            <div class="dash-col mobile-col mb-5">
                <a asp-controller="Feedback" asp-action="List" class="text-decoration-none">
                    <div class="dashboard-card text-center action-tile shadow-sm border-0">
                        <div class="card-body p-3">
                            <i class="fas fa-comment-dots fa-2x text-primary mb-2"></i>
                            <h6 class="fw-semibold mb-0">Feedback</h6>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Logout -->
            <div class="dash-col mobile-col mb-5">
                <a asp-controller="Account" asp-action="Logout" class="text-decoration-none">
                    <div class="dashboard-card text-center action-tile shadow-sm border-0">
                        <div class="card-body p-3">
                            <i class="fas fa-sign-out-alt fa-2x mb-2"></i>
                            <h6 class="fw-semibold mb-0">Logout</h6>
                        </div>
                    </div>
                </a>
            </div>

        </div>


    </div>
</div>
