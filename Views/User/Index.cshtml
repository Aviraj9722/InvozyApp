@model IEnumerable<eOrderTouchApp.Models.TblUser>

<h3>Manage Users -<u>@ViewBag.OrgName</u> </h3>
<br />

<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        display: flex !important;
        align-items: center !important;
        gap: 10px !important;
        margin-bottom: 15px !important;
    }

    .dataTables_length select {
        padding-right: 28px !important;
        padding-left: 6px !important;
        height: 32px;
    }

    .dataTables_wrapper .dataTables_filter input {
        margin-left: 6px !important;
    }

    .dataTables_wrapper .dataTables_paginate {
        margin-top: 12px !important;
    }
</style>

<div class="container-fluid mt-3">

    <div class="row">
        <!-- Left Side: Form (30%) -->
        <div class="col-md-4">
            <h5 id="formTitle">Add/Edit User</h5>
            <form id="userForm" novalidate>
                <input type="hidden" id="userId" />

                <div class="mb-2">
                    <label class="form-label">Name</label>
                    <input type="text" id="name" class="form-control" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Email</label>
                    <input type="text" id="emailid" class="form-control" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Mobile No.</label>
                    <input type="text" id="mobilenumber" class="form-control" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Is Active?</label><br />
                    <input type="checkbox" id="isactive" class="form-check-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Username</label>
                    <input type="text" id="username" class="form-control" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Password</label>
                    <input type="password" id="password" class="form-control" required />
                </div>

                <div class="d-grid gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-outline-secondary" id="btnClear">Clear</button>
                </div>

            </form>
        </div>

        <!-- Right Side: Table (70%) -->
        <div class="col-md-8">
            <div class="card shadow-sm p-3">
                <table id="userTable" class="table table-bordered table-striped w-100">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>EmailId</th>
                            <th>Mobile Number</th>
                            <th>Is Active?</th>
                            <th>UserName</th>
                            <th>Password</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>@user.Name</td>
                                <td>@user.EmailId</td>
                                <td>@user.MobileNumber</td>
                                <td>@user.IsActive</td>

                                <td>@user.UserName</td>
                                <td>@user.Password</td>
                                <td>
                                    <div class="d-grid gap-2">

                                        <button class="btn btn-sm btn-primary editUser"
                                                data-id="@user.Id"
                                                data-name="@user.Name"
                                                data-email="@user.EmailId"
                                                data-mobile="@user.MobileNumber"
                                                data-active="@user.IsActive"
                                                data-username="@user.UserName"
                                                data-password="@user.Password">
                                            Edit
                                        </button>

                                        <button class="btn btn-sm btn-danger deleteUser" data-id="@user.Id">
                                            Delete
                                        </button>

                                        <a href="/UserLicense/Index/@user.Id" class="btn btn-sm btn-success">
                                            Licenses
                                        </a>
                                    </div>
                                    
                                    
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
        </div>
    </div>
</div>


@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>

        $(document).ready(function () {

            // Initialize DataTable
            let table = $("#userTable").DataTable({
                pageLength: 10,
                responsive: true,
                columnDefs: [
                    {
                        targets: 0,
                        render: function (data, type, row, meta) {
                            return meta.row + 1; // Auto row number
                        }
                    }
                ]
            });

            // Save User
            $('#userForm').submit(function (e) {
                e.preventDefault();

                let user = {
                    Id: $('#userId').val() || 0,
                    Name: $('#name').val(),
                    EmailId: $('#emailid').val(),
                    MobileNumber: $('#mobilenumber').val(),
                    IsActive: $('#isactive').is(':checked'),
                    UserName: $('#username').val(),
                    Password: $('#password').val()
                };

                let url = user.Id == 0 ? '/User/Create' : '/User/Edit';

                $.ajax({
                    url: url,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(user),
                    success: function (res) {
                        if (res.success) location.reload();
                        else alert(res.message);
                    }
                });
            });

            // Edit User
            $('.editUser').click(function () {

                $('#formTitle').text('Edit User');

                $('#userId').val($(this).data('id'));
                $('#name').val($(this).data('name'));
                $('#emailid').val($(this).data('email'));
                $('#mobilenumber').val($(this).data('mobile'));
                $('#isactive').prop('checked', $(this).data('active'));
                $('#username').val($(this).data('username'));
                $('#password').val($(this).data('password'));
            });

            // Delete User
            $('.deleteUser').click(function () {
                if (!confirm('Delete this user?')) return;

                let id = $(this).data('id');

                $.post('/User/Delete', { id: id }, function (res) {
                    if (res.success) location.reload();
                    else alert(res.message);
                });
            });

        });
    </script>
}

