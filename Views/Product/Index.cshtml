@model IEnumerable<eOrderTouchApp.Models.TblProduct>
@{
    var categories = ViewBag.Categories as List<eOrderTouchApp.Models.TblCategory>;
}

<h2>Manage Products</h2>

<div class="row">
    <!-- Left Form -->
    <div class="col-md-4">
        <h4 id="formTitle">Add / Edit Product</h4>
        <form id="productForm" asp-action="Save" asp-controller="Product" method="post" enctype="multipart/form-data">
            <input type="hidden" id="productId" name="Id" />

            <div class="mb-2">
                <label>Name</label>
                <input type="text" name="Name" id="name" class="form-control" required />
            </div>

          @*   <div class="mb-2">
                <label>Code</label>
                <input type="text" name="Code" id="code" class="form-control" />
            </div>

            <div class="mb-2">
                <label>Regional Name</label>
                <input type="text" name="RegionalName" id="regionalName" class="form-control" />
            </div> *@

            <div class="mb-2">
                <label>Price</label>
                <input type="number" name="Price" id="price" step="0.01" class="form-control" required />
            </div>

            <div class="mb-2">
                <label>Category</label>
                <select name="CategoryId" id="categoryId" class="form-control" required>
                    <option value="">-- Select Category --</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="mb-2">
                <label>Product Photo</label>
                <input type="file" name="photo" class="form-control" />
            </div>

            <button type="submit" class="btn btn-success">Save</button>
        </form>
    </div>

    <!-- Right Table -->
    <div class="col-md-8">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Name</th>
                  @*   <th>Code</th> *@
                    <th>Price</th>
                    <th>Category</th>
                    <th>Photo</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Name</td>
                    @*     <td>@p.Code</td> *@
                        <td>@p.Price</td>
                        <td>@p.Category?.Name</td>
                        <td>
                            @if (!string.IsNullOrEmpty(p.Photo))
                            {
                                <img src="@p.Photo" alt="Product" style="width: 50px; height: 50px;" />
                            }
                        </td>
                        <td>
                            <button class="btn btn-warning btn-sm editBtn"
                                    data-id="@p.Id"
                                    data-name="@p.Name"
                                    data-code="@p.Code"
                                    data-regional="@p.RegionalName"
                                    data-price="@p.Price"
                                    data-category="@p.CategoryId">
                                Edit
                            </button>
                            <form asp-action="Delete" asp-controller="Product" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@p.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $('.editBtn').click(function () {
            $('#formTitle').text('Edit Product');
            $('#productId').val($(this).data('id'));
            $('#name').val($(this).data('name'));
            $('#code').val($(this).data('code'));
            $('#regionalName').val($(this).data('regional'));
            $('#price').val($(this).data('price'));
            $('#categoryId').val($(this).data('category'));
        });
    </script>
}
