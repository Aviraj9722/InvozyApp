@model IEnumerable<eOrderTouchApp.Models.TblProduct>
@{
    var categories = ViewBag.Categories as List<eOrderTouchApp.Models.TblCategory>;
}

<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    /* Keep DataTables UI consistent across all pages */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        display: flex;
        align-items: center;
        gap: 10px !important;
    }

    .dataTables_length select {
        padding-right: 28px !important; /* ensures arrow is not overlapping the number */
        padding-left: 6px !important; /* normal text spacing */
    }
    /* Optional: make dropdown look clean */
    .dataTables_length select {
        height: 32px;
    }

    .dataTables_wrapper .dataTables_paginate {
        margin-top: 12px !important;
    }
</style>

<div class="container-fluid mt-3">
    <div class="row">

        <!-- LEFT FORM -->
        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <h5 id="formTitle">Add / Edit Product</h5>

                <form id="productForm" asp-action="Save" asp-controller="Product" method="post" enctype="multipart/form-data">
                    <input type="hidden" id="productId" name="Id" />

                    <div class="mb-2">
                        <label>Name</label>
                        <input type="text" name="Name" id="name" class="form-control" />
                        <span id="err_Name" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label>Price</label>
                        <input type="number" name="Price" id="price" step="0.01" class="form-control" />
                        <span id="err_Price" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label>Category</label>
                        <select name="CategoryId" id="categoryId" class="form-control">
                            <option value="">-- Select Category --</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                        <span id="err_Category" class="text-danger"></span>
                    </div>

                    <div class="mb-2">
                        <label>Product Photo</label>
                        <input type="file" name="photo" class="form-control" />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" id="btnClear" class="btn btn-outline-secondary">Clear</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT DATATABLE -->
        <div class="col-md-8">
            <div class="card shadow-sm p-3">

                <table class="table table-bordered table-striped w-100" id="productTable">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Price</th>
                            <th>Category</th>
                            <th>Photo</th>
                            <th style="width:140px">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td></td>
                                <td>@p.Name</td>
                                <td>@p.Price</td>
                                <td>@p.Category?.Name</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.Photo))
                                    {
                                        <img src="@p.Photo" style="width:50px;height:50px;" />
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-warning btn-sm editBtn"
                                            data-id="@p.Id"
                                            data-name="@p.Name"
                                            data-price="@p.Price"
                                            data-category="@p.CategoryId">
                                        Edit
                                    </button>

                                    <form asp-action="Delete" asp-controller="Product" method="post" style="display:inline;">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="btn btn-danger btn-sm deleteProduct">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>

    </div>
</div>


@section Scripts {

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {

            // ===================== DATATABLE ======================
            let table = $("#productTable").DataTable({
                pageLength: 10,
                responsive: true,
                columnDefs: [{
                    targets: 0,
                    render: function (data, type, row, meta) {
                        return meta.row + 1;
                    }
                }]
            });

            // ===================== LIVE CLEAR VALIDATION ======================
            $("#name").on("input", () => $("#err_Name").text(""));
            $("#price").on("input", () => $("#err_Price").text(""));
            $("#categoryId").on("change", () => $("#err_Category").text(""));

            // ===================== FORM VALIDATION ======================
            function validateProductForm() {
                let valid = true;

                $("#err_Name, #err_Price, #err_Category").text("");

                let name = $("#name").val().trim();
                let price = $("#price").val().trim();
                let category = $("#categoryId").val();

                if (name === "") {
                    $("#err_Name").text("Product name is required");
                    valid = false;
                }

                if (price === "") {
                    $("#err_Price").text("Price is required");
                    valid = false;
                } else if (parseFloat(price) <= 0) {
                    $("#err_Price").text("Price must be greater than 0");
                    valid = false;
                }

                if (category === "") {
                    $("#err_Category").text("Please select a category");
                    valid = false;
                }

                return valid;
            }

            // ===================== SAVE PRODUCT ======================
            $("#productForm").submit(function (e) {
                e.preventDefault();

                if (!validateProductForm()) return;

                let formData = new FormData(this);

                $.ajax({
                    url: "/Product/Save",
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        if (res.success) {
                            location.reload();
                        } else {
                            alert(res.message);
                        }
                    }
                });
            });

            // ===================== EDIT PRODUCT ======================
            $(document).on("click", ".editBtn", function () {
                $("#formTitle").text("Edit Product");

                $("#productId").val($(this).data("id"));
                $("#name").val($(this).data("name"));
                $("#price").val($(this).data("price"));
                $("#categoryId").val($(this).data("category"));

                $("html, body").animate({ scrollTop: 0 }, 300);
            });

            // ===================== DELETE PRODUCT ======================
            $(document).on("click", ".deleteProduct", function (e) {
                if (!confirm("Are you sure you want to delete this product?")) {
                    e.preventDefault();
                }
            });

            // ===================== CLEAR FORM ======================
            $("#btnClear").click(function () {
                $("#productForm")[0].reset();
                $("#productId").val("");
                $("#formTitle").text("Add / Edit Product");
                $("#err_Name, #err_Price, #err_Category").text("");
            });
        });
        
    </script>

}
