@model IEnumerable<eOrderTouchApp.Models.TblProduct>

@{
    ViewData["Title"] = "Product Master";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>



<div class="container mt-3">

    <form id="productForm" enctype="multipart/form-data">
        <input type="hidden" id="Id" name="Id" />

        <div class="row">

            <div class="col-md-4">
                <div class="card shadow-sm p-3">
                    <h5 id="formTitle">Add / Edit Products</h5>
                <div class="mb-2">
                    <label>Name</label>
                    <input type="text" class="form-control" id="Name" name="Name" required />
                    <span class="text-danger small" id="errName"></span>
                </div>

                <div class="mb-2">
                    <label>BarCode Number</label>
                    <input type="text" class="form-control" id="Code" name="Code" />
                </div>
                    @* 
                <div class="mb-2">
                    <label>Regional Name</label>
                    <input type="text" class="form-control" id="RegionalName" name="RegionalName" />
                </div> *@

                <div class="mb-2">
                    <label>Price</label>
                    <input type="number" class="form-control" id="Price" name="Price" step="0.01" required />
                    <span class="text-danger small" id="errPrice"></span>
                </div>

                <div class="mb-2">
                    <label>Category</label>
                    <select class="form-control" id="CategoryId" name="CategoryId">
                        <option value="">Select</option>
                        @foreach (var c in ViewBag.Categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <span class="text-danger small" id="errCategory"></span>
                </div>

                <div class="mb-2">
                    <label>Upload Image</label>
                    <input type="file" id="photoInput" accept="image/*" class="form-control" />
                </div>

                <!-- Preview -->
                <img id="imagePreview"
                     style="width:150px;height:150px;display:none;object-fit:cover;border:1px solid #ccc;" />

                <!-- Hidden for cropped image base64 -->
                <input type="hidden" id="croppedImageData" name="croppedImageData" />

                <button type="button" class="btn btn-primary mt-3" id="btnSaveProduct">Save Product</button>

            </div>
            </div>
            <div class="col-md-8">

                <table id="ProductTB" class="table table-bordered table-striped w-100 dataTable no-footer">
                    <thead class="table-dark">
                        <tr>
                            <th>Photo</th>
                            <th>Name</th>
                            <th>Price</th>
                            <th>Category</th>
                            <th>Barcode#</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.Photo))
                                    {
                                        <img src="@p.Photo" style="width:50px;height:50px;object-fit:cover;" />
                                    }
                                </td>
                                <td>@p.Name</td>
                                <td>@p.Price</td>
                                <td>@p.Code</td>
                                <td>@p.Category?.Name</td>
                                <td>
                                    <button type="button" class="btn btn-warning btn-sm"
                                            onclick="editProduct(@p.Id)"
                                            data-name="@p.Name"
                                            data-price="@p.Price"
                                            data-category="@p.CategoryId"
                                            data-regional="@p.RegionalName"
                                            data-code="@p.Code">
                                        Edit
                                    </button>
                                    <button type="button" class="btn btn-danger btn-sm" onclick="deleteProduct(@p.Id)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </form>
</div>




<!-- ----------------------- CROPPER MODAL ----------------------- -->

<div class="modal fade" id="cropModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Crop Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <img id="cropImage" style="max-width:100%;" />
            </div>

            <div class="modal-footer">
                <button type="button" id="btnCrop" class="btn btn-primary">Crop & Save</button>
            </div>
        </div>
    </div>
</div>





<!-- --------------------- CROP & RESIZE SCRIPT --------------------- -->

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script>
     $(document).ready(function () {

            let table = $("#ProductTB").DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                responsive: true,
                ordering: true,
                searching: true
                
            });
      });



    let cropper;

    document.getElementById("photoInput").addEventListener("change", function (e) {
        let file = e.target.files[0];
        if (!file) return;

        let reader = new FileReader();
        reader.onload = function (ev) {
            document.getElementById("cropImage").src = ev.target.result;

            let modal = new bootstrap.Modal(document.getElementById("cropModal"));
            modal.show();

            if (cropper) cropper.destroy();

            cropper = new Cropper(document.getElementById("cropImage"), {
                aspectRatio: 1,
                viewMode: 1
            });
        };
        reader.readAsDataURL(file);
    });

    document.getElementById("btnCrop").addEventListener("click", function () {

        let canvas = cropper.getCroppedCanvas({
            width: 400,
            height: 400,
            imageSmoothingQuality: 'high'
        });

        canvas.toBlob(function (blob) {

            if (blob.size > 50000) {
                alert("Image size is more than 50KB. Please crop smaller.");
                return;
            }

            // Preview
            document.getElementById("imagePreview").src = URL.createObjectURL(blob);
            document.getElementById("imagePreview").style.display = "block";

            // Convert to base64
            let reader = new FileReader();
            reader.onloadend = function () {
                document.getElementById("croppedImageData").value = reader.result;
            };
            reader.readAsDataURL(blob);

            bootstrap.Modal.getInstance(document.getElementById("cropModal")).hide();

        }, "image/jpeg", 0.8);
    });



    // ---------------- SAVE PRODUCT -------------------

    document.getElementById("btnSaveProduct").addEventListener("click", function () {

    // Clear previous errors
       document.getElementById("errName").innerHTML = "";
       document.getElementById("errPrice").innerHTML = "";
       document.getElementById("errCategory").innerHTML = "";

       let name = document.getElementById("Name").value.trim();
       let price = document.getElementById("Price").value.trim();
       let category = document.getElementById("CategoryId").value;

       let isValid = true;

       // --- Name Validation ---
       if (name === "") {
           document.getElementById("errName").innerText = "Product name is required.";
           isValid = false;
       }

       // --- Price Validation ---
       if (price === "" || parseFloat(price) <= 0) {
           document.getElementById("errPrice").innerText = "Please enter a valid price.";
           isValid = false;
       }

       // --- Category Validation ---
       if (category === "" || category === "0") {
           document.getElementById("errCategory").innerText = "Please select a category.";
           isValid = false;
       }

       // Stop submit if validation fails
       if (!isValid) return;


        let formData = new FormData(document.getElementById("productForm"));

        fetch("/Product/Save", {
            method: "POST",
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                alert(data.message);
                if (data.success) location.reload();
            });
    });


    // ------------- EDIT PRODUCT (Load existing data) -------------

          function editProduct(id) {

            let btn = event.target;   // the clicked EDIT button

            document.getElementById("Id").value = id;
            document.getElementById("Name").value = btn.dataset.name;
            document.getElementById("Price").value = btn.dataset.price;
            document.getElementById("CategoryId").value = btn.dataset.category;
            document.getElementById("RegionalName").value = btn.dataset.regional || "";
            document.getElementById("Code").value = btn.dataset.code || "";

            // Scroll to form (optional)
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

    function deleteProduct(id) {

        if (!confirm("Are you sure want to delete?")) return;

        $.ajax({
            url: "/Product/Delete",
            type: "POST",
            data: { id: id },
            success: function (response) {
                debugger;
                // Remove row smoothly
              
                   location.reload();
              
            },
            error: function () {
                alert("Something went wrong while deleting.");
            }
        });
    }
</script>
}