@{
    ViewData["Title"] = "User License Management";
}

<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        display: flex !important;
        align-items: center !important;
        gap: 10px !important;
        margin-bottom: 12px !important;
    }

    .dataTables_length select {
        padding-right: 28px !important;
        padding-left: 6px !important;
        height: 32px !important;
    }

    .dataTables_filter input {
        margin-left: 6px !important;
    }

    .dataTables_paginate {
        margin-top: 14px !important;
    }

    .input-error {
        border: 1px solid red !important;
    }
</style>

<h3 class="mb-4">
    Business License Management - <u>@ViewBag.OrgName</u>    
</h3>

<div class="row">

    <!-- LEFT : FORM -->
    <div class="col-md-4">
        <div class="card shadow-sm p-3">
            <h5 id="formTitle" class="mb-3">Add License</h5>
            <form id="frmLicense">

                <input type="hidden" id="Id" name="Id" />

                <div class="mb-2">
                    <label class="form-label">License Key</label>
                    <input id="LicenseKey" name="LicenseKey" class="form-control" required />
                    <span class="text-danger" id="LicenseKeyError"></span>
                </div>

                <div class="mb-2">
                    <label class="form-label">Start Date</label>
                    <input type="date" id="StartDate" name="StartDate" class="form-control" />
                    <span class="text-danger" id="StartDateError"></span>
                </div>

                <div class="mb-2">
                    <label class="form-label">End Date</label>
                    <input type="date" id="EndDate" name="EndDate" class="form-control" />
                    <span class="text-danger" id="EndDateError"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Dealer</label>
                    <select id="DealerId" name="DealerId" class="form-control">
                        <option value="">-- Select Dealer --</option>
                        @foreach (var dealer in ViewBag.Dealers)
                        {
                            <option value="@dealer.Value">@dealer.Text</option>
                        }
                    </select>
                </div>

                <div class="d-grid gap-2 mt-3">
                    <button type="button" class="btn btn-primary" onclick="saveLicense()">Save</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="clearForm()">Clear</button>
                </div>

            </form>
        </div>
    </div>

    <!-- RIGHT : DATATABLE -->
    <div class="col-md-8">
        <div class="card shadow-sm p-3">

            <h5 class="mb-3">License List</h5>

            <table id="tblLicense" class="table table-bordered table-striped w-100">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>License Key</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Dealer</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

        </div>
    </div>
</div>

@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>

        let dt;

        $(document).ready(function () {
            loadTable();
        });

        // -------------------------
        // LOAD DATATABLE
        // -------------------------
        async function loadTable() {
            const res = await fetch('/UserLicense/GetAll');
            const data = await res.json();

            // Destroy old datatable if exists
            if (dt) dt.destroy();

            let rows = "";
            data.forEach(x => {
                rows += `
                    <tr>
                        <td></td>
                        <td>${x.licenseKey}</td>
                        <td>${x.startDate?.substring(0, 10) ?? ""}</td>
                        <td>${x.endDate?.substring(0, 10) ?? ""}</td>
                        <td>${x.dealerName ?? ""}</td>
                        <td>
                          <button class="btn btn-sm btn-primary" onclick="edit(${x.id})">Edit</button>
                          <button class="btn btn-sm btn-danger" onclick="remove(${x.id})">Delete</button>
                        </td>
                    </tr>`;
            });

            $("#tblLicense tbody").html(rows);

            dt = $("#tblLicense").DataTable({
                pageLength: 10,
                responsive: true,

                columnDefs: [
                    {
                        targets: 0,
                        orderable: false,
                        searchable: false,
                        render: (data, type, row, meta) => meta.row + 1
                    }
                ]
            });
        }

        // -------------------------
        // CLEAR FORM
        // -------------------------
        function clearForm() {
            $("#Id").val("");
            $("#LicenseKey").val("");
            $("#StartDate").val("");
            $("#EndDate").val("");
            $('#DealerId').val('').trigger('change');

            $("#formTitle").text("Add License");
        }

        function saveLicense() {

            // Clear previous errors
            $("#LicenseKeyError").text("");
            $("#StartDateError").text("");
            $("#EndDateError").text("");

            // remove red borders first
            $("#LicenseKey").removeClass("input-error");
            $("#StartDate").removeClass("input-error");
            $("#EndDate").removeClass("input-error");

            let isValid = true;

            if (!$("#LicenseKey").val()) {
                $("#LicenseKeyError").text("License Key is required");
                $("#LicenseKey").addClass("input-error"); // <-- HERE
                isValid = false;
            }

            if (!$("#StartDate").val()) {
                $("#StartDateError").text("Start Date is required");
                $("#StartDate").addClass("input-error"); // <-- HERE
                isValid = false;
            }

            if (!$("#EndDate").val()) {
                $("#EndDateError").text("End Date is required");
                $("#EndDate").addClass("input-error"); // <-- HERE
                isValid = false;
            }

            if (!isValid) return;
            // continue saving...
            let url = $("#Id").val() ? "/UserLicense/Update" : "/UserLicense/Create";

            let payload = {
                Id: $("#Id").val() ? parseInt($("#Id").val()) : 0,
                LicenseKey: $("#LicenseKey").val(),
                StartDate: $("#StartDate").val(),
                EndDate: $("#EndDate").val(),
                DealerId: $("#DealerId").val() ? parseInt($("#DealerId").val()) : null
            };
            console.log("payload");
            $.ajax({
                url: url,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(payload),
                success: function (result) {
                    if (result.success) {
                        alert(result.message);
                        loadTable();
                        clearForm();
                    } else {
                        alert(result.message);
                    }
                }
            });
        }

        // -------------------------
        // EDIT LICENSE
        // -------------------------
        async function edit(id) {
            const res = await fetch('/UserLicense/GetAll');
            const data = await res.json();

            const row = data.find(x => x.id === id); // ✅ lowercase "id"

            if (!row) {
                alert("License not found");
                return;
            }

            $("#Id").val(row.id);
            $("#LicenseKey").val(row.licenseKey);
            $("#StartDate").val(row.startDate?.substring(0, 10));
            $("#EndDate").val(row.endDate?.substring(0, 10));
           $("#DealerId").val(row.dealerId).trigger('change');

            $("#formTitle").text("Edit License");
        }

        // -------------------------
        // DELETE LICENSE
        // -------------------------
        async function remove(id) {

            if (!confirm("Do you want to delete this License?")) return;

            const res = await fetch('/UserLicense/Delete', {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id })
            });

            const result = await res.json();

            if (result.success) {
                loadTable();
            } else {
                alert(result.message || "Delete failed");
            }
        }

        // function loadDealers() {
        //     $.get('/UserLicense/GetDealers', function (data) {

        //         let dropdown = $("#DealerId");
        //         dropdown.empty();
        //         dropdown.append('<option value="">-- Select Dealer --</option>');

        //         $.each(data, function (i, item) {
        //             dropdown.append('<option value="' + item.id + '">' + item.name + '</option>');
        //         });
        //     });
        // }

    </script>

}
