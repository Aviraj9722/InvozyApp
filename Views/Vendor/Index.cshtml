@model IEnumerable<eOrderTouchApp.Models.TblVendor>

@{
    ViewData["Title"] = "Manage Vendors";
}

<link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<style>
    .invalid-input {
        border: 1px solid red !important;
        background-color: #fff6f6;
    }

    /* Copy of Business UI DataTable alignment */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        display: flex;
        align-items: center;
        gap: 10px !important;
        margin-bottom: 12px !important;
    }

    .dataTables_length select {
        padding-right: 28px !important;
        padding-left: 6px !important;
        height: 32px;
    }

    .dataTables_wrapper .dataTables_filter input {
        margin-left: 6px !important;
    }

    .dataTables_wrapper .dataTables_paginate {
        margin-top: 12px !important;
    }
</style>

<div class="row mt-4">

    <!-- LEFT SIDE FORM -->
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">         
                <h5 id="formTitle">Add Vendor</h5>
            </div>

            <div class="card-body">
                <form id="vendorForm">

                    <input type="hidden" id="Id" name="Id" value="0" />

                    <div class="mb-2">
                        <label>Name</label>
                        <input type="text" class="form-control" id="Name" name="Name" />
                        <span class="text-danger" id="err_Name"></span>
                    </div>

                    <div class="mb-2">
                        <label>Email</label>
                        <input type="email" class="form-control" id="EmailId" name="EmailId" />
                        <span class="text-danger" id="err_EmailId"></span>
                    </div>

                    <div class="mb-2">
                        <label>Mobile No</label>
                        <input type="text" class="form-control" id="MobileNo" name="MobileNo" />
                        <span class="text-danger" id="err_MobileNo"></span>
                    </div>

                    <div class="mb-2">
                        <label>GSTN</label>
                        <input type="text" class="form-control" id="GSTN" name="GSTN" />
                        <span class="text-danger" id="err_GSTN"></span>
                    </div>

                    <div class="mb-2">
                        <label>Address</label>
                        <textarea class="form-control" id="Address" name="Address"></textarea>
                        <span class="text-danger" id="err_Address"></span>
                    </div>

                    <div class="mb-3">
                        <label>Location</label>
                        <input type="text" class="form-control" id="Location" name="Location" />
                        <span class="text-danger" id="err_Location"></span>
                    </div>

                    <button type="button" id="btnSave" class="btn btn-success w-100">Save</button>

                </form>
            </div>
        </div>
    </div>

    <!-- RIGHT SIDE GRID -->
    <div class="col-md-8">
        <div class="card-body" id="gridContainer" style="overflow-x:auto;">
            <table class="table table-bordered datatable" id="vendorTable">
                <thead class="table-dark">
                    <tr>
                        <th style="width:130px;">Action</th>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Mobile</th>
                        <th>GSTN</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-primary editBtn" data-id="@v.Id">Edit</button>
                                    <button class="btn btn-sm btn-danger deleteBtn" data-id="@v.Id">Delete</button>
                                </div>
                            </td>
                            <td>@v.Id</td>
                            <td>@v.Name</td>
                            <td>@v.EmailId</td>
                            <td>@v.MobileNo</td>
                            <td>@v.GSTN</td>
                            <td>@v.Location</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<!-- DELETE CONFIRMATION MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5>Confirm Delete</h5>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this vendor?
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="confirmDelete" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div>

@* <!-- SUCCESS TOAST -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index:9999">
    <div id="successToast" class="toast text-bg-success" role="alert">
        <div class="toast-body">Saved successfully</div>
    </div>
</div> *@


@section Scripts {

    <script>
        let deleteId = 0;

        $(document).ready(function () {

            $("#vendorTable").DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                ordering: true,
                searching: true,
                responsive: true
            });

            // REMOVE ERROR ON TYPING (same as dealer)
            $("input, textarea").on("input", function () {
                $(this).removeClass("invalid-input");
                $("#err_" + this.id).text("");
            });

        });

        // ----------------------------------------------------
        // VALIDATION 
        // ----------------------------------------------------
        function validateVendorForm() {

            let valid = true;

            // Clear previous errors
            $(".form-control").removeClass("invalid-input");
            $(".text-danger").text("");

            // Name
            if ($("#Name").val().trim() === "") {
                $("#err_Name").text("Name is required");
                $("#Name").addClass("invalid-input");
                valid = false;
            }

            // Email
             let email = $("#EmailId").val().trim();
             let emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

             if (email === "") {
                 $("#err_EmailId").text("Email is required");
                 $("#EmailId").addClass("invalid-input");
                 isValid = false;
             }
             else if (!emailPattern.test(email)) {
                 $("#err_EmailId").text("Invalid email format");
                 $("#EmailId").addClass("invalid-input");
                 isValid = false;
             }

             // Mobile Validation
             let mobile = $("#MobileNo").val().trim();
             let mobilePattern = /^[0-9]{10}$/;

             if (mobile === "") {
                 $("#err_MobileNo").text("Mobile number is required");
                 $("#MobileNo").addClass("invalid-input");
                 isValid = false;
             }
             else if (!mobilePattern.test(mobile)) {
                 $("#err_MobileNo").text("Mobile number must be 10 digits");
                 $("#MobileNo").addClass("invalid-input");
                 isValid = false;
             }


            // GSTN
            if ($("#GSTN").val().trim() === "") {
                $("#err_GSTN").text("GSTN is required");
                $("#GSTN").addClass("invalid-input");
                valid = false;
            }

            // Address
            if ($("#Address").val().trim() === "") {
                $("#err_Address").text("Address is required");
                $("#Address").addClass("invalid-input");
                valid = false;
            }

            // Location
            if ($("#Location").val().trim() === "") {
                $("#err_Location").text("Location is required");
                $("#Location").addClass("invalid-input");
                valid = false;
            }

            return valid;
        }

        // ----------------------------------------------------
        // SAVE (Create / Update)
        // ----------------------------------------------------
        $(document).on("click", "#btnSave", function () {

            if (!validateVendorForm()) return;

            $.ajax({
                url: "/Vendor/SaveVendor",
                type: "POST",
                data: $("#vendorForm").serialize(),
                success: function (res) {
                    alert(res.message);
                    setTimeout(() => location.reload(), 500);
                }
            });
        });

        // ----------------------------------------------------
        // EDIT
        // ----------------------------------------------------
        $(document).on("click", ".editBtn", function () {

            let id = $(this).data("id");

            $.get("/Vendor/GetVendor?id=" + id, function (v) {

                $("#formTitle").text("Edit Vendor");
                $("#btnSave").text("Update");

                $("#Id").val(v.id);
                $("#Name").val(v.name);
                $("#EmailId").val(v.emailId);
                $("#MobileNo").val(v.mobileNo);
                $("#GSTN").val(v.gstn);
                $("#Address").val(v.address);
                $("#Location").val(v.location);
            });
        });

        // ----------------------------------------------------
        // DELETE
        // ----------------------------------------------------
        $(".deleteBtn").click(function () {
            deleteId = $(this).data("id");
            $("#deleteModal").modal("show");
        });

        $("#confirmDelete").click(function () {
            $.get("/Vendor/Delete?id=" + deleteId, function (res) {
                alert(res.message);
                $("#deleteModal").modal("hide");
                setTimeout(() => location.reload(), 500);
            });
        });

    </script>
}
